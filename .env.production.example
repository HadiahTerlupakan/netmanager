# ==============================================================================
# NetManager Production Environment Configuration
# ==============================================================================
# Salin file ini ke .env dan isi semua nilai yang diperlukan
# cp .env.production.example .env
#
# Gunakan ./deploy.sh secrets untuk generate credentials secara otomatis
# ==============================================================================

# ------------------------------------------------------------------------------
# DOMAIN CONFIGURATION (WAJIB)
# ------------------------------------------------------------------------------
# Domain utama aplikasi (tanpa http:// atau https://)
DOMAIN=radpro.id

# Email untuk sertifikat SSL Let's Encrypt
ACME_EMAIL=admin@radpro.id

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (WAJIB)
# ------------------------------------------------------------------------------
# Generate password dengan: openssl rand -base64 24 | tr -d '/+='
POSTGRES_USER=netmgr
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_YANG_KUAT
POSTGRES_DB=netmanager

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (WAJIB)
# ------------------------------------------------------------------------------
# Generate password dengan: openssl rand -base64 24 | tr -d '/+='
REDIS_PASSWORD=GANTI_DENGAN_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (WAJIB)
# ------------------------------------------------------------------------------
# Generate secrets dengan: openssl rand -base64 32
AUTH_SECRET=GANTI_DENGAN_AUTH_SECRET
NEXTAUTH_SECRET=GANTI_DENGAN_NEXTAUTH_SECRET

# Generate dengan: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=GANTI_DENGAN_OAUTH_ENCRYPTION_KEY

# URL Authentication (sesuaikan dengan domain)
AUTH_URL=https://radpro.id
NEXTAUTH_URL=https://radpro.id

# ------------------------------------------------------------------------------
# COOKIE & SESSION CONFIGURATION
# ------------------------------------------------------------------------------
# Domain untuk cookie (tanpa https://, biasanya sama dengan DOMAIN)
COOKIE_DOMAIN=radpro.id

# Session timeout dalam detik (default: 7 hari = 604800)
SESSION_MAX_AGE=604800
SESSION_UPDATE_AGE=1800

# ------------------------------------------------------------------------------
# APPLICATION URLS
# ------------------------------------------------------------------------------
# URL utama aplikasi
NEXT_PUBLIC_APP_URL=https://radpro.id

# URL Portal Karyawan
EMPLOYEE_PORTAL_URL=https://karyawan.radpro.id

# CORS Origin (biasanya sama dengan domain utama)
CORS_ORIGIN=https://radpro.id

# ------------------------------------------------------------------------------
# RADIUS CONFIGURATION (Opsional, untuk PPPoE)
# ------------------------------------------------------------------------------
# Secret untuk komunikasi dengan NAS/Router
# Generate dengan: openssl rand -base64 16 | tr -d '/+='
RADIUS_SECRET=GANTI_DENGAN_RADIUS_SECRET

# ------------------------------------------------------------------------------
# WEB PUSH NOTIFICATIONS (Opsional)
# ------------------------------------------------------------------------------
# Generate dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@radpro.id

# ------------------------------------------------------------------------------
# INTERNAL SERVICES
# ------------------------------------------------------------------------------
# WebSocket server (internal)
WS_SERVER_URL=http://localhost:3000
INTERNAL_WS_SECRET=GANTI_DENGAN_INTERNAL_WS_SECRET

# Encryption key untuk internal use
ENCRYPTION_KEY=GANTI_DENGAN_ENCRYPTION_KEY

# JWT untuk Employee Portal
EMPLOYEE_JWT_SECRET=GANTI_DENGAN_EMPLOYEE_JWT_SECRET
EMPLOYEE_JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CRON / SCHEDULED TASKS (Untuk Attendance Alerts)
# ------------------------------------------------------------------------------
# Secret untuk mengamankan endpoint cron
# Generate dengan: openssl rand -base64 32
CRON_SECRET=GANTI_DENGAN_CRON_SECRET

# ------------------------------------------------------------------------------
# VERSIONING (Opsional)
# ------------------------------------------------------------------------------
APP_VERSION=latest
