# ===================================================================
# NetManager Production Environment Configuration
# ===================================================================
# This file is a template for production deployment with Docker.
# Copy this to .env and update the values before deploying.
#
# SECURITY NOTICE:
# 1. Generate secure credentials using: node scripts/generate-secure-credentials.js
# 2. Never commit real credentials to version control
# 3. Use different credentials for development and production
# ===================================================================

# ===================================================================
# DOMAIN CONFIGURATION (REQUIRED)
# ===================================================================
# Your main domain (without protocol or www)
DOMAIN=yourdomain.com

# ===================================================================
# Auth.js / NextAuth Configuration
# ===================================================================
# IMPORTANT: Use HTTPS URLs for production
AUTH_SECRET=GENERATE_STRONG_SECRET_HERE
AUTH_URL=https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=GENERATE_STRONG_SECRET_HERE

# OAuth Encryption Key
OAUTH_ENCRYPTION_KEY=GENERATE_STRONG_ENCRYPTION_KEY_HERE

# ===================================================================
# Database Configuration
# ===================================================================
POSTGRES_USER=netmgr
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
POSTGRES_DB=netmanager

# Internal Docker network URL (do not change this)
DATABASE_URL=postgresql://netmgr:GENERATE_STRONG_PASSWORD_HERE@db:5432/netmanager

# ===================================================================
# Redis Configuration
# ===================================================================
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_HERE
# Internal Docker network URL (do not change this)
REDIS_URL=redis://:GENERATE_STRONG_REDIS_PASSWORD_HERE@redis:6379

# ===================================================================
# RADIUS Configuration
# ===================================================================
RADIUS_SECRET=GENERATE_STRONG_RADIUS_SECRET_HERE

# ===================================================================
# CORS Configuration
# ===================================================================
# Include all subdomains that will access the API
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com,https://employee.yourdomain.com,https://finance.yourdomain.com,https://helpdesk.yourdomain.com,https://pelanggan.yourdomain.com

# ===================================================================
# Security Configuration
# ===================================================================
# Cookie settings for production
COOKIE_DOMAIN=yourdomain.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# Session Security (in seconds)
SESSION_MAX_AGE=604800
SESSION_UPDATE_AGE=3600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================================================
# Application Configuration
# ===================================================================
NODE_ENV=production
LOG_LEVEL=info

# ===================================================================
# OAuth Providers (Optional)
# ===================================================================
# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft/Azure AD OAuth
# AZURE_AD_CLIENT_ID=your-azure-client-id
# AZURE_AD_CLIENT_SECRET=your-azure-client-secret
# AZURE_AD_TENANT_ID=your-azure-tenant-id

# ===================================================================
# Email Configuration (Optional)
# ===================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ===================================================================
# Monitoring (Optional)
# ===================================================================
# SENTRY_DSN=your-sentry-dsn-here
# GOOGLE_ANALYTICS_ID=your-ga-id-here
