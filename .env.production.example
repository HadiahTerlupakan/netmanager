# ==============================================================================
# NetManager Production Environment Configuration
# ==============================================================================
# Salin file ini ke .env dan isi semua nilai yang diperlukan
# cp .env.production.example .env
#
# Gunakan ./deploy.sh secrets untuk generate credentials secara otomatis
# ==============================================================================

# ------------------------------------------------------------------------------
# DOMAIN CONFIGURATION (WAJIB)
# ------------------------------------------------------------------------------
# Domain utama aplikasi (tanpa http:// atau https://)
DOMAIN=radpro.id

# Email untuk sertifikat SSL Let's Encrypt
ACME_EMAIL=admin@radpro.id

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (WAJIB)
# ------------------------------------------------------------------------------
# Generate password dengan: openssl rand -base64 24 | tr -d '/+='
POSTGRES_USER=netmgr
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_YANG_KUAT
POSTGRES_DB=netmanager

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (WAJIB)
# ------------------------------------------------------------------------------
# Generate password dengan: openssl rand -base64 24 | tr -d '/+='
REDIS_PASSWORD=GANTI_DENGAN_REDIS_PASSWORD
# REDIS_URL biasanya dibentuk oleh Compose/Kubernetes secret menjadi:
# redis://:<REDIS_PASSWORD>@redis:6379

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (WAJIB)
# ------------------------------------------------------------------------------
# Generate secrets dengan: openssl rand -base64 32
AUTH_SECRET=GANTI_DENGAN_AUTH_SECRET
NEXTAUTH_SECRET=GANTI_DENGAN_NEXTAUTH_SECRET

# Generate dengan: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=GANTI_DENGAN_OAUTH_ENCRYPTION_KEY

# URL Authentication (sesuaikan dengan domain)
AUTH_URL=https://radpro.id
NEXTAUTH_URL=https://radpro.id

# ------------------------------------------------------------------------------
# COOKIE & SESSION CONFIGURATION
# ------------------------------------------------------------------------------
# Domain untuk cookie (tanpa https://, biasanya sama dengan DOMAIN)
COOKIE_DOMAIN=radpro.id

# Session timeout dalam detik (default: 7 hari = 604800)
SESSION_MAX_AGE=604800
SESSION_UPDATE_AGE=1800

# ------------------------------------------------------------------------------
# APPLICATION URLS
# ------------------------------------------------------------------------------
# URL utama aplikasi
NEXT_PUBLIC_APP_URL=https://radpro.id

# URL Portal Karyawan
EMPLOYEE_PORTAL_URL=https://karyawan.radpro.id

# CORS Origin (biasanya sama dengan domain utama)
CORS_ORIGIN=https://radpro.id

# Allowed origins for WebSocket CORS (comma-separated list)
# If not set, defaults to NEXTAUTH_URL
ALLOWED_ORIGINS=https://radpro.id,https://admin.radpro.id

# Rate limiting is ON by default in production.
# Uncomment the line below to disable it (e.g., for debugging):
# DISABLE_RATE_LIMIT=true

# ------------------------------------------------------------------------------
# RADIUS CONFIGURATION (Opsional, untuk PPPoE)
# ------------------------------------------------------------------------------
# Secret untuk komunikasi dengan NAS/Router
# Generate dengan: openssl rand -base64 16 | tr -d '/+='
RADIUS_SECRET=GANTI_DENGAN_RADIUS_SECRET

# IP Publik server RADIUS (Opsional - otomatis terdeteksi jika kosong)
# Override manual jika auto-detect tidak akurat
# RADIUS_PUBLIC_IP=103.xxx.xxx.xxx

# Port RADIUS yang bisa diakses dari luar (sesuaikan dengan port mapping)
# Docker Compose default: 1812/1813
# K8s NodePort contoh: 30812/30813 atau 31812/31813
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# ------------------------------------------------------------------------------
# FIREBASE WEB PUSH (Build-time / browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Untuk Jenkins multi-environment, sediakan variable scoped berikut di job/folder/env:
# NEXT_PUBLIC_FIREBASE_API_KEY_STAGING / NEXT_PUBLIC_FIREBASE_API_KEY_PRODUCTION
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN_STAGING / NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN_PRODUCTION
# NEXT_PUBLIC_FIREBASE_PROJECT_ID_STAGING / NEXT_PUBLIC_FIREBASE_PROJECT_ID_PRODUCTION
# NEXT_PUBLIC_FIREBASE_DATABASE_URL_STAGING / NEXT_PUBLIC_FIREBASE_DATABASE_URL_PRODUCTION
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET_STAGING / NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET_PRODUCTION
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID_STAGING / NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID_PRODUCTION
# NEXT_PUBLIC_FIREBASE_APP_ID_STAGING / NEXT_PUBLIC_FIREBASE_APP_ID_PRODUCTION
# NEXT_PUBLIC_VAPID_PUBLIC_KEY_STAGING / NEXT_PUBLIC_VAPID_PUBLIC_KEY_PRODUCTION

# ------------------------------------------------------------------------------
# FIREBASE ADMIN (Runtime server-side)
# ------------------------------------------------------------------------------
# Wajib untuk pengiriman notifikasi FCM dari server.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Gunakan format escaped newline (\n) jika disimpan dalam satu baris env.
FIREBASE_PRIVATE_KEY=
# Opsional: isi jika memakai Realtime Database.
FIREBASE_DATABASE_URL=

# Untuk Jenkins multi-environment, sediakan variable scoped berikut di job/folder/env:
# FIREBASE_PROJECT_ID_STAGING / FIREBASE_PROJECT_ID_PRODUCTION
# FIREBASE_CLIENT_EMAIL_STAGING / FIREBASE_CLIENT_EMAIL_PRODUCTION
# FIREBASE_PRIVATE_KEY_STAGING / FIREBASE_PRIVATE_KEY_PRODUCTION
# FIREBASE_DATABASE_URL_STAGING / FIREBASE_DATABASE_URL_PRODUCTION

# ------------------------------------------------------------------------------
# INTERNAL SERVICES
# ------------------------------------------------------------------------------
# Internal health check secret (gate detailed /api/health metrics)
# Generate dengan: openssl rand -base64 32
INTERNAL_HEALTH_SECRET=GANTI_DENGAN_INTERNAL_HEALTH_SECRET

# WebSocket server (internal)
WS_SERVER_URL=http://localhost:3000
INTERNAL_WS_SECRET=GANTI_DENGAN_INTERNAL_WS_SECRET

# Encryption key untuk internal use
ENCRYPTION_KEY=GANTI_DENGAN_ENCRYPTION_KEY

# JWT untuk Employee Portal
EMPLOYEE_JWT_SECRET=GANTI_DENGAN_EMPLOYEE_JWT_SECRET
EMPLOYEE_JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CRON / SCHEDULED TASKS (Untuk Attendance Alerts)
# ------------------------------------------------------------------------------
# Secret untuk mengamankan endpoint cron
# Generate dengan: openssl rand -base64 32
CRON_SECRET=GANTI_DENGAN_CRON_SECRET

# ------------------------------------------------------------------------------
# VERSIONING (Opsional)
# ------------------------------------------------------------------------------
APP_VERSION=latest
