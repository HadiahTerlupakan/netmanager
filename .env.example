# ===================================================================
# NetManager Local Environment Configuration
# ===================================================================

# Core Configuration
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=***REMOVED***
# Database Variables
POSTGRES_USER=netmgr
POSTGRES_PASSWORD=netmgr
POSTGRES_DB=netmanager

# Koneksi ke DB utama
DATABASE_URL="postgresql://netmgr:netmgr@localhost:5432/netmanager?schema=public"

# Koneksi ke DB Layanan Khusus
POSTGRES_DB_RADIUS=radius
POSTGRES_DB_BILLING=billing
POSTGRES_DB_MITRA=mitra
RADIUS_DATABASE_URL="postgresql://netmgr:netmgr@localhost:5433/radius?schema=public"
DATABASE_URL_BILLING="postgresql://netmgr:netmgr@localhost:5434/billing?schema=public&connection_limit=20&pool_timeout=10"
DATABASE_URL_MITRA="postgresql://netmgr:netmgr@localhost:5435/mitra?schema=public&connection_limit=20&pool_timeout=10"

# Timezone Configuration
# PENTING: Set timezone agar waktu konsisten saat deployment
# Format: IANA timezone (lihat: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Asia/Jakarta

# Security & Sessions
AUTH_SECRET=***REMOVED***
ENCRYPTION_KEY=***REMOVED***
INTERNAL_WS_SECRET=***REMOVED***
WS_SERVER_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
SESSION_MAX_AGE=604800
SESSION_UPDATE_AGE=1800

# ===================================================================
# Application URLs (PENTING)
# ===================================================================

# 1. URL Utama Aplikasi (Admin/Manager)
#    Digunakan untuk redirect payment gateway dan akses umum.
#    Default Dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. URL Portal Karyawan
#    Digunakan untuk pengaturan keamanan (CORS) jika portal karyawan
#    dijalankan di domain/port berbeda.
#    Default Dev (jika terpisah): http://localhost:3001
#    Jika jadi satu monolith: http://localhost:3000
EMPLOYEE_PORTAL_URL=http://localhost:3001

# ===================================================================

# Services
# Redis (Using default localhost w/o password for dev)
REDIS_URL=redis://localhost:6379

# Employee Portal JWT
EMPLOYEE_JWT_SECRET=***REMOVED***
EMPLOYEE_JWT_EXPIRES_IN=7d

# RADIUS (Optional)
RADIUS_SECRET=testing123

# Push Notifications (Web Push / FCM)
# Generate VAPID keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BKaKWPr_8jDZH0aJiXBstwqF2ms5HHuuhMcOkpcZf2D5jIER0_5BtIn8smCBwEjsN1BZ0f_zjxRUCnAr-NfKJ90
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Firebase Admin SDK (Backend)
# Get this from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK (Frontend)
# Get this from Firebase Console > Project Settings > General > Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ===================================================================
