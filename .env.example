# Auth.js v5
AUTH_SECRET=change_me_to_a_strong_secret  # Generate with: openssl rand -base64 32
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000  # Backward compatibility
NEXTAUTH_SECRET=change_me_to_a_strong_secret  # Backward compatibility

# OAuth Encryption Key (for storing OAuth credentials securely)
OAUTH_ENCRYPTION_KEY=change_me_to_a_strong_key  # Generate with: openssl rand -base64 32

# OAuth Providers
# Google OAuth - Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft/Azure AD OAuth - Get credentials from: https://portal.azure.com/
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=your-azure-tenant-id


# Redis (untuk cache/ratelimit)
REDIS_URL=redis://localhost:6380

# CORS Configuration
# Untuk development: http://localhost:3000
# Untuk production: https://yourdomain.com
# Untuk multiple origins: http://localhost:3000,https://yourdomain.com
# Untuk allow all: *
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Test Database (optional - untuk integration tests)
# Jika tidak di-set, akan menggunakan DATABASE_URL
TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}_test?schema=public

# Seed Configuration (optional)
# Jika tidak di-set, akan menggunakan default values
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=admin123


