# ===================================================================
# NetManager Environment Configuration Template
# ===================================================================
# SECURITY NOTICE:
# 1. Generate secure credentials using: node scripts/generate-secure-credentials.js
# 2. Never commit real credentials to version control
# 3. Use different credentials for development and production
# 4. Rotate credentials every 90 days
# ===================================================================

# Auth.js v5 Configuration
# Generate with: openssl rand -base64 32 or use the credential generator
AUTH_SECRET=GENERATE_STRONG_SECRET_HERE
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000  # Backward compatibility
NEXTAUTH_SECRET=GENERATE_STRONG_SECRET_HERE  # Backward compatibility

# OAuth Encryption Key (for storing OAuth credentials securely)
# Generate with: openssl rand -base64 32 or use the credential generator
OAUTH_ENCRYPTION_KEY=GENERATE_STRONG_ENCRYPTION_KEY_HERE

# ===================================================================
# Database Configuration
# ===================================================================
# PostgreSQL Database Settings
POSTGRES_USER=netmgr
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
POSTGRES_DB=netmanager
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Database Connection URL (use SSL in production)
DATABASE_URL=postgresql://netmgr:GENERATE_STRONG_PASSWORD_HERE@localhost:5433/netmanager?sslmode=prefer

# SSL Configuration for Database (uncomment for production)
# SSL_MODE=require
# SSL_CERT_PATH=/path/to/client-cert.pem
# SSL_KEY_PATH=/path/to/client-key.pem
# SSL_CA_PATH=/path/to/server-ca.pem

# ===================================================================
# RADIUS Configuration
# ===================================================================
# Generate with: node scripts/generate-secure-credentials.js
RADIUS_SECRET=GENERATE_STRONG_RADIUS_SECRET_HERE

# ===================================================================
# Redis Configuration (Cache & Rate Limiting)
# ===================================================================
# Basic Redis connection (insecure, for development only)
REDIS_URL=redis://localhost:6380

# Secure Redis connection with authentication (recommended for production)
# REDIS_URL=redis://:REDIS_PASSWORD_HERE@localhost:6380

# ===================================================================
# OAuth Provider Configuration
# ===================================================================
# Google OAuth - Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft/Azure AD OAuth - Get credentials from: https://portal.azure.com/
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=your-azure-client-tenant-id

# ===================================================================
# Security Configuration
# ===================================================================
# CORS Configuration
# Development: http://localhost:3000
# Production: https://yourdomain.com
# Multiple origins: http://localhost:3000,https://yourdomain.com
# Allow all (NOT RECOMMENDED for production): *
CORS_ORIGIN=http://localhost:3000

# Session Security (in seconds)
SESSION_MAX_AGE=604800  # 7 days (recommended: 7 days or less)
SESSION_UPDATE_AGE=3600  # 1 hour (how often to update session)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # requests per window

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_ONLY=false

# ===================================================================
# Application Configuration
# ===================================================================
# Logging Level: error, warn, info, debug
LOG_LEVEL=info

# Environment
NODE_ENV=development

# ===================================================================
# Testing Configuration
# ===================================================================
# Test Database (optional - for integration tests)
# If not set, will use DATABASE_URL
TEST_DATABASE_URL=postgresql://netmgr:GENERATE_STRONG_PASSWORD_HERE@localhost:5433/netmanager_test?schema=public

# ===================================================================
# Seed Configuration
# ===================================================================
# Initial admin user setup (optional)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=GENERATE_STRONG_ADMIN_PASSWORD_HERE

# ===================================================================
# Backup Configuration
# ===================================================================
# Backup retention (in days)
BACKUP_RETENTION_DAYS=30

# Backup encryption (uncomment to enable)
# BACKUP_ENCRYPTION_KEY=GENERATE_BACKUP_ENCRYPTION_KEY_HERE
# BACKUP_ENCRYPTION_ALGORITHM=aes-256-gcm

# ===================================================================
# Monitoring & Analytics
# ===================================================================
# Error tracking (optional)
# SENTRY_DSN=your-sentry-dsn-here

# Analytics (optional)
# GOOGLE_ANALYTICS_ID=your-ga-id-here

# ===================================================================
# Email Configuration (optional)
# ===================================================================
# SMTP settings for notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ===================================================================
# Production Only Settings
# ===================================================================
# Uncomment these for production deployment

# Cookie Security
# COOKIE_DOMAIN=yourdomain.com
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTP_ONLY=true
# SESSION_COOKIE_SAME_STRICT=strict

# SSL/TLS
# FORCE_HTTPS=true
# SSL_CERT_PATH=/path/to/fullchain.pem
# SSL_KEY_PATH=/path/to/privkey.pem

# Security Headers
# HELEMET_ENABLED=true