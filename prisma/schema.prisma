  @@index([kondisi])
  @@index([isHilang])
  @@map("barang_keluar")
}

model StockOpname {
  id                String    @id @default(cuid())
  barangId          String
  gudangId          String
  tanggal           DateTime  @default(now())
  stokFisik         Int
  stokSistem        Int
  selisih           Int
  keterangan        String?
  kondisiBaik       Int       @default(0)
  kondisiRusak      Int       @default(0)
  kondisiExpire     Int       @default(0)
  lokasiPenyimpanan String?
  nomorRak          String?
  nomorBox          String?
  pic               String?
  suhuPenyimpanan   Float?
  kelembaban        Float?
  tanggalExpire     DateTime?
  nomorBatch        String?
  catatanDetail     String?
  createdAt         DateTime  @default(now())
  barang            Barang    @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang            Gudang    @relation(fields: [gudangId], references: [id], onDelete: Cascade)

  @@index([barangId])
  @@index([gudangId])
  @@index([tanggal])
  @@map("stock_opname")
}

model TransferAntarGudang {
  id           String         @id @default(cuid())
  kodeTransfer String         @unique
  barangId     String
  dariGudangId String
  keGudangId   String
  tanggal      DateTime       @default(now())
  jumlah       Int
  kondisi      KondisiBarang  @default(BARU)
  keterangan   String?
  createdAt    DateTime       @default(now())
  keluar       BarangKeluar[]
  masuk        BarangMasuk[]
  barang       Barang         @relation(fields: [barangId], references: [id], onDelete: Cascade)
  dariGudang   Gudang         @relation("TransferDariGudang", fields: [dariGudangId], references: [id], onDelete: Cascade)
  keGudang     Gudang         @relation("TransferKeGudang", fields: [keGudangId], references: [id], onDelete: Cascade)

  @@index([barangId])
  @@index([dariGudangId])
  @@index([keGudangId])
  @@index([tanggal])
  @@index([kondisi])
  @@map("transfer_antar_gudang")
}

model RestockSettings {
  id                   String    @id @default(cuid())
  barangId             String
  gudangId             String
  minStok              Int
  maxStok              Int
  safetyStok           Int       @default(0)
  leadTimeDays         Int       @default(7)
  avgDailyUsage        Float     @default(0)
  lastUsageCalculation DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  barang               Barang    @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang               Gudang    @relation(fields: [gudangId], references: [id], onDelete: Cascade)

  @@unique([barangId, gudangId])
  @@index([barangId])
  @@index([gudangId])
  @@index([isActive])
  @@map("restock_settings")
}

model RestockAlerts {
  id               String       @id @default(cuid())
  barangId         String
  gudangId         String
  alertType        AlertType    @default(RESTOCK_NEEDED)
  currentStok      Int
  minStok          Int
  recommendedOrder Int
  urgency          UrgencyLevel @default(MEDIUM)
  message          String?
  isRead           Boolean      @default(false)
  isResolved       Boolean      @default(false)
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime     @default(now())
  barang           Barang       @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang           Gudang       @relation(fields: [gudangId], references: [id], onDelete: Cascade)

  @@index([barangId])
  @@index([gudangId])
  @@index([isRead])
  @@index([isResolved])
  @@index([alertType])
  @@index([createdAt])
  @@map("restock_alerts")
}

model UsageAnalytics {
  id                String     @id @default(cuid())
  barangId          String
  gudangId          String
  periodType        PeriodType @default(DAILY)
  periodStart       DateTime
  periodEnd         DateTime
  totalUsage        Int        @default(0)
  transactionCount  Int        @default(0)
  avgPerTransaction Float      @default(0)
  createdAt         DateTime   @default(now())
  barang            Barang     @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang            Gudang     @relation(fields: [gudangId], references: [id], onDelete: Cascade)

  @@unique([barangId, gudangId, periodType, periodStart])
  @@index([barangId])
  @@index([gudangId])
  @@index([periodType])
  @@index([periodStart])
  @@map("usage_analytics")
}

