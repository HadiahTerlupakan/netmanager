generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Status {
  AKTIF
  NONAKTIF
  MAINTENANCE
}

enum DurasiUnit {
  JAM
  HARI
  BULAN
  TAHUN
}

enum DiscountType {
  FIXED
  PERCENT
}

enum TipePelanggan {
  REGULER
  NON_REGULER
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Olt {
  id                 String    @id @default(cuid())
  name               String
  ipAddress          String
  type               String // e.g., ZTE-C300
  version            String? // e.g., C300 Version V2.1.0 Software
  temperature        Int? // in Celsius
  connectedDevices   Int       @default(0)
  model              String? // device model
  uptime             String? // e.g., "17 days 14 hours 26 minutes"
  syncStatus         String    @default("0") // percentage
  syncDate           DateTime?
  telnetConnected    Boolean   @default(false)
  snmpConnected      Boolean   @default(false)
  // SNMP Configuration
  snmpCommunityWrite String    @default("public")
  snmpVersion        String    @default("2")
  snmpPort           Int       @default(161)
  // Telnet Configuration
  telnetUsername     String    @default("zte")
  telnetPassword     String
  telnetPort         Int       @default(23)
  // ONU Sync Configuration
  onuLastSync        DateTime? // Waktu terakhir sync ONU data dari SNMP
  onuSyncEnabled     Boolean   @default(true) // Enable/disable auto sync ONU
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  onus          Onu[] // Relasi ke ONU
  onuTypes      OnuType[] // Relasi ke OnuType
  speedProfiles SpeedProfile[] // Relasi ke SpeedProfile

  @@unique([ipAddress])
}

model Otb {
  id        String   @id @default(cuid())
  name      String
  location  String?
  coreCount Int
  notes     String?
  latitude  Float?
  longitude Float?
  status    Status   @default(AKTIF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cores OtbCore[]
}

model OtbCore {
  id        String @id @default(cuid())
  otbId     String
  otb       Otb    @relation(fields: [otbId], references: [id], onDelete: Restrict)
  idx       Int
  slotName  String
  tubeColor String
  coreColor String

  // Back relation: satu slot OTB dapat memiliki satu ODC terhubung
  odc Odc?

  @@unique([otbId, idx])
}

model Odc {
  id        String   @id @default(cuid())
  name      String
  location  String?
  notes     String?
  latitude  Float?
  longitude Float?
  status    Status   @default(AKTIF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi ke slot OTB (OtbCore). Satu ODC menempati satu slot OTB sebagai INPUT.
  otbCoreId String  @unique
  otbCore   OtbCore @relation(fields: [otbCoreId], references: [id], onDelete: Restrict)

  // OUTPUT: Banyak output cores dari ODC ini
  outputs OdcOutput[]
}

model OdcOutput {
  id        String @id @default(cuid())
  odcId     String
  odc       Odc    @relation(fields: [odcId], references: [id], onDelete: Restrict)
  idx       Int // Urutan output core (0-based)
  slotName  String // Nama slot output
  redaman   Float? // Redaman dalam dB (opsional)
  tubeColor String // Warna tube
  coreColor String // Warna core

  // Back relation: satu output core bisa dipakai 0..1 ODP
  odp Odp?

  @@unique([odcId, idx])
}

model Odp {
  id        String   @id @default(cuid())
  name      String
  location  String?
  notes     String?
  latitude  Float?
  longitude Float?
  status    Status   @default(AKTIF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi INPUT: ODP mengambil input dari salah satu output core ODC
  odcOutputId String    @unique
  odcOutput   OdcOutput @relation(fields: [odcOutputId], references: [id], onDelete: Restrict)

  // OUTPUT: Banyak output cores dari ODP ini
  outputs OdpOutput[]

  // Relasi ke Pelanggan
  pelanggans Pelanggan[]
}

model OdpOutput {
  id        String @id @default(cuid())
  odpId     String
  odp       Odp    @relation(fields: [odpId], references: [id], onDelete: Restrict)
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String

  @@unique([odpId, idx])
}

// JOINbox (Bridge/Closure) models
model Joinbox {
  id        String   @id @default(cuid())
  name      String
  location  String?
  notes     String?
  latitude  Float?
  longitude Float?
  status    Status   @default(AKTIF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inputs  JoinboxInput[]
  outputs JoinboxOutput[]
}

model JoinboxInput {
  id        String  @id @default(cuid())
  joinboxId String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id], onDelete: Restrict)
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String

  @@unique([joinboxId, idx])
}

model JoinboxOutput {
  id        String  @id @default(cuid())
  joinboxId String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id], onDelete: Restrict)
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String

  @@unique([joinboxId, idx])
}

model Pole {
  id         String   @id @default(cuid())
  name       String
  location   String?
  notes      String?
  latitude   Float?
  longitude  Float?
  cableSlack Boolean  @default(false)
  status     Status   @default(AKTIF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KmzFile {
  id          String   @id @default(cuid())
  name        String
  filename    String
  filePath    String // Path ke file KML hasil ekstrak
  fileSize    Int // Size dalam bytes
  description String?
  lineColor   String   @default("#3388ff") // Warna garis KMZ (hex color)
  isActive    Boolean  @default(true)
  status      Status   @default(AKTIF)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ONU (Optical Network Unit) - Data dari SNMP OLT
model Onu {
  id           String    @id @default(cuid())
  oltId        String
  olt          Olt       @relation(fields: [oltId], references: [id], onDelete: Cascade)
  name         String // ONU name/identifier
  description  String? // ONU description
  pppoe        String? // PPPoE username (jika ada)
  gponOnu      String // Format: "slot/port:onuId" atau "1/3/1:3"
  status       String // Online, LOS, DyingGasp, OffLine, Unknown
  rxOlt        String? // RX power dari OLT (dBm)
  rxOnu        String? // RX power dari ONU (dBm)
  txOlt        String? // TX power ke OLT (dBm)
  txOnu        String? // TX power dari ONU (dBm)
  serialNumber String? // Serial number ONU
  actualType   String? // ONU type/model
  registerTime DateTime? // Waktu registrasi ONU
  distance     Float? // Jarak fiber dalam km (dihitung dari signal)
  lastSeen     DateTime? // Waktu terakhir komunikasi

  // Basic Info Fields (OID: 1.3.6.1.4.1.3902.1012.3.28.1.1.12, etc)
  registrationMode String? // Registration mode (SN, Password, LOID, dll)
  softwareVersion  String? // Software version ONU
  hardwareVersion  String? // Hardware version ONU
  temperature      Float? // Temperature in Celsius
  laserBiasCurrent Float? // Laser bias current in mA

  // New fields from ZTE-AN-PON-MIB (OID: 1.3.6.1.4.1.3902.1082.50.10.2.2)
  vendorId               String? // ONU vendor ID (zxAnOnuVendorId)
  equipmentId            String? // ONU equipment ID (zxAnOnuEquipmentId)
  firmwareVersion        String? // Firmware version (zxAnOnuFirmwareVersion)
  macAddress             String? // ONU MAC address (zxAnOnuMacAddress)
  batteryStatus          String? // Battery status (zxAnOnuBatteryStatus)
  opticalTransceiverType String? // Optical transceiver type (zxAnOnuOpticalTransceiverType)
  lastDeregTime          DateTime? // Last deregistration time (zxAnOnuLastDeregTime)
  authMode               String? // Authentication mode (zxAnOnuAuthMode)
  loid                   String? // Logical ONU ID (zxAnOnuLoid)
  password               String? // ONU password (zxAnOnuPassword)

  // ONU Status fields (OID: 1.3.6.1.4.1.3902.1082.50.10.2.3)
  configState   String? // Configuration state (zxAnOnuConfigState)
  powerLevel    String? // Power level (zxAnOnuPowerLevel)
  dyingGaspTime DateTime? // Dying gasp time (zxAnOnuDyingGaspTime)

  // Additional optical power status (OID: 1.3.6.1.4.1.3902.1082.50.10.2.28)
  rxPowerStatus String? // RX power status (zxAnOnuRxPowerStatus)
  txPowerStatus String? // TX power status (zxAnOnuTxPowerStatus)

  // Performance Statistics (OID: 1.3.6.1.4.1.3902.1082.50.10.2.31)
  rxBytes   BigInt? // Total bytes received (zxAnGponOnuPonRxBytes)
  txBytes   BigInt? // Total bytes transmitted (zxAnGponOnuPonTxBytes)
  rxPackets BigInt? // Total packets received (zxAnGponOnuPonRxPackets)
  txPackets BigInt? // Total packets transmitted (zxAnGponOnuPonTxPackets)
  rxErrors  BigInt? // Total RX errors (zxAnGponOnuPonRxErrors)
  txErrors  BigInt? // Total TX errors (zxAnGponOnuPonTxErrors)
  rxDrops   BigInt? // Total RX drops (zxAnGponOnuPonRxDrops)
  txDrops   BigInt? // Total TX drops (zxAnGponOnuPonTxDrops)

  // WiFi Configuration (OID: 1.3.6.1.4.1.3902.1082.50.10.2.20)
  wifiEnable       Boolean? // WiFi enable status (zxAnOnuWifiEnable)
  wifiSsid         String? // WiFi SSID (zxAnOnuWifiSsid)
  wifiSecurityMode String? // WiFi security mode (zxAnOnuWifiSecurityMode)
  wifiChannel      Int? // WiFi channel (zxAnOnuWifiChannel)

  lastUpdate DateTime @default(now()) // Waktu terakhir data di-update dari SNMP
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([oltId, gponOnu]) // Satu ONU unik per OLT berdasarkan gponOnu
  @@index([oltId])
  @@index([status])
  @@index([lastUpdate])
  @@index([registerTime])
  @@index([lastSeen])
  @@index([serialNumber])
  @@index([macAddress])
}

// ONU Type - Tipe ONU yang didukung per OLT
model OnuType {
  id                    String   @id @default(cuid())
  oltId                 String
  olt                   Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)
  name                  String // Nama tipe ONU (e.g., "ZTE", "H640GW", "HG8245H")
  ethernetPorts         Int      @default(0) // Jumlah port Ethernet
  wifi                  Int      @default(0) // Jumlah WiFi
  voipPorts             Int      @default(0) // Jumlah port VoIP
  // Detail dari show onu-type
  ponType               String? // PON type (e.g., "gpon")
  description           String? // Description
  maxTcont              Int? // Max T-CONT
  maxGemPort            Int? // Max GEM port
  maxSwitchPerSlot      Int? // Max switch per slot
  maxFlowPerSwitch      Int? // Max flow per switch
  maxIpHost             Int? // Max IP host
  maxIpv6Host           Int? // Max IPv6 host
  serviceAbilityN1      String? // Service ability N:1 (e.g., "support")
  serviceAbility1M      String? // Service ability 1:M (e.g., "support")
  serviceAbility1P      String? // Service ability 1:P (e.g., "support")
  wifiMgmtViaNonOmci    String? // WIFI mgmt via non OMCI (e.g., "disable")
  omciSendMode          String? // OMCI send mode (e.g., "async")
  defaultMulticastRange String? // Default multicast range (e.g., "none")
  vrg                   String? // VRG (e.g., "disable")
  mgcConfigureMode      String? // MGC configure mode (e.g., "zte")
  maxVeip               Int? // Max VEIP
  extendedOmci          String? // Extended OMCI (e.g., "disable")
  location              String? // Location (e.g., "disable")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([oltId, name]) // Satu tipe ONU unik per OLT berdasarkan name
  @@index([oltId])
}

// Speed Profile - Profil kecepatan untuk OLT
model SpeedProfile {
  id           String   @id @default(cuid())
  oltId        String
  olt          Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)
  profileType  String   @default("Download") // "Download" atau "Upload"
  name         String // Nama profil (e.g., "1G", "10Mbps", "20Mbps")
  type         Int // Tipe bandwidth: 1-5 (Fixed, Assured, dll)
  bandwidthSir Int // Bandwidth SIR dalam kbps
  burstPir     Int // Burst PIR dalam kbps
  fixed        Int? // Fixed bandwidth dalam kbps (jika type = 1)
  assured      Int? // Assured bandwidth dalam kbps (jika type = 2 atau 3)
  maximum      Int? // Maximum bandwidth dalam kbps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([oltId, profileType, name]) // Satu profil unik per OLT berdasarkan profileType dan name
  @@index([oltId])
  @@index([profileType])
}

// MikroTik Router [NAS]
model MikroTikRouter {
  id              String    @id @default(cuid())
  name            String // Nama Router
  ipAddress       String // IP Router atau domain
  timezone        String    @default("+07:00 Asia/Jakarta") // Zona Waktu
  apiPort         Int       @default(8728) // Port API
  apiUsername     String // Username API
  apiPassword     String // Password API
  authPort        Int       @default(7265) // Authentication Port
  accountingPort  Int       @default(7266) // Accounting Port
  secretRadius    String // Secret Radius
  isolirUrl       String? // URL Info Isolir (optional)
  description     String? // Deskripsi
  pingStatus      String    @default("offline") // Status ping: "online" atau "offline"
  userOnline      Int       @default(0) // Jumlah user online
  lastStatusCheck DateTime? // Waktu terakhir cek status
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profilePPPs ProfilePPP[] // Profile PPP yang menggunakan router ini sebagai target

  @@unique([ipAddress])
  @@index([pingStatus])
}

// Bandwidth - Profil bandwidth untuk paket internet (sesuai format Queue MikroTik)
model Bandwidth {
  id                     String   @id @default(cuid())
  name                   String   @unique // Nama bandwidth (e.g., "10 Mbps", "20 Mbps", "100 Mbps")
  // Max Limit (wajib)
  maxLimitDownload       String // Max Limit Download (format: "10M" atau "10240k")
  maxLimitUpload         String // Max Limit Upload (format: "10M" atau "10240k")
  // Burst Limit (opsional)
  burstLimitDownload     String? // Burst Limit Download (format: "15M" atau "15360k")
  burstLimitUpload       String? // Burst Limit Upload (format: "15M" atau "15360k")
  // Min Limit (opsional)
  minLimitDownload       String? // Min Limit Download (format: "5M" atau "5120k")
  minLimitUpload         String? // Min Limit Upload (format: "5M" atau "5120k")
  // Burst Threshold (opsional)
  burstThresholdDownload String? // Burst Threshold Download (format: "12M" atau "12288k")
  burstThresholdUpload   String? // Burst Threshold Upload (format: "12M" atau "12288k")
  // Burst Time (opsional, dalam detik)
  burstTimeDownload      Int? // Burst Time Download (dalam detik)
  burstTimeUpload        Int? // Burst Time Upload (dalam detik)
  // Priority (opsional, 1-8)
  priority               Int? // Priority (1-8, default: 8)
  // Legacy fields (untuk backward compatibility)
  uploadSpeed            Int? // Kecepatan upload dalam kbps (deprecated, gunakan maxLimitUpload)
  downloadSpeed          Int? // Kecepatan download dalam kbps (deprecated, gunakan maxLimitDownload)
  description            String? // Deskripsi bandwidth
  status                 Status   @default(AKTIF)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  hargaPakets HargaPaket[]
}

// ProfilePPP - Profil PPPoE untuk autentikasi
model ProfilePPP {
  id               String          @id @default(cuid())
  name             String          @unique // Nama profile PPP (e.g., "Profile-10M", "Profile-20M")
  localAddress     String // Local IP address pool
  remoteAddress    String // Remote IP address pool
  dnsServer        String? // DNS Server (e.g., "8.8.8.8,8.8.4.4")
  sessionTimeout   Int? // Session timeout dalam detik
  idleTimeout      Int? // Idle timeout dalam detik
  // Rate limit diambil dari Bandwidth yang terkait melalui HargaPaket
  mikroTikRouterId String? // Target MikroTik Router (optional)
  mikroTikRouter   MikroTikRouter? @relation(fields: [mikroTikRouterId], references: [id], onDelete: SetNull)
  description      String? // Deskripsi profile
  status           Status          @default(AKTIF)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  hargaPakets HargaPaket[]

  @@index([mikroTikRouterId])
}

// HargaPaket - Daftar paket internet dengan harga
model HargaPaket {
  id                   String        @id @default(cuid())
  name                 String        @unique // Nama paket (e.g., "Paket 10 Mbps", "Paket Gaming")
  bandwidthId          String? // Bandwidth (opsional, rate limit diambil dari Profile PPP)
  bandwidth            Bandwidth?    @relation(fields: [bandwidthId], references: [id], onDelete: SetNull)
  profilePPPId         String
  profilePPP           ProfilePPP    @relation(fields: [profilePPPId], references: [id], onDelete: Restrict)
  harga                Int // Harga dalam rupiah
  durasi               Int           @default(30) // Durasi (nilai numerik)
  durasiUnit           DurasiUnit    @default(HARI) // Unit durasi: JAM, HARI, atau BULAN
  usePPN               Boolean       @default(false) // Gunakan PPN atau tidak
  ppnPercentage        Float? // Persentase PPN (jika usePPN = true)
  useDiscount          Boolean       @default(false) // Gunakan diskon atau tidak
  discountType         DiscountType? // Jenis diskon: FIXED atau PERCENT
  discountValue        Float? // Nilai diskon (nominal jika FIXED, persentase jika PERCENT)
  discountDuration     Int? // Durasi diskon berlaku (nilai numerik)
  discountDurationUnit DurasiUnit? // Unit durasi diskon: JAM, HARI, BULAN, atau TAHUN
  description          String? // Deskripsi paket
  featured             Boolean       @default(false) // Paket unggulan
  status               Status        @default(AKTIF)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  pelanggans Pelanggan[] // Relasi ke Pelanggan

  @@index([bandwidthId])
  @@index([profilePPPId])
  @@index([status])
  @@index([featured])
}

// Pelanggan - Data pelanggan PPPoE
model Pelanggan {
  id                            String        @id @default(cuid())
  idPelanggan                   String        @unique // ID Pelanggan 8 digit (unique)
  nama                          String // Nama lengkap pelanggan
  username                      String // Username PPPoE
  password                      String // Password PPPoE (untuk koneksi PPPoE)
  passwordLogin                 String // Password Login Portal (untuk login di portal pelanggan)
  hargaPaketId                  String
  hargaPaket                    HargaPaket    @relation(fields: [hargaPaketId], references: [id], onDelete: Restrict)
  tipe                          TipePelanggan @default(REGULER) // Tipe pelanggan: REGULER atau NON_REGULER
  tanggalAktif                  DateTime // Tanggal aktif layanan
  jatuhTempo                    DateTime // Tanggal jatuh tempo pembayaran
  status                        Status        @default(AKTIF) // Status: AKTIF, NONAKTIF, MAINTENANCE
  alamat                        String? // Alamat pelanggan
  provinsi                      String? // Provinsi
  kabupatenKota                 String? // Kabupaten/Kota
  kelurahanDesa                 String? // Kelurahan/Desa
  kecamatan                     String? // Kecamatan
  noTelp                        String? // Nomor telepon
  email                         String? // Email pelanggan
  latitude                      Float? // Titik koordinat latitude
  longitude                     Float? // Titik koordinat longitude
  jenisDokumen                  String? // Jenis dokumen: KTP, SIM, atau Paspor
  noDokumen                     String? // Nomor dokumen (KTP/SIM/Paspor)
  fileKTP                       String? // Path file KTP
  fileRumahSekitar              String? // Path file Rumah Sekitar
  fileBAST                      String? // Path file BAST
  catatan                       String? // Catatan tambahan
  usePPN                        Boolean       @default(true) // Gunakan PPN atau tidak
  useDiscount                   Boolean       @default(false) // Gunakan diskon atau tidak
  useProrate                    Boolean       @default(false) // Gunakan perhitungan prorate atau tidak
  // Custom diskon per pelanggan (jika diisi, akan override diskon dari paket)
  discountType                  DiscountType? // Jenis diskon custom: FIXED atau PERCENT
  discountValue                 Float? // Nilai diskon custom (nominal jika FIXED, persentase jika PERCENT)
  discountDuration              Int? // Durasi diskon custom berlaku (nilai numerik)
  discountDurationUnit          DurasiUnit? // Unit durasi diskon custom: JAM, HARI, BULAN, atau TAHUN
  // Biaya lain-lain
  biayaInstalasi                Int? // Biaya instalasi (opsional)
  biayaInstalasiIsRecurring     Boolean       @default(false) // Apakah biaya instalasi berulang atau 1x
  biayaInstalasiDiskon          Float? // Diskon persentase untuk biaya instalasi (opsional)
  biayaSewaPerangkat            Int? // Biaya sewa perangkat (opsional)
  biayaSewaPerangkatIsRecurring Boolean       @default(true) // Apakah biaya sewa perangkat berulang atau 1x (default: berulang)
  biayaSewaPerangkatDiskon      Float? // Diskon persentase untuk sewa perangkat (opsional)
  biayaLainnya                  Int? // Biaya lain-lain (opsional)
  biayaLainnyaIsRecurring       Boolean       @default(false) // Apakah biaya lain-lain berulang atau 1x
  biayaLainnyaDiskon            Float? // Diskon persentase untuk biaya lain-lain (opsional)
  keteranganBiayaLainnya        String? // Keterangan untuk biaya lain-lain
  odpId                         String? // ODP yang digunakan pelanggan (opsional)
  odp                           Odp?          @relation(fields: [odpId], references: [id], onDelete: SetNull)
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  @@index([idPelanggan])
  @@index([hargaPaketId])
  @@index([status])
  @@index([tipe])
  @@index([tanggalAktif])
  @@index([jatuhTempo])
  @@index([email])
}

// Settings - Konfigurasi aplikasi
model Settings {
  id          String   @id @default(cuid())
  key         String   @unique // Key pengaturan (e.g., "GOOGLE_GEMINI_API_KEY")
  value       String? // Value pengaturan (bisa null untuk rahasia)
  encrypted   Boolean  @default(false) // Apakah value di-encrypt
  description String? // Deskripsi pengaturan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}
