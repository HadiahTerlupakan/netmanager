generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Olt {
  id                String   @id @default(cuid())
  name              String
  ipAddress         String
  type              String   // e.g., ZTE-C300
  version           String?  // e.g., C300 Version V2.1.0 Software
  temperature       Int?     // in Celsius
  connectedDevices  Int      @default(0)
  model             String?  // device model
  uptime            String?  // e.g., "17 days 14 hours 26 minutes"
  syncStatus        String   @default("0") // percentage
  syncDate          DateTime?
  telnetConnected   Boolean  @default(false)
  snmpConnected     Boolean  @default(false)
  // SNMP Configuration
  snmpCommunityWrite String  @default("public")
  snmpVersion       String   @default("2")
  snmpPort          Int      @default(161)
  // Telnet Configuration
  telnetUsername    String   @default("zte")
  telnetPassword    String
  telnetPort        Int      @default(23)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([ipAddress])
}


model Otb {
  id         String   @id @default(cuid())
  name       String
  location   String?
  coreCount  Int
  notes      String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cores      OtbCore[]
}

model OtbCore {
  id         String  @id @default(cuid())
  otbId      String
  otb        Otb     @relation(fields: [otbId], references: [id], onDelete: Restrict)
  idx        Int
  slotName   String
  tubeColor  String
  coreColor  String

  @@unique([otbId, idx])

  // Back relation: satu slot OTB dapat memiliki satu ODC terhubung
  odc        Odc?
}


model Odc {
  id         String   @id @default(cuid())
  name       String
  location   String?
  notes      String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relasi ke slot OTB (OtbCore). Satu ODC menempati satu slot OTB sebagai INPUT.
  otbCoreId  String   @unique
  otbCore    OtbCore  @relation(fields: [otbCoreId], references: [id], onDelete: Restrict)

  // OUTPUT: Banyak output cores dari ODC ini
  outputs    OdcOutput[]

}

model OdcOutput {
  id         String   @id @default(cuid())
  odcId      String
  odc        Odc      @relation(fields: [odcId], references: [id], onDelete: Restrict)
  idx        Int      // Urutan output core (0-based)
  slotName   String   // Nama slot output
  redaman    Float?   // Redaman dalam dB (opsional)
  tubeColor  String   // Warna tube
  coreColor  String   // Warna core

  @@unique([odcId, idx])

  // Back relation: satu output core bisa dipakai 0..1 ODP
  odp        Odp?
}


model Odp {
  id            String      @id @default(cuid())
  name          String
  location      String?
  notes         String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relasi INPUT: ODP mengambil input dari salah satu output core ODC
  odcOutputId   String      @unique
  odcOutput     OdcOutput   @relation(fields: [odcOutputId], references: [id], onDelete: Restrict)

  // OUTPUT: Banyak output cores dari ODP ini
  outputs       OdpOutput[]
}

model OdpOutput {
  id         String   @id @default(cuid())
  odpId      String
  odp        Odp      @relation(fields: [odpId], references: [id], onDelete: Restrict)
  idx        Int
  slotName   String
  redaman    Float?
  tubeColor  String
  coreColor  String

  @@unique([odpId, idx])
}

// JOINbox (Bridge/Closure) models
model Joinbox {
  id         String   @id @default(cuid())
  name       String
  location   String?
  notes      String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  inputs     JoinboxInput[]
  outputs    JoinboxOutput[]
}

model JoinboxInput {
  id         String   @id @default(cuid())
  joinboxId  String
  joinbox    Joinbox  @relation(fields: [joinboxId], references: [id], onDelete: Restrict)
  idx        Int
  inputUnit  String
  portUnit   String
  tubeColor  String
  coreColor  String

  @@unique([joinboxId, idx])
}

model JoinboxOutput {
  id         String   @id @default(cuid())
  joinboxId  String
  joinbox    Joinbox  @relation(fields: [joinboxId], references: [id], onDelete: Restrict)
  idx        Int
  inputUnit  String
  portUnit   String
  tubeColor  String
  coreColor  String

  @@unique([joinboxId, idx])
}

