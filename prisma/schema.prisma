model PurchaseRequest {
  id           String                @id
  nomorRequest String                @unique // PR-YYYYMMDD-XXXX
  tanggal      DateTime              @default(now())
  status       PurchaseRequestStatus @default(DRAFT)
  prioritas    String                @default("NORMAL")

  // Relations
  requesterId String
  gudangId    String

  keterangan      String?
  catatanApproval String?

  // Procurement Relation
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?
  approvedBy String?

  // Foreign Keys
  requester User   @relation("Requester", fields: [requesterId], references: [id])
  gudang    Gudang @relation(fields: [gudangId], references: [id])

  // Items relation
  items PurchaseRequestItem[]

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String @id
  purchaseRequestId String
  barangId          String

  jumlah       Int
  hargaPerUnit Float @default(0) // Estimasi harga
  totalHarga   Float @default(0)

  keterangan String?

  // Relations
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  barang          Barang          @relation(fields: [barangId], references: [id])

  @@map("purchase_request_items")
}

model Supplier {
  id        String          @id @default(uuid())
  code      String          @unique
  name      String
  address   String?
  contact   String?
  email     String?
  phone     String?
  items     Barang[]
  pos       PurchaseOrder[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("suppliers")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String              @unique
  supplierId   String?
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Float
  ppnRate      Float               @default(0) // Percentage (e.g. 11)
  ppnAmount    Float               @default(0)
  grandTotal   Float               @default(0) // totalAmount + ppnAmount
  issuedAt     DateTime?
  expectedDate DateTime?
  notes        String?

  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]
  purchaseRequests PurchaseRequest[]

  paidFromAccountId String?
  paidFromAccount   FinancialAccount? @relation("POPaidFrom", fields: [paidFromAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  processedById String?
  receivedById  String?

  creator     User  @relation("POCreator", fields: [createdBy], references: [id])
  processedBy User? @relation("POProcessor", fields: [processedById], references: [id])
  receivedBy  User? @relation("POReceiver", fields: [receivedById], references: [id])

  paymentStatus PaymentStatus @default(UNPAID)

  @@map("purchase_orders")
}

