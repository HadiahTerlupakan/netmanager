generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  FINANCE
  HR
}

enum Status {
  AKTIF
  NONAKTIF
  MAINTENANCE
}

enum DurasiUnit {
  JAM
  HARI
  BULAN
  TAHUN
}

enum DiscountType {
  FIXED
  PERCENT
}

enum TipePelanggan {
  REGULER
  NON_REGULER
}

enum TagihanStatus {
  BELUM_LUNAS
  LUNAS
  TERLAMBAT
}

enum TipePengeluaran {
  CAPEX
  OPEX
}

enum KondisiBarang {
  BARU    // Barang baru
  BEKAS   // Barang bekas (masih bisa dipakai)
  RUSAK   // Barang rusak (masih ada fisiknya)
}

// ============================================
// RESTOCK MANAGEMENT ENUMS
// ============================================

enum AlertType {
  RESTOCK_NEEDED
  STOCK_OUT
  LOW_STOCK
  OVERSTOCK
  EXPIRED_WARNING
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PeriodType {
  DAILY
  WEEKLY
  MONTHLY
}

// ============================================
// HRIS ENUMS
// ============================================

enum EmploymentStatus {
  PROBATION // Masa percobaan
  PERMANENT // Karyawan tetap
  CONTRACT // Kontrak
  INTERNSHIP // Magang
  TERMINATED // Keluar/diberhentikan
}

enum AttendanceStatus {
  PRESENT // Hadir
  LATE // Terlambat
  ABSENT // Tidak hadir
  LEAVE // Cuti
  SICK_LEAVE // Sakit
  PERMISSION // Izin
  REMOTE // WFH/Remote
}

enum LeaveType {
  ANNUAL // Cuti tahunan
  SICK // Sakit
  PERMISSION // Izin
  MATERNITY // Melahirkan
  PATERNITY // Ayah
  UNPAID // Tanpa gaji
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
}

enum SalaryComponentType {
  BASIC_SALARY // Gaji pokok
  ALLOWANCE // Tunjangan
  BONUS // Bonus
  DEDUCTION // Potongan
  TAX // Pajak
  INSURANCE // Asuransi
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFERED
  ACCEPTED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[] // OAuth accounts (Google, GitHub, Microsoft, etc.)
  sessions      Session[]
  pelanggan     Pelanggan[]
  tickets       Ticket[]
  pemasukanCreated Pemasukan[] @relation("PemasukanCreatedBy")
  pemasukanUpdated Pemasukan[] @relation("PemasukanUpdatedBy")
  pengeluaranCreated Pengeluaran[] @relation("PengeluaranCreatedBy")
  pengeluaranUpdated Pengeluaran[] @relation("PengeluaranUpdatedBy")
  bankAccountsCreated BankAccount[] @relation("BankAccountCreatedBy")
  bankAccountsUpdated BankAccount[] @relation("BankAccountUpdatedBy")
  transactionsCreated Transaction[] @relation("TransactionCreatedBy")
  transactionsUpdated Transaction[] @relation("TransactionUpdatedBy")
}

// OAuth Account model for Auth.js v5
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Olt {
  id                 String    @id @default(cuid())
  name               String
  ipAddress          String
  type               String // e.g., ZTE-C300
  version            String? // e.g., C300 Version V2.1.0 Software
  temperature        Int? // in Celsius
  connectedDevices   Int       @default(0)
  model              String? // device model
  uptime             String? // e.g., "17 days 14 hours 26 minutes"
  syncStatus         String    @default("0") // percentage
  syncDate           DateTime?
  telnetConnected    Boolean   @default(false)
  snmpConnected      Boolean   @default(false)
  // SNMP Configuration
  snmpCommunityWrite String    @default("public")
  snmpVersion        String    @default("2")
  snmpPort           Int       @default(161)
  // Telnet Configuration
  telnetUsername     String    @default("zte")
  telnetPassword     String
  telnetPort         Int       @default(23)
  // ONU Sync Configuration
  onuLastSync        DateTime? // Waktu terakhir sync ONU data dari SNMP
  onuSyncEnabled     Boolean   @default(true) // Enable/disable auto sync ONU
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  onus          Onu[] // Relasi ke ONU
  onuTypes      OnuType[] // Relasi ke OnuType
  speedProfiles SpeedProfile[] // Relasi ke SpeedProfile

  @@unique([ipAddress])
}

model Otb {
  id                          String   @id @default(cuid())
  name                        String
  location                    String?
  coreCount                   Int
  notes                       String?
  keteranganJumlahKabelFeeder String?
  latitude                    Float?
  longitude                   Float?
  status                      Status   @default(AKTIF)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  cores OtbCore[]
}

model OtbCore {
  id        String @id @default(cuid())
  otbId     String
  otb       Otb    @relation(fields: [otbId], references: [id], onDelete: Restrict)
  idx       Int
  slotName  String
  tubeColor String
  coreColor String

  // Back relation: satu slot OTB dapat memiliki satu ODC terhubung
  odc Odc?

  @@unique([otbId, idx])
}

model Odc {
  id                          String   @id @default(cuid())
  name                        String
  location                    String?
  notes                       String?
  keteranganJumlahKabelFeeder String?
  latitude                    Float?
  longitude                   Float?
  status                      Status   @default(AKTIF)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Relasi ke slot OTB (OtbCore). Satu ODC menempati satu slot OTB sebagai INPUT.
  otbCoreId String  @unique
  otbCore   OtbCore @relation(fields: [otbCoreId], references: [id], onDelete: Restrict)

  // OUTPUT: Banyak output cores dari ODC ini
  outputs OdcOutput[]
}

model OdcOutput {
  id        String @id @default(cuid())
  odcId     String
  odc       Odc    @relation(fields: [odcId], references: [id], onDelete: Restrict)
  idx       Int // Urutan output core (0-based)
  slotName  String // Nama slot output
  redaman   Float? // Redaman dalam dB (opsional)
  tubeColor String // Warna tube
  coreColor String // Warna core

  // Back relation: satu output core bisa dipakai 0..1 ODP
  odp Odp?

  @@unique([odcId, idx])
}

model Odp {
  id                          String   @id @default(cuid())
  name                        String
  location                    String?
  notes                       String?
  keteranganJumlahKabelFeeder String?
  latitude                    Float?
  longitude                   Float?
  status                      Status   @default(AKTIF)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Relasi INPUT: ODP mengambil input dari salah satu output core ODC
  odcOutputId String    @unique
  odcOutput   OdcOutput @relation(fields: [odcOutputId], references: [id], onDelete: Restrict)

  // OUTPUT: Banyak output cores dari ODP ini
  outputs OdpOutput[]

  // Relasi ke Pelanggan
  pelanggans Pelanggan[]
}

model OdpOutput {
  id        String @id @default(cuid())
  odpId     String
  odp       Odp    @relation(fields: [odpId], references: [id], onDelete: Restrict)
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String

  @@unique([odpId, idx])
}

// JOINbox (Bridge/Closure) models
model Joinbox {
  id                          String   @id @default(cuid())
  name                        String
  location                    String?
  notes                       String?
  keteranganJumlahKabelFeeder String?
  latitude                    Float?
  longitude                   Float?
  status                      Status   @default(AKTIF)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  inputs  JoinboxInput[]
  outputs JoinboxOutput[]
}

model JoinboxInput {
  id        String  @id @default(cuid())
  joinboxId String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id], onDelete: Restrict)
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String

  @@unique([joinboxId, idx])
}

model JoinboxOutput {
  id        String  @id @default(cuid())
  joinboxId String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id], onDelete: Restrict)
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String

  @@unique([joinboxId, idx])
}

model Pole {
  id         String   @id @default(cuid())
  name       String
  location   String?
  notes      String?
  latitude   Float?
  longitude  Float?
  cableSlack Boolean  @default(false)
  status     Status   @default(AKTIF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KmzFile {
  id          String   @id @default(cuid())
  name        String
  filename    String
  filePath    String // Path ke file KMZ asli
  kmlPath     String // Path ke file KML hasil ekstrak
  fileSize    Int // Size dalam bytes
  description String?
  lineColor   String   @default("#3388ff") // Warna garis KMZ (hex color)
  isActive    Boolean  @default(true)
  status      Status   @default(AKTIF)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ONU (Optical Network Unit) - Data dari SNMP OLT
model Onu {
  id           String    @id @default(cuid())
  oltId        String
  olt          Olt       @relation(fields: [oltId], references: [id], onDelete: Cascade)
  name         String // ONU name/identifier
  description  String? // ONU description
  pppoe        String? // PPPoE username (jika ada)
  gponOnu      String // Format: "slot/port:onuId" atau "1/3/1:3"
  status       String // Online, LOS, DyingGasp, OffLine, Unknown
  rxOlt        String? // RX power dari OLT (dBm)
  rxOnu        String? // RX power dari ONU (dBm)
  txOlt        String? // TX power ke OLT (dBm)
  txOnu        String? // TX power dari ONU (dBm)
  serialNumber String? // Serial number ONU
  actualType   String? // ONU type/model
  registerTime DateTime? // Waktu registrasi ONU
  distance     Float? // Jarak fiber dalam km (dihitung dari signal)
  lastSeen     DateTime? // Waktu terakhir komunikasi

  // Basic Info Fields (OID: 1.3.6.1.4.1.3902.1012.3.28.1.1.12, etc)
  registrationMode String? // Registration mode (SN, Password, LOID, dll)
  softwareVersion  String? // Software version ONU
  hardwareVersion  String? // Hardware version ONU
  temperature      Float? // Temperature in Celsius
  laserBiasCurrent Float? // Laser bias current in mA

  // New fields from ZTE-AN-PON-MIB (OID: 1.3.6.1.4.1.3902.1082.50.10.2.2)
  vendorId               String? // ONU vendor ID (zxAnOnuVendorId)
  equipmentId            String? // ONU equipment ID (zxAnOnuEquipmentId)
  firmwareVersion        String? // Firmware version (zxAnOnuFirmwareVersion)
  macAddress             String? // ONU MAC address (zxAnOnuMacAddress)
  batteryStatus          String? // Battery status (zxAnOnuBatteryStatus)
  opticalTransceiverType String? // Optical transceiver type (zxAnOnuOpticalTransceiverType)
  lastDeregTime          DateTime? // Last deregistration time (zxAnOnuLastDeregTime)
  authMode               String? // Authentication mode (zxAnOnuAuthMode)
  loid                   String? // Logical ONU ID (zxAnOnuLoid)
  password               String? // ONU password (zxAnOnuPassword)

  // ONU Status fields (OID: 1.3.6.1.4.1.3902.1082.50.10.2.3)
  configState   String? // Configuration state (zxAnOnuConfigState)
  powerLevel    String? // Power level (zxAnOnuPowerLevel)
  dyingGaspTime DateTime? // Dying gasp time (zxAnOnuDyingGaspTime)

  // Additional optical power status (OID: 1.3.6.1.4.1.3902.1082.50.10.2.28)
  rxPowerStatus String? // RX power status (zxAnOnuRxPowerStatus)
  txPowerStatus String? // TX power status (zxAnOnuTxPowerStatus)

  // Performance Statistics (OID: 1.3.6.1.4.1.3902.1082.50.10.2.31)
  rxBytes   BigInt? // Total bytes received (zxAnGponOnuPonRxBytes)
  txBytes   BigInt? // Total bytes transmitted (zxAnGponOnuPonTxBytes)
  rxPackets BigInt? // Total packets received (zxAnGponOnuPonRxPackets)
  txPackets BigInt? // Total packets transmitted (zxAnGponOnuPonTxPackets)
  rxErrors  BigInt? // Total RX errors (zxAnGponOnuPonRxErrors)
  txErrors  BigInt? // Total TX errors (zxAnGponOnuPonTxErrors)
  rxDrops   BigInt? // Total RX drops (zxAnGponOnuPonRxDrops)
  txDrops   BigInt? // Total TX drops (zxAnGponOnuPonTxDrops)

  // WiFi Configuration (OID: 1.3.6.1.4.1.3902.1082.50.10.2.20)
  wifiEnable       Boolean? // WiFi enable status (zxAnOnuWifiEnable)
  wifiSsid         String? // WiFi SSID (zxAnOnuWifiSsid)
  wifiSecurityMode String? // WiFi security mode (zxAnOnuWifiSecurityMode)
  wifiChannel      Int? // WiFi channel (zxAnOnuWifiChannel)

  // SNMP OID fields - untuk fast SNMP GET tanpa perlu menghitung composite index
  statusOid      String? // Full OID untuk status (e.g., "1.3.6.1.4.1.3902.1012.3.28.2.1.4.268566528.3")
  rxOltOid       String? // Full OID untuk RX OLT
  rxOnuOid       String? // Full OID untuk RX ONU
  nameOid        String? // Full OID untuk name
  descOid        String? // Full OID untuk description
  compositeIndex Int? // Composite index untuk backup (jika OID tidak tersedia)

  lastUpdate DateTime @default(now()) // Waktu terakhir data di-update dari SNMP
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([oltId, gponOnu]) // Satu ONU unik per OLT berdasarkan gponOnu
  // Single-column indexes for basic queries
  @@index([oltId])
  @@index([status])
  @@index([lastUpdate])
  @@index([registerTime])
  @@index([lastSeen])
  @@index([serialNumber])
  @@index([macAddress])
  // Composite indexes for optimized filtering & sorting (Phase 5)
  @@index([oltId, status]) // Filter by OLT + status (very common query)
  @@index([oltId, lastUpdate]) // OLT list sorted by update time
  @@index([status, lastUpdate]) // Status filter sorted by update
  @@index([oltId, gponOnu]) // Fast lookup by OLT + gponOnu (alternative to unique)
}

// ONU Type - Tipe ONU yang didukung per OLT
model OnuType {
  id                    String   @id @default(cuid())
  oltId                 String
  olt                   Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)
  name                  String // Nama tipe ONU (e.g., "ZTE", "H640GW", "HG8245H")
  ethernetPorts         Int      @default(0) // Jumlah port Ethernet
  wifi                  Int      @default(0) // Jumlah WiFi
  voipPorts             Int      @default(0) // Jumlah port VoIP
  // Detail dari show onu-type
  ponType               String? // PON type (e.g., "gpon")
  description           String? // Description
  maxTcont              Int? // Max T-CONT
  maxGemPort            Int? // Max GEM port
  maxSwitchPerSlot      Int? // Max switch per slot
  maxFlowPerSwitch      Int? // Max flow per switch
  maxIpHost             Int? // Max IP host
  maxIpv6Host           Int? // Max IPv6 host
  serviceAbilityN1      String? // Service ability N:1 (e.g., "support")
  serviceAbility1M      String? // Service ability 1:M (e.g., "support")
  serviceAbility1P      String? // Service ability 1:P (e.g., "support")
  wifiMgmtViaNonOmci    String? // WIFI mgmt via non OMCI (e.g., "disable")
  omciSendMode          String? // OMCI send mode (e.g., "async")
  defaultMulticastRange String? // Default multicast range (e.g., "none")
  vrg                   String? // VRG (e.g., "disable")
  mgcConfigureMode      String? // MGC configure mode (e.g., "zte")
  maxVeip               Int? // Max VEIP
  extendedOmci          String? // Extended OMCI (e.g., "disable")
  location              String? // Location (e.g., "disable")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([oltId, name]) // Satu tipe ONU unik per OLT berdasarkan name
  @@index([oltId])
}

// Speed Profile - Profil kecepatan untuk OLT
model SpeedProfile {
  id           String   @id @default(cuid())
  oltId        String
  olt          Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)
  profileType  String   @default("Download") // "Download" atau "Upload"
  name         String // Nama profil (e.g., "1G", "10Mbps", "20Mbps")
  type         Int // Tipe bandwidth: 1-5 (Fixed, Assured, dll)
  bandwidthSir Int // Bandwidth SIR dalam kbps
  burstPir     Int // Burst PIR dalam kbps
  fixed        Int? // Fixed bandwidth dalam kbps (jika type = 1)
  assured      Int? // Assured bandwidth dalam kbps (jika type = 2 atau 3)
  maximum      Int? // Maximum bandwidth dalam kbps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([oltId, profileType, name]) // Satu profil unik per OLT berdasarkan profileType dan name
  @@index([oltId])
  @@index([profileType])
}

// MikroTik Router [NAS]
model MikroTikRouter {
  id              String    @id @default(cuid())
  name            String // Nama Router
  ipAddress       String // IP Router atau domain
  timezone        String    @default("+07:00 Asia/Jakarta") // Zona Waktu
  apiPort         Int       @default(8728) // Port API
  apiUsername     String // Username API
  apiPassword     String // Password API
  authPort        Int       @default(7265) // Authentication Port
  accountingPort  Int       @default(7266) // Accounting Port
  secretRadius    String // Secret Radius
  isolirUrl       String? // URL Info Isolir (optional)
  description     String? // Deskripsi
  pingStatus      String    @default("offline") // Status ping: "online" atau "offline"
  userOnline      Int       @default(0) // Jumlah user online
  lastStatusCheck DateTime? // Waktu terakhir cek status
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profilePPPs ProfilePPP[] // Profile PPP yang menggunakan router ini sebagai target

  @@unique([ipAddress])
  @@index([pingStatus])
}

// Bandwidth - Profil bandwidth untuk paket internet (sesuai format Queue MikroTik)
model Bandwidth {
  id                     String   @id @default(cuid())
  name                   String   @unique // Nama bandwidth (e.g., "10 Mbps", "20 Mbps", "100 Mbps")
  // Max Limit (wajib)
  maxLimitDownload       String // Max Limit Download (format: "10M" atau "10240k")
  maxLimitUpload         String // Max Limit Upload (format: "10M" atau "10240k")
  // Burst Limit (opsional)
  burstLimitDownload     String? // Burst Limit Download (format: "15M" atau "15360k")
  burstLimitUpload       String? // Burst Limit Upload (format: "15M" atau "15360k")
  // Min Limit (opsional)
  minLimitDownload       String? // Min Limit Download (format: "5M" atau "5120k")
  minLimitUpload         String? // Min Limit Upload (format: "5M" atau "5120k")
  // Burst Threshold (opsional)
  burstThresholdDownload String? // Burst Threshold Download (format: "12M" atau "12288k")
  burstThresholdUpload   String? // Burst Threshold Upload (format: "12M" atau "12288k")
  // Burst Time (opsional, dalam detik)
  burstTimeDownload      Int? // Burst Time Download (dalam detik)
  burstTimeUpload        Int? // Burst Time Upload (dalam detik)
  // Priority (opsional, 1-8)
  priority               Int? // Priority (1-8, default: 8)
  // Legacy fields (untuk backward compatibility)
  uploadSpeed            Int? // Kecepatan upload dalam kbps (deprecated, gunakan maxLimitUpload)
  downloadSpeed          Int? // Kecepatan download dalam kbps (deprecated, gunakan maxLimitDownload)
  description            String? // Deskripsi bandwidth
  status                 Status   @default(AKTIF)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  hargaPakets HargaPaket[]
}

// ProfilePPP - Profil PPPoE untuk autentikasi
model ProfilePPP {
  id               String          @id @default(cuid())
  name             String          @unique // Nama profile PPP (e.g., "Profile-10M", "Profile-20M")
  localAddress     String // Local IP address pool
  remoteAddress    String // Remote IP address pool
  dnsServer        String? // DNS Server (e.g., "8.8.8.8,8.8.4.4")
  sessionTimeout   Int? // Session timeout dalam detik
  idleTimeout      Int? // Idle timeout dalam detik
  // Rate limit diambil dari Bandwidth yang terkait melalui HargaPaket
  mikroTikRouterId String? // Target MikroTik Router (optional)
  mikroTikRouter   MikroTikRouter? @relation(fields: [mikroTikRouterId], references: [id], onDelete: SetNull)
  description      String? // Deskripsi profile
  status           Status          @default(AKTIF)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  hargaPakets HargaPaket[]

  @@index([mikroTikRouterId])
}

// HargaPaket - Daftar paket internet dengan harga
model HargaPaket {
  id                   String        @id @default(cuid())
  name                 String        @unique // Nama paket (e.g., "Paket 10 Mbps", "Paket Gaming")
  bandwidthId          String? // Bandwidth (opsional, rate limit diambil dari Profile PPP)
  bandwidth            Bandwidth?    @relation(fields: [bandwidthId], references: [id], onDelete: SetNull)
  profilePPPId         String
  profilePPP           ProfilePPP    @relation(fields: [profilePPPId], references: [id], onDelete: Restrict)
  harga                Int // Harga dalam rupiah
  durasi               Int           @default(30) // Durasi (nilai numerik)
  durasiUnit           DurasiUnit    @default(HARI) // Unit durasi: JAM, HARI, atau BULAN
  usePPN               Boolean       @default(false) // Gunakan PPN atau tidak
  ppnPercentage        Float? // Persentase PPN (jika usePPN = true)
  useDiscount          Boolean       @default(false) // Gunakan diskon atau tidak
  discountType         DiscountType? // Jenis diskon: FIXED atau PERCENT
  discountValue        Float? // Nilai diskon (nominal jika FIXED, persentase jika PERCENT)
  discountDuration     Int? // Durasi diskon berlaku (nilai numerik)
  discountDurationUnit DurasiUnit? // Unit durasi diskon: JAM, HARI, BULAN, atau TAHUN
  description          String? // Deskripsi paket
  featured             Boolean       @default(false) // Paket unggulan
  status               Status        @default(AKTIF)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  pelanggans Pelanggan[] // Relasi ke Pelanggan

  @@index([bandwidthId])
  @@index([profilePPPId])
  @@index([status])
  @@index([featured])
}

// Pelanggan - Data pelanggan PPPoE
model Pelanggan {
  id                            String        @id @default(cuid())
  userId                        String? // User ID yang terkait (optional)
  idPelanggan                   String        @unique // ID Pelanggan 8 digit (unique)
  nama                          String // Nama lengkap pelanggan
  username                      String // Username PPPoE
  password                      String // Password PPPoE (untuk koneksi PPPoE)
  passwordLogin                 String // Password Login Portal (untuk login di portal pelanggan)
  passwordHash                  String? // Hash dari passwordLogin (untuk keamanan)
  tokenVersion                  Int           @default(1) // Version untuk refresh token invalidation
  hargaPaketId                  String
  hargaPaket                    HargaPaket    @relation(fields: [hargaPaketId], references: [id], onDelete: Restrict)
  tipe                          TipePelanggan @default(REGULER) // Tipe pelanggan: REGULER atau NON_REGULER
  tanggalAktif                  DateTime // Tanggal aktif layanan
  jatuhTempo                    DateTime // Tanggal jatuh tempo pembayaran
  status                        Status        @default(AKTIF) // Status: AKTIF, NONAKTIF, MAINTENANCE
  alamat                        String? // Alamat pelanggan
  provinsi                      String? // Provinsi
  kabupatenKota                 String? // Kabupaten/Kota
  kelurahanDesa                 String? // Kelurahan/Desa
  kecamatan                     String? // Kecamatan
  noTelp                        String? // Nomor telepon
  email                         String? // Email pelanggan
  latitude                      Float? // Titik koordinat latitude
  longitude                     Float? // Titik koordinat longitude
  jenisDokumen                  String? // Jenis dokumen: KTP, SIM, atau Paspor
  noDokumen                     String? // Nomor dokumen (KTP/SIM/Paspor)
  fileKTP                       String? // Path file KTP
  fileRumahSekitar              String? // Path file Rumah Sekitar
  fileBAST                      String? // Path file BAST
  catatan                       String? // Catatan tambahan
  usePPN                        Boolean       @default(true) // Gunakan PPN atau tidak
  useDiscount                   Boolean       @default(false) // Gunakan diskon atau tidak
  useProrate                    Boolean       @default(false) // Gunakan perhitungan prorate atau tidak
  // Custom diskon per pelanggan (jika diisi, akan override diskon dari paket)
  discountType                  DiscountType? // Jenis diskon custom: FIXED atau PERCENT
  discountValue                 Float? // Nilai diskon custom (nominal jika FIXED, persentase jika PERCENT)
  discountDuration              Int? // Durasi diskon custom berlaku (nilai numerik)
  discountDurationUnit          DurasiUnit? // Unit durasi diskon custom: JAM, HARI, BULAN, atau TAHUN
  // Biaya lain-lain
  biayaInstalasi                Int? // Biaya instalasi (opsional)
  biayaInstalasiIsRecurring     Boolean       @default(false) // Apakah biaya instalasi berulang atau 1x
  biayaInstalasiDiskon          Float? // Diskon persentase untuk biaya instalasi (opsional)
  biayaSewaPerangkat            Int? // Biaya sewa perangkat (opsional)
  biayaSewaPerangkatIsRecurring Boolean       @default(true) // Apakah biaya sewa perangkat berulang atau 1x (default: berulang)
  biayaSewaPerangkatDiskon      Float? // Diskon persentase untuk sewa perangkat (opsional)
  biayaLainnya                  Int? // Biaya lain-lain (opsional)
  biayaLainnyaIsRecurring       Boolean       @default(false) // Apakah biaya lain-lain berulang atau 1x
  biayaLainnyaDiskon            Float? // Diskon persentase untuk biaya lain-lain (opsional)
  keteranganBiayaLainnya        String? // Keterangan untuk biaya lain-lain
  odpId                         String? // ODP yang digunakan pelanggan (opsional)
  odp                           Odp?          @relation(fields: [odpId], references: [id], onDelete: SetNull)
  user                          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  tagihans Tagihan[] // Relasi ke Tagihan
  
  // Relasi ke Ticket Helpdesk & Work Orders
  tickets     Ticket[]
  workOrders  WorkOrder[] // Relasi ke Ticket Helpdesk
  
  // Relasi ke Manual Payments
  manualPayments ManualPayment[]

  @@index([idPelanggan])
  @@index([hargaPaketId])
  @@index([status])
  @@index([tipe])
  @@index([tanggalAktif])
  @@index([jatuhTempo])
  @@index([email])
}

// Tagihan - Data tagihan pelanggan
model Tagihan {
  id                 String        @id @default(cuid())
  pelangganId        String
  pelanggan          Pelanggan     @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  noTagihan          String        @unique // Nomor tagihan (format: TAG-YYYYMM-XXXX)
  periodeBulan       Int // 1-12
  periodeTahun       Int // 2024, 2025, dll
  // Rincian tagihan
  subtotal           Int // Subtotal sebelum PPN dan diskon
  diskon             Int           @default(0) // Jumlah diskon
  ppn                Int           @default(0) // Jumlah PPN
  biayaInstalasi     Int           @default(0) // Biaya instalasi (jika recurring)
  biayaSewaPerangkat Int           @default(0) // Biaya sewa perangkat (jika recurring)
  biayaLainnya       Int           @default(0) // Biaya lain-lain (jika recurring)
  total              Int // Total tagihan (subtotal - diskon + ppn + biaya tambahan)
  // Status dan tanggal
  status             TagihanStatus @default(BELUM_LUNAS)
  jatuhTempo         DateTime // Tanggal jatuh tempo pembayaran
  tanggalBayar       DateTime? // Tanggal pembayaran (jika sudah dibayar)
  metodePembayaran   String? // Metode pembayaran (e.g., "TRANSFER", "CASH", "OVO", dll)
  catatan            String? // Catatan tambahan
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  paymentTransactions PaymentGatewayTransaction[]
  paymentLink         PaymentLink?
  manualPayments      ManualPayment[]

  @@unique([pelangganId, periodeBulan, periodeTahun]) // Satu tagihan per pelanggan per periode
  @@index([pelangganId])
  @@index([status])
  @@index([jatuhTempo])
  @@index([noTagihan])
  @@index([periodeBulan, periodeTahun])
  @@index([createdAt])
}

// ============================================
// PAYMENT GATEWAY TABLES
// ============================================

// Payment Gateway Configuration (Multi-provider support)
model PaymentGatewayConfig {
  id String @id @default(cuid())

  // Provider identification
  provider     String @unique // "XENDIT", "MIDTRANS", "DUITKU", "BCA_API", "DANA_API"
  providerName String // Display name: "Xendit", "Midtrans", etc.

  // Configuration
  isEnabled    Boolean @default(false)
  isProduction Boolean @default(false) // Sandbox vs Production
  priority     Int     @default(0) // Higher = preferred (for auto-routing)

  // API Credentials (ENCRYPTED!)
  apiKey     String? // Main API key/Server key (encrypted)
  apiSecret  String? // Secret key (encrypted, if applicable)
  clientKey  String? // Client key (for frontend, if applicable)
  merchantId String? // Merchant/Account ID

  // Additional settings
  webhookUrl  String? // Auto-generated webhook URL
  callbackUrl String? // Payment callback URL

  // Provider-specific settings (JSON)
  settings Json? // { "enabledMethods": ["bank_transfer", "ewallet"], "fees": {...} }

  // Metadata
  lastTestedAt DateTime? // Last successful test
  testStatus   String? // "SUCCESS", "FAILED", error message

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // Admin user ID

  // Relations
  transactions PaymentGatewayTransaction[]

  @@index([provider])
  @@index([isEnabled])
  @@index([priority])
}

// Payment Gateway Transactions
model PaymentGatewayTransaction {
  id String @id @default(cuid())

  // Gateway details
  provider       String // "XENDIT", "MIDTRANS", etc.
  providerConfig PaymentGatewayConfig @relation(fields: [provider], references: [provider])
  orderId        String               @unique // Our internal order ID (TAG-XXX-YYY)
  transactionId  String?              @unique // Gateway's transaction ID

  // Payment details
  tagihanId     String // Link to invoice
  tagihan       Tagihan @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  amount        BigInt // Amount in rupiah
  paymentMethod String? // "bank_transfer", "gopay", "credit_card", etc.
  bankCode      String? // "bca", "mandiri", "bni", etc.

  // Status tracking
  status    String    @default("PENDING") // PENDING, PAID, EXPIRED, CANCELLED, FAILED
  paidAt    DateTime? // When payment completed
  expiredAt DateTime? // Payment link expiry

  // Gateway response
  paymentUrl String? // Payment page URL
  qrCodeUrl  String? // For QRIS/e-wallet
  vaNumber   String? // Virtual account number (for bank transfer)

  // Webhook data
  webhookReceived Boolean @default(false)
  webhookData     Json? // Store raw webhook payload

  // Metadata
  customerEmail String?
  customerPhone String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tagihanId])
  @@index([status])
  @@index([orderId])
  @@index([transactionId])
  @@index([createdAt])
}

// Payment Links (Persistent links for customer portal)
model PaymentLink {
  id String @id @default(cuid())

  tagihanId String  @unique // One link per invoice
  tagihan   Tagihan @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  linkToken  String @unique // URL-safe token for public link
  paymentUrl String // Full payment URL

  isActive  Boolean   @default(true)
  expiresAt DateTime? // Optional expiry

  // Track usage
  viewCount    Int       @default(0) // How many times opened
  lastViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([linkToken])
  @@index([tagihanId])
}

// ============================================
// MANUAL PAYMENT (Bank Transfer)
// ============================================

// Company Bank Accounts - Company bank accounts for customer manual payments
model CompanyBankAccount {
  id            String   @id @default(cuid())
  bankName      String // BCA, BRI, Mandiri, BNI, etc
  accountNumber String
  accountName   String // Account holder name
  isActive      Boolean  @default(true)
  priority      Int      @default(1) // Display order (higher = shown first)
  logo          String? // Bank logo URL (optional)
  description   String? // Additional info for customers
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  manualPayments ManualPayment[]

  @@index([isActive])
  @@index([priority])
}

// Manual Payments - Customer bank transfer submissions
model ManualPayment {
  id              String    @id @default(cuid())
  tagihanId       String
  tagihan         Tagihan   @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  pelangganId     String
  pelanggan       Pelanggan @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  
  // Transfer details
  bankAccountId   String // Which company bank account they transferred to
  bankAccount     CompanyBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  amount          BigInt // Amount transferred (in rupiah)
  senderName      String // Name on the transfer
  transferDate    DateTime // Date of transfer
  
  // Proof of payment
  proofImageUrl   String // Storage path for proof image
  notes           String? // Customer notes/additional info
  
  // Verification status
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  verifiedBy      String? // Admin user ID who verified
  verifiedAt      DateTime?
  rejectionReason String? // If rejected, why
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tagihanId])
  @@index([pelangganId])
  @@index([status])
  @@index([createdAt])
}

// Pengeluaran - Data pengeluaran untuk cashflow
model Pengeluaran {
  id              String          @id @default(cuid())
  nomorBukti     String?         // Nomor bukti transaksi
  tanggal         DateTime // Tanggal pengeluaran
  tipePengeluaran TipePengeluaran @default(OPEX) // CAPEX atau OPEX
  kategori        String // Kategori pengeluaran (e.g., "OPERASIONAL", "PEMELIHARAAN", "GAJI", "BONUS", "SEWA", "LISTRIK_PLN", "LISTRIK_PDAM", "LISTRIK_INTERNET", "LISTRIK_TELEPON", "INTERNET", "TELEPON", "MAINTENANCE_OFFICE", "MAINTENANCE_EQUIPMENT", "MAINTENANCE_SERVER", "BIAYA_INSTALLASI", "BIAYA_KONSUMSI", "BIAYA_CUTI", "BIAYA_CUTI", "BIAYA_ASURANSI", "BIAYA_JAMSOSTEK", "BIAYA_LEAVE", "BIAYA_LAINNYA", "SEWA_KANTOR", "SEWA_GEDUNG", "SEWA_EQUIPMENT", "SEWA_KENDARAAN", "LISTRIK_PLN", "LISTRIK_PDAM", "LISTRIK_INTERNET", "LISTRIK_TELEPON", "INTERNET_BACKBONE", "BANDWIDTH", "VOICE_CALL", "SMS_GATEWAY", "MAINTENANCE_OFFICE", "MAINTENANCE_EQUIPMENT", "MAINTENANCE_SERVER", "BIAYA_KEBERSIHAN", "BIAYA_KONSUMSI", "BIAYA_PPAJ", "BIAYA_PPH", "PAJAK_REKLAME", "PAJAK_BEBAN_BAKU", "ASURANSI_KARYAWAN", "ASURANSI_KENDARAAN", "ASURANSI_PROPERTY", "ASURANSI_LIABILITY", "BANK_ADMIN", "BANK_TRANSFER", "BANK_MATERAI", "BANK_CASH", "E_WALLET", "MARKETING", "ADVERTISING", "TRAINING", "TRAVEL", "ENTERTAINMENT", "LEGAL", "AKUNTANSI", "AUDIT", "LAINNYA")
  deskripsi       String // Deskripsi pengeluaran
  jumlah          BigInt // Jumlah pengeluaran (dalam rupiah)
  metodeBayar     String? // Metode pembayaran (e.g., "TRANSFER", "CASH", "DEBIT", "KREDIT", "E-WALLET")
  catatan         String? // Catatan tambahan
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String? // User ID yang membuat (optional)
  updatedBy       String? // User ID yang update terakhir (optional)
  
  // Budget tracking
  budgetId String? // Link to budget for tracking
  
  // Approval workflow
  isApproved Boolean   @default(false)
  approvedBy String? // User ID yang approve
  approvedAt DateTime? // Waktu approval

  createdByUser User? @relation("PengeluaranCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("PengeluaranUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tanggal])
  @@index([kategori])
  @@index([tipePengeluaran])
  @@index([budgetId])
  @@index([isApproved])
}

// Pemasukan - Data pemasukan manual untuk cashflow
model Pemasukan {
  id              String          @id @default(cuid())
  nomorBukti     String?         // Nomor bukti transaksi
  tanggal         DateTime // Tanggal pemasukan
  kategori        String // Kategori pemasukan (e.g., "PENJUALAN", "INVESTASI", "BONUS", "HADIAH", "SEWA", "LAINNYA")
  deskripsi       String // Deskripsi pemasukan
  jumlah          BigInt // Jumlah pemasukan (dalam rupiah)
  metodeBayar     String? // Metode pembayaran (e.g., "TRANSFER", "CASH", "DEBIT", "KREDIT", "E-WALLET")
  catatan         String? // Catatan tambahan
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String? // User ID yang membuat (optional)
  updatedBy       String? // User ID yang update terakhir (optional)
  
  // Verification workflow
  isVerified Boolean   @default(false)
  verifiedBy String? // User ID yang verify
  verifiedAt DateTime? // Waktu verification

  createdByUser User? @relation("PemasukanCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("PemasukanUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tanggal])
  @@index([kategori])
  @@index([isVerified])
}

// Settings - Konfigurasi aplikasi
model Settings {
  id          String   @id @default(cuid())
  key         String   @unique // Key pengaturan (e.g., "GOOGLE_GEMINI_API_KEY")
  value       String? // Value pengaturan (bisa null untuk rahasia)
  encrypted   Boolean  @default(false) // Apakah value di-encrypt
  description String? // Deskripsi pengaturan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// OAuth Provider Configuration (Dynamic OAuth support)
model OAuthProviderConfig {
  id String @id @default(cuid())

  // Provider identification
  provider     String @unique // "GOOGLE", "GITHUB", "MICROSOFT", "FACEBOOK", "LINKEDIN", etc.
  providerName String // Display name: "Google", "GitHub", etc.

  // Configuration
  isEnabled    Boolean @default(false)
  isProduction Boolean @default(false) // For providers with sandbox environments
  priority     Int     @default(0) // Display order priority

  // OAuth Credentials (ENCRYPTED!)
  clientId     String? // OAuth Client ID (encrypted)
  clientSecret String? // OAuth Client Secret (encrypted)
  tenantId     String? // Azure AD Tenant ID (encrypted, if applicable)

  // OAuth Configuration
  scope        String? // OAuth scopes (comma-separated)
  redirectUri  String? // Custom redirect URI (auto-generated if not provided)

  // Provider-specific settings (JSON)
  settings Json? // { "hostedDomain": "example.com", "allowSignup": true, "prompt": "consent" }

  // Metadata
  lastTestedAt DateTime? // Last successful test
  testStatus   String? // "SUCCESS", "FAILED", error message
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String? // Admin user ID

  @@map("oauth_provider_configs")
  @@index([provider])
  @@index([isEnabled])
  @@index([priority])
}

// ============================================
// FINANCE MODULES - AR, Bank Reconciliation, MRR/ARR
// ============================================

// BankAccount - Support multiple bank accounts
model BankAccount {
  id              String          @id @default(cuid())
  namaBank        String // Nama bank (e.g., "BCA", "Mandiri", "BNI", "BRI")
  nomorRekening   String // Nomor rekening
  namaPemilik     String // Nama pemilik rekening
  saldoAwal       BigInt // Saldo awal rekening
  saldoSaatIni    BigInt // Saldo saat ini
  mataUang        String @default("IDR") // Mata uang (default IDR)
  isActive        Boolean @default(true) // Status aktif/tidak
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String? // User ID yang membuat (optional)
  updatedBy       String? // User ID yang update terakhir (optional)
  createdByUser    User? @relation("BankAccountCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser    User? @relation("BankAccountUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  transactions    Transaction[] // Relasi ke transaksi
  statements      BankStatement[]
  reconciliations Reconciliation[]
}

// BankStatement - Imported from bank
model BankStatement {
  id              String      @id @default(cuid())
  bankAccountId   String
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactionDate DateTime
  description     String
  reference       String? // Bank reference number
  debit           BigInt      @default(0) // Money out
  credit          BigInt      @default(0) // Money in
  balance         BigInt // Balance after this transaction
  isReconciled    Boolean     @default(false)
  reconciledAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  reconciliationMatch ReconciliationMatch[]

  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([isReconciled])
  @@index([bankAccountId, transactionDate])
}

// Reconciliation - Monthly reconciliation records
model Reconciliation {
  id                String      @id @default(cuid())
  bankAccountId     String
  bankAccount       BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  month             Int // 1-12
  year              Int // 2024, 2025
  openingBalance    BigInt
  closingBalance    BigInt
  totalDeposits     BigInt // Total in dari bank statement
  totalWithdrawals  BigInt // Total out dari bank statement
  systemDeposits    BigInt // Total in dari system (Invoice payments)
  systemWithdrawals BigInt // Total out dari system (Expenses)
  difference        BigInt // Should be 0 when reconciled
  isCompleted       Boolean     @default(false)
  completedAt       DateTime?
  completedBy       String? // User ID
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([bankAccountId, month, year])
  @@index([bankAccountId])
  @@index([year, month])
}

// ReconciliationMatch - Mapping between bank statements and system records
model ReconciliationMatch {
  id                String        @id @default(cuid())
  bankStatementId   String
  bankStatement     BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  matchType         String // "PAYMENT_IN", "PAYMENT_OUT", "INTERNAL_TRANSFER"
  matchedEntityType String // "TAGIHAN", "PENGELUARAN", "PEMASUKAN"
  matchedEntityId   String // ID of Tagihan/Pengeluaran/Pemasukan
  confidence        Float         @default(1.0) // 0.0-1.0, for auto-matching
  notes             String?
  matchedBy         String? // User ID (null for auto-match)
  createdAt         DateTime      @default(now())

  @@index([bankStatementId])
  @@index([matchedEntityType, matchedEntityId])
}

// CollectionTask - Tasks untuk follow-up piutang
model CollectionTask {
  id          String    @id @default(cuid())
  pelangganId String
  tagihanId   String? // Optional, bisa untuk specific tagihan
  assignedTo  String? // User ID
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  dueDate     DateTime
  notes       String?
  resolution  String? // Notes ketika task completed
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  followUps CollectionFollowUp[]

  @@index([pelangganId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
}

// CollectionFollowUp - Log komunikasi dengan pelanggan
model CollectionFollowUp {
  id               String         @id @default(cuid())
  collectionTaskId String
  collectionTask   CollectionTask @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  method           String // "PHONE", "WHATSAPP", "EMAIL", "SMS", "VISIT"
  notes            String // Isi komunikasi
  response         String? // Response dari pelanggan
  followUpBy       String? // User ID
  followUpAt       DateTime       @default(now())

  @@index([collectionTaskId])
  @@index([followUpAt])
}

// Payment - Track payment details (enhancement to existing flow)
model Payment {
  id            String    @id @default(cuid())
  tagihanId     String? // Optional, payment could be for multiple tagihan
  pelangganId   String
  amount        BigInt
  paymentDate   DateTime
  paymentMethod String // "TRANSFER", "CASH", "OVO", "GOPAY", etc.
  bankAccountId String? // Which bank account received this payment
  reference     String? // Payment reference number
  notes         String?
  verifiedBy    String? // User ID who verified
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tagihanId])
  @@index([pelangganId])
  @@index([paymentDate])
  @@index([bankAccountId])
}

// ARAgingSnapshot - Historical aging data for trending
model ARAgingSnapshot {
  id               String   @id @default(cuid())
  snapshotDate     DateTime @default(now())
  current          BigInt   @default(0) // 0-30 days
  overdue30        BigInt   @default(0) // 31-60 days
  overdue60        BigInt   @default(0) // 61-90 days
  overdue90        BigInt   @default(0) // 90+ days
  totalOutstanding BigInt   @default(0)
  totalCustomers   Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([snapshotDate])
}

// MRRMovement - Track MRR changes
model MRRMovement {
  id           String   @id @default(cuid())
  month        Int // 1-12
  year         Int
  movementType String // "NEW", "EXPANSION", "CONTRACTION", "CHURN", "REACTIVATION"
  pelangganId  String? // Optional, for tracking specific customer
  amount       BigInt // Amount of MRR change
  description  String?
  createdAt    DateTime @default(now())

  @@index([year, month])
  @@index([movementType])
  @@index([pelangganId])
}

// RevenueSnapshot - Daily/Monthly revenue aggregates
model RevenueSnapshot {
  id               String   @id @default(cuid())
  snapshotDate     DateTime
  snapshotType     String   @default("DAILY") // DAILY, MONTHLY
  totalMRR         BigInt   @default(0)
  totalARR         BigInt   @default(0)
  newMRR           BigInt   @default(0)
  expansionMRR     BigInt   @default(0)
  contractionMRR   BigInt   @default(0)
  churnMRR         BigInt   @default(0)
  reactivationMRR  BigInt   @default(0)
  activeCustomers  Int      @default(0)
  newCustomers     Int      @default(0)
  churnedCustomers Int      @default(0)
  arpu             Int      @default(0) // Average Revenue Per User
  createdAt        DateTime @default(now())

  @@unique([snapshotDate, snapshotType])
  @@index([snapshotDate])
  @@index([snapshotType])
}

// ReminderLog - Track semua reminder yang dikirim
model ReminderLog {
  id            String    @id @default(cuid())
  pelangganId   String
  tagihanId     String? // Optional
  reminderType  String // "PRE_DUE", "DUE_DATE", "OVERDUE_7", "OVERDUE_14", "OVERDUE_30"
  channel       String // "EMAIL", "WHATSAPP", "SMS"
  recipient     String // Email or phone number
  subject       String? // For email
  message       String
  status        String    @default("PENDING") // PENDING, SENT, FAILED, DELIVERED
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())

  @@index([pelangganId])
  @@index([tagihanId])
  @@index([status])
  @@index([createdAt])
}

// CustomerCohort - Customer cohort tracking
model CustomerCohort {
  id               String   @id @default(cuid())
  cohortMonth      Int // Month of first customer registration (1-12)
  cohortYear       Int // Year of first customer registration
  initialCustomers Int // Number of customers in this cohort initially
  month0Revenue    BigInt   @default(0) // Revenue in month 0 (registration month)
  month1Revenue    BigInt   @default(0) // Revenue in month 1
  month2Revenue    BigInt   @default(0) // Revenue in month 2
  month3Revenue    BigInt   @default(0) // Revenue in month 3
  month6Revenue    BigInt   @default(0) // Revenue in month 6
  month12Revenue   BigInt   @default(0) // Revenue in month 12
  activeMonth0     Int      @default(0) // Active customers in month 0
  activeMonth1     Int      @default(0) // Active customers in month 1
  activeMonth3     Int      @default(0) // Active customers in month 3
  activeMonth6     Int      @default(0) // Active customers in month 6
  activeMonth12    Int      @default(0) // Active customers in month 12
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([cohortYear, cohortMonth])
  @@index([cohortYear, cohortMonth])
}

// ============================================
// TAX MANAGEMENT & BUDGETING SYSTEM
// ============================================

// TaxRecord - Track all tax transactions (PPN, PPh)
model TaxRecord {
  id                String    @id @default(cuid())
  taxType           String // "PPN_IN", "PPN_OUT", "PPH_21", "PPH_23", "PPH_4_2"
  taxPeriod         Int // Month (1-12)
  taxYear           Int
  taxableAmount     BigInt // DPP (Dasar Pengenaan Pajak)
  taxAmount         BigInt // Jumlah pajak
  taxRate           Float // Tax rate (e.g., 0.11 for 11%)
  reference         String? // Invoice number, payment reference
  relatedEntityType String? // "TAGIHAN", "VENDOR_INVOICE", "PAYROLL"
  relatedEntityId   String? // ID of related entity
  status            String    @default("DRAFT") // DRAFT, FILED, PAID
  filedAt           DateTime?
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?
  updatedBy         String?

  @@index([taxType, taxPeriod, taxYear])
  @@index([relatedEntityType, relatedEntityId])
  @@index([status])
  @@index([taxPeriod, taxYear])
}

// TaxFilingDeadline - Track tax filing deadlines
model TaxFilingDeadline {
  id        String    @id @default(cuid())
  taxType   String // "PPN", "PPH_21", "PPH_23", "PPH_4_2", "PPH_ANNUAL"
  period    Int // Month (1-12)
  year      Int
  deadline  DateTime
  status    String    @default("PENDING") // PENDING, FILED, LATE
  filedAt   DateTime?
  filedBy   String? // User ID
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([taxType, period, year])
  @@index([deadline])
  @@index([status])
  @@index([year, period])
}

// BudgetCategory - Hierarchical budget categories
model BudgetCategory {
  id          String           @id @default(cuid())
  code        String           @unique // "OPEX_OPR", "CAPEX_NET", etc.
  name        String // "Operational Expense", "Network CAPEX"
  type        String // "OPEX", "CAPEX"
  parentId    String?
  parent      BudgetCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    BudgetCategory[] @relation("CategoryHierarchy")
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  budgets Budget[]

  @@index([type])
  @@index([parentId])
  @@index([isActive])
}

// Budget - Monthly budget planning and tracking
model Budget {
  id              String         @id @default(cuid())
  year            Int
  month           Int
  categoryId      String
  category        BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department      String? // For larger organizations
  budgetAmount    BigInt
  actualAmount    BigInt         @default(0)
  variance        BigInt         @default(0) // actualAmount - budgetAmount
  variancePercent Float          @default(0) // (variance / budgetAmount) * 100
  status          String         @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, ACTIVE, CLOSED
  approvedBy      String? // User ID
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String?
  updatedBy       String?

  alerts BudgetAlert[]

  @@unique([year, month, categoryId])
  @@index([year, month])
  @@index([status])
  @@index([categoryId])
}

// CashFlowForecast - Cash flow projections
model CashFlowForecast {
  id                String   @id @default(cuid())
  forecastDate      DateTime // Date being forecasted
  scenarioType      String // "BEST_CASE", "WORST_CASE", "MOST_LIKELY"
  projectedRevenue  BigInt
  projectedExpenses BigInt
  projectedCashFlow BigInt // revenue - expenses
  projectedBalance  BigInt // cumulative balance
  confidence        Float    @default(0.7) // 0.0-1.0
  assumptions       String? // JSON: assumptions used
  notes             String?
  createdAt         DateTime @default(now())
  createdBy         String?

  @@index([forecastDate])
  @@index([scenarioType])
  @@index([forecastDate, scenarioType])
}

// BudgetAlert - Budget monitoring alerts
model BudgetAlert {
  id        String    @id @default(cuid())
  budgetId  String
  budget    Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  alertType String // "APPROACHING_LIMIT", "EXCEEDED", "VARIANCE_HIGH"
  threshold Float // Percentage threshold (e.g., 80, 100, 120)
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  readBy    String?
  createdAt DateTime  @default(now())

  @@index([budgetId])
  @@index([isRead])
  @@index([createdAt])
}

// USO (Universal Service Obligation) - ISP Compliance
model USOContribution {
  id      String @id @default(cuid())
  quarter Int // 1-4
  year    Int

  // Financial data
  totalRevenue BigInt // Gross revenue for quarter
  usoRate      Float  @default(0.0125) // 1.25%
  usoAmount    BigInt // Calculated: revenue * rate

  // Status tracking
  status       String    @default("DRAFT") // DRAFT, CALCULATED, FILED, PAID
  calculatedAt DateTime?
  filedAt      DateTime?
  filedBy      String?
  paidAt       DateTime?
  paidBy       String?

  // Reference
  paymentReference String? // Reference to Pengeluaran ID
  notes            String? @db.Text

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([quarter, year])
  @@index([status])
  @@index([year, quarter])
  @@map("uso_contributions")
}

// Deferred Revenue - Subscription revenue recognition
model DeferredRevenue {
  id String @id @default(cuid())

  // Source
  tagihanId  String? // Reference to original invoice
  customerId String? // Customer reference

  // Financial
  totalAmount      BigInt // Total deferred amount
  recognizedAmount BigInt @default(0) // Already recognized
  remainingAmount  BigInt // Still deferred

  // Schedule
  startDate     DateTime // When to start recognizing
  endDate       DateTime // When to stop
  periodMonths  Int // Number of months (e.g., 12)
  monthlyAmount BigInt // Amount per month

  // Status
  status String @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED

  // Metadata
  description String?
  notes       String? @db.Text

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relations
  recognitions RevenueRecognition[]

  @@index([status])
  @@index([tagihanId])
  @@index([startDate, endDate])
  @@map("deferred_revenues")
}

// Revenue Recognition - Monthly recognition tracking
model RevenueRecognition {
  id                String          @id @default(cuid())
  deferredRevenueId String
  deferredRevenue   DeferredRevenue @relation(fields: [deferredRevenueId], references: [id], onDelete: Cascade)

  // Recognition details
  recognitionDate DateTime // Month being recognized (start of month)
  amount          BigInt // Amount recognized
  notes           String?

  // Link to Pemasukan (auto-created recognized revenue)
  pemasukanId String? // Auto-created Pemasukan

  // Audit
  createdAt    DateTime @default(now())
  recognizedBy String?

  @@unique([deferredRevenueId, recognitionDate])
  @@index([deferredRevenueId])
  @@index([recognitionDate])
  @@map("revenue_recognitions")
}

// ============================================
// HRIS MODELS
// ============================================

// Department - Departemen/divisi perusahaan
model Department {
  id              String   @id @default(cuid())
  name            String   @unique // e.g., "IT", "Finance", "Operations"
  description     String?
  jobDescription  String?  @db.Text // Deskripsi pekerjaan/tugas department
  allowedFeatures String?  @db.Text // JSON array of features yang bisa diakses (e.g., ["FINANCE", "HRIS", "PELANGGAN"])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employees   Employee[]
  positions   Position[]
  workOrders  WorkOrder[]
  customRoles CustomRole[] // Custom roles for this department

  @@map("departments")
}

// Position - Jabatan/posisi
model Position {
  id           String      @id @default(cuid())
  title        String      @unique // e.g., "Software Engineer", "HR Manager"
  code         String?     @unique // Position code
  level        String? // e.g., "Junior", "Senior", "Manager", "Director"
  description  String?
  departmentId String? // Link to department
  department   Department? @relation(fields: [departmentId], references: [id])
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employees Employee[]

  @@index([isActive])
  @@index([departmentId])
  @@map("positions")
}

// Custom Role - User-defined roles with custom permissions
model CustomRole {
  id          String  @id @default(cuid())
  name        String // e.g., "Field Technician", "Sales Manager", "Department Head"
  code        String  @unique // e.g., "FIELD_TECH", "SALES_MGR", "DEPT_HEAD" (auto-generated or manual)
  description String?
  
  // Department binding (required - role must be tied to a department)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  
  // Permissions - JSON array of allowed features
  allowedFeatures String? @db.Text // e.g., ["WORKORDERS", "FTTH", "NETWORK"]
  
  // Priority system for conflict resolution (1-100)
  // Higher priority = wins in conflicts
  // 1-25: Low priority (basic roles)
  // 26-75: Medium priority (standard roles)
  // 76-100: High priority (manager/special roles)
  priority Int @default(50)
  
  // Status
  isActive Boolean @default(true)
  
  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // User ID who created this role
  
  // Relations
  employeeRoles EmployeeRole[]
  auditLogs     RoleAuditLog[]
  
  @@unique([departmentId, code]) // Unique code per department
  @@index([departmentId])
  @@index([isActive])
  @@index([priority])
  @@map("custom_roles")
}

// Employee Role Assignment - Many-to-many between Employee and CustomRole
model EmployeeRole {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleId     String
  role       CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  // Assignment metadata
  assignedAt DateTime @default(now())
  assignedBy String // User ID who assigned this role (required for audit)
  
  @@unique([employeeId, roleId]) // Employee can have each role only once
  @@index([employeeId])
  @@index([roleId])
  @@index([assignedAt])
  @@map("employee_roles")
}

// Role Audit Log - Track all role-related changes
model RoleAuditLog {
  id String @id @default(cuid())
  
  // What was changed
  action     String // "CREATE", "UPDATE", "DELETE", "ASSIGN", "UNASSIGN"
  entityType String // "ROLE", "ASSIGNMENT"
  entityId   String // ID of the role or assignment
  
  // Role reference (optional - null for assignments)
  roleId String?
  role   CustomRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  
  // Who made the change
  userId   String // User ID who performed the action
  userName String? // User name at time of action (for display)
  
  // What changed (JSON)
  oldValues Json? // Previous values (for UPDATE)
  newValues Json? // New values (for CREATE/UPDATE)
  
  // Context
  ipAddress String? // IP address of the user
  userAgent String? @db.Text // Browser/client info
  notes     String? @db.Text // Optional notes/reason
  
  createdAt DateTime @default(now())
  
  @@index([roleId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("role_audit_logs")
}

// Employee - Data karyawan (master data)
model Employee {
  id         String  @id @default(cuid())
  employeeId String  @unique // Employee ID (e.g., "EMP-001")
  userId     String? @unique // Link to User account (optional)

  // Personal Info
  fullName     String
  email        String?   @unique
  phone        String?
  dateOfBirth  DateTime?
  gender       String? // "MALE", "FEMALE"
  idCardNumber String?   @unique // KTP number
  address      String?
  city         String?
  province     String?
  postalCode   String?

  // Employment Info
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId       String?
  position         Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentStatus EmploymentStatus @default(PROBATION)
  joinDate         DateTime // Tanggal bergabung
  endDate          DateTime? // Tanggal keluar (if terminated)
  probationEndDate DateTime? // End of probation period

  // Manager/Supervisor
  managerId String? // Direct manager

  // Emergency Contact
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Bank Info (for salary transfer)
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?

  // Tax Info
  npwp       String? // Nomor Pokok Wajib Pajak
  ptkpStatus String? // Status PTKP (TK/0, K/0, K/1, etc.)

  // Photo
  photoUrl String?

  // Status
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // Relations
  documents           EmployeeDocument[]
  attendances         Attendance[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  overtimes           Overtime[]
  employeeSalaries    EmployeeSalary[]
  payrollDetails      PayrollDetail[]
  performanceReviews  PerformanceReview[]
  performanceGoals    PerformanceGoal[]
  trainingEnrollments TrainingEnrollment[]
  employeeSkills      EmployeeSkill[]
  
  // Work Order relations
  workOrders           WorkOrder[]
  workOrderAssignments WorkOrderAssignment[]
  taskCompletions      WorkOrderTask[]
  workOrderUpdates     WorkOrderUpdate[]
  workOrderAttachments WorkOrderAttachment[]
  
  // Custom Role relations
  customRoles EmployeeRole[]

  @@index([departmentId])
  @@index([positionId])
  @@index([employmentStatus])
  @@index([isActive])
  @@index([email])
  @@map("employees")
}

// Employee Documents - Dokumen karyawan
model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  documentType String // "KTP", "KK", "IJAZAH", "SERTIFIKAT", "CONTRACT", etc.
  fileName     String
  filePath     String // Path to uploaded file
  fileSize     Int? // Size in bytes
  description  String?
  uploadedAt   DateTime @default(now())
  uploadedBy   String? // User ID who uploaded

  @@index([employeeId])
  @@index([documentType])
  @@map("employee_documents")
}

// Attendance - Record kehadiran dengan geolocation
model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date DateTime // Tanggal kehadiran

  // Check In
  checkInTime DateTime?
  checkInLat  Float? // Latitude check-in
  checkInLng  Float? // Longitude check-in
  checkInNote String?

  // Check Out
  checkOutTime DateTime?
  checkOutLat  Float? // Latitude check-out
  checkOutLng  Float? // Longitude check-out
  checkOutNote String?

  // Calculated
  workingHours Float? // Total working hours
  status       AttendanceStatus @default(ABSENT)

  // Manual correction
  isManual    Boolean   @default(false) // True if manually entered/corrected
  correctedBy String? // User ID who corrected
  correctedAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date]) // One attendance record per employee per day
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([employeeId, date])
  @@map("attendances")
}

// ============================================
// RADIUS TABLES (FreeRADIUS Integration)
// ============================================

// RadCheck - User authentication attributes
model RadCheck {
  id        Int    @id @default(autoincrement())
  username  String
  attribute String
  op        String @default("==") @db.VarChar(2)
  value     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
  @@index([username, attribute])
  @@map("radcheck")
}

// RadReply - Reply attributes sent after successful authentication
model RadReply {
  id        Int    @id @default(autoincrement())
  username  String
  attribute String
  op        String @default("=") @db.VarChar(2)
  value     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
  @@index([username, attribute])
  @@map("radreply")
}

// RadAcct - Accounting records (session tracking and usage data)
model RadAcct {
  radAcctId           BigInt    @id @default(autoincrement())
  acctSessionId       String
  acctUniqueId        String    @unique
  username            String?
  groupname           String?
  realm               String?
  nasIpAddress        String
  nasPortId           String?
  nasPortType         String?
  acctStartTime       DateTime?
  acctUpdateTime      DateTime?
  acctStopTime        DateTime?
  acctInterval        BigInt?
  acctSessionTime     BigInt?
  acctAuthentic       String?
  connectInfoStart    String?
  connectInfoStop     String?
  acctInputOctets     BigInt?
  acctOutputOctets    BigInt?
  calledStationId     String?
  callingStationId    String?
  acctTerminateCause  String?
  serviceType         String?
  framedProtocol      String?
  framedIpAddress     String?
  framedIpv6Address   String?
  framedIpv6Prefix    String?
  framedInterfaceId   String?
  delegatedIpv6Prefix String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
  @@index([acctSessionId])
  @@index([acctUniqueId])
  @@index([nasIpAddress])
  @@index([acctStartTime])
  @@index([acctStopTime])
  @@index([username, acctStartTime])
  @@map("radacct")
}

// RadGroupCheck - Group-based authentication policies
model RadGroupCheck {
  id        Int    @id @default(autoincrement())
  groupname String
  attribute String
  op        String @default("==") @db.VarChar(2)
  value     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupname])
  @@index([groupname, attribute])
  @@map("radgroupcheck")
}

// RadGroupReply - Group-based reply attributes
model RadGroupReply {
  id        Int    @id @default(autoincrement())
  groupname String
  attribute String
  op        String @default("=") @db.VarChar(2)
  value     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupname])
  @@index([groupname, attribute])
  @@map("radgroupreply")
}

// RadUserGroup - User to group mapping
model RadUserGroup {
  username  String
  groupname String
  priority  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([username, groupname])
  @@index([username])
  @@index([groupname])
  @@map("radusergroup")
}

// RadPostAuth - Post-authentication logging (optional)
model RadPostAuth {
  id        BigInt   @id @default(autoincrement())
  username  String
  pass      String
  reply     String
  authDate  DateTime @default(now())

  @@index([username])
  @@index([authDate])
  @@map("radpostauth")
}

// NAS - Network Access Server Configuration (MikroTik Routers)
model Nas {
  id          Int      @id @default(autoincrement())
  nasname     String   // IP address or hostname
  shortname   String?  // Short name for display
  type        String   @default("other") // NAS type (other, mikrotik, cisco, etc.)
  ports       Int?     // Number of ports
  secret      String   @default("secret") // RADIUS secret
  community   String?  // SNMP community
  description String?  // Description of the NAS

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nasname])
  @@map("nas")
}

// RADIUS IP Pool - IP Address Pool Management
model RadIpPool {
  id               Int      @id @default(autoincrement())
  poolName         String   @map("pool_name")
  framedIpAddress  String   @map("framedipaddress") @db.Inet
  nasIpAddress     String?  @map("nasipaddress") @db.Inet
  poolKey          String?  @map("pool_key")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([framedIpAddress])
  @@index([poolName])
  @@index([nasIpAddress])
  @@map("radippool")
}

// Leave Balance - Saldo cuti karyawan
model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  year          Int // Tahun
  leaveType     LeaveType
  totalDays     Int // Total days allocated
  usedDays      Int       @default(0) // Days used
  remainingDays Int // Days remaining

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, leaveType])
  @@index([employeeId])
  @@index([year])
  @@map("leave_balances")
}

// Leave Request - Pengajuan cuti/izin
model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  totalDays Int // Number of days requested
  reason    String

  status          LeaveStatus @default(PENDING)
  approvedBy      String? // User ID who approved/rejected
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([employeeId, status])
  @@map("leave_requests")
}

// Overtime - Record lembur
model Overtime {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date        DateTime
  startTime   DateTime
  endTime     DateTime
  hours       Float // Total overtime hours
  description String?

  isApproved Boolean   @default(false)
  approvedBy String? // User ID who approved
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
  @@index([isApproved])
  @@map("overtimes")
}

// Salary Component - Master komponen gaji
model SalaryComponent {
  id          String              @id @default(cuid())
  code        String              @unique // e.g., "BASIC", "TRANSPORT", "MEAL"
  name        String // e.g., "Gaji Pokok", "Tunjangan Transport"
  type        SalaryComponentType
  description String?
  isActive    Boolean             @default(true)
  isTaxable   Boolean             @default(true) // Kena pajak atau tidak

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeSalaries EmployeeSalary[]

  @@index([type])
  @@index([isActive])
  @@map("salary_components")
}

// Employee Salary - Salary structure per karyawan
model EmployeeSalary {
  id                String          @id @default(cuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryComponentId String
  salaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  amount        BigInt // Amount in rupiah
  effectiveDate DateTime // When this salary becomes effective
  endDate       DateTime? // When this salary ends (null if current)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([salaryComponentId])
  @@index([effectiveDate])
  @@map("employee_salaries")
}

// Payroll - Proses penggajian bulanan
model Payroll {
  id          String   @id @default(cuid())
  month       Int // 1-12
  year        Int
  periodStart DateTime // Start of pay period
  periodEnd   DateTime // End of pay period

  totalGross     BigInt @default(0) // Total gross salary
  totalDeduction BigInt @default(0) // Total deductions
  totalNet       BigInt @default(0) // Total net salary (gross - deduction)
  totalEmployees Int    @default(0) // Number of employees

  status      PayrollStatus @default(DRAFT)
  processedAt DateTime? // When payroll was calculated
  approvedBy  String? // User ID who approved
  approvedAt  DateTime?
  paidAt      DateTime? // When marked as paid
  paidBy      String? // User ID who marked as paid

  // Link to Finance (Pengeluaran)
  pengeluaranId String? @unique // Auto-created Pengeluaran when marked as paid

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  payrollDetails PayrollDetail[]

  @@unique([month, year])
  @@index([month, year])
  @@index([status])
  @@map("payrolls")
}

// Payroll Detail - Detail payroll per karyawan
model PayrollDetail {
  id         String   @id @default(cuid())
  payrollId  String
  payroll    Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Salary breakdown
  basicSalary BigInt @default(0)
  allowances  BigInt @default(0) // Total allowances
  bonuses     BigInt @default(0) // Total bonuses
  grossSalary BigInt // Basic + allowances + bonuses

  // Deductions
  deductions     BigInt @default(0) // Other deductions
  tax            BigInt @default(0) // Income tax (PPh 21)
  insurance      BigInt @default(0) // Insurance
  totalDeduction BigInt // Sum of all deductions

  netSalary BigInt // Gross - deductions

  // Overtime
  overtimeHours Float  @default(0)
  overtimePay   BigInt @default(0)

  // Attendance impact
  daysWorked Int @default(0)
  daysAbsent Int @default(0)
  lateCount  Int @default(0)

  // Component breakdown (JSON)
  componentBreakdown Json? // Detailed breakdown of all components

  notes     String?
  createdAt DateTime @default(now())

  @@unique([payrollId, employeeId])
  @@index([payrollId])
  @@index([employeeId])
  @@map("payroll_details")
}

// Performance Review - Penilaian kinerja
model PerformanceReview {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reviewPeriod String // e.g., "Q1 2024", "2024"
  reviewDate   DateTime
  reviewerId   String? // User/Employee ID of reviewer

  // Scores (1-5 scale typically)
  scoreQuality      Float? // Quality of work
  scoreProductivity Float? // Productivity
  scoreAttendance   Float? // Attendance/punctuality
  scoreTeamwork     Float? // Teamwork
  scoreInitiative   Float? // Initiative
  overallScore      Float? // Overall score

  strengths  String? // Text feedback on strengths
  weaknesses String? // Text feedback on areas for improvement
  goals      String? // Goals for next period
  comments   String? // Additional comments

  status String @default("DRAFT") // DRAFT, COMPLETED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([reviewDate])
  @@map("performance_reviews")
}

// Performance Goal - Target/KPI karyawan
model PerformanceGoal {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title       String
  description String
  targetValue Float? // Target numeric value (if applicable)
  actualValue Float? // Actual achieved value
  unit        String? // Unit of measurement

  startDate   DateTime
  endDate     DateTime
  status      String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  achievement Float? // Percentage achieved (0-100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([endDate])
  @@map("performance_goals")
}

// Training - Program pelatihan
model Training {
  id          String  @id @default(cuid())
  title       String
  description String?
  trainer     String? // Trainer name
  location    String? // Training location or "ONLINE"

  startDate       DateTime
  endDate         DateTime
  duration        Int? // Duration in hours
  maxParticipants Int? // Maximum participants

  cost BigInt? // Cost per participant (optional)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  enrollments TrainingEnrollment[]

  @@index([startDate])
  @@index([isActive])
  @@map("trainings")
}

// Training Enrollment - Pendaftaran training
model TrainingEnrollment {
  id         String   @id @default(cuid())
  trainingId String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  status      String  @default("REGISTERED") // REGISTERED, COMPLETED, CANCELLED
  attended    Boolean @default(false)
  score       Float? // Score/grade if applicable
  certificate String? // Path to certificate (if issued)
  feedback    String? // Employee feedback

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([trainingId, employeeId])
  @@index([trainingId])
  @@index([employeeId])
  @@index([status])
  @@map("training_enrollments")
}

// Skill - Master skill/kompetensi
model Skill {
  id          String  @id @default(cuid())
  name        String  @unique
  category    String? // e.g., "Technical", "Soft Skill", "Language"
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeSkills EmployeeSkill[]

  @@index([category])
  @@index([isActive])
  @@map("skills")
}

// Employee Skill - Skill yang dimiliki karyawan
model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  level      String    @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  yearsOfExp Int? // Years of experience
  lastUsed   DateTime? // Last time skill was used
  certified  Boolean   @default(false) // Has certification
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, skillId])
  @@index([employeeId])
  @@index([skillId])
  @@map("employee_skills")
}

// Job Posting - Lowongan pekerjaan
model JobPosting {
  id           String  @id @default(cuid())
  title        String
  departmentId String?
  positionId   String?

  description      String // Job description
  requirements     String // Requirements
  responsibilities String // Responsibilities

  employmentType String // "FULL_TIME", "PART_TIME", "CONTRACT", "INTERNSHIP"
  location       String?
  salaryMin      BigInt? // Minimum salary range
  salaryMax      BigInt? // Maximum salary range

  openings Int @default(1) // Number of positions

  publishDate DateTime  @default(now())
  closeDate   DateTime?
  isActive    Boolean   @default(true)
  isPublic    Boolean   @default(false) // Public job posting or internal only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  applications JobApplication[]

  @@index([isActive])
  @@index([publishDate])
  @@map("job_postings")
}

// Job Application - Lamaran pekerjaan
model JobApplication {
  id           String     @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  // Applicant info
  fullName    String
  email       String
  phone       String
  resumeUrl   String? // Path to uploaded resume
  coverLetter String?

  // Application status
  status       ApplicationStatus @default(APPLIED)
  currentStage String? // Current stage in pipeline

  // Scores/ratings
  screeningScore Float?
  interviewScore Float?
  finalScore     Float?

  notes String? // Internal notes

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]

  @@index([jobPostingId])
  @@index([status])
  @@index([email])
  @@map("job_applications")
}

// Interview - Jadwal wawancara
model Interview {
  id               String         @id @default(cuid())
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  interviewType String // "PHONE", "VIDEO", "IN_PERSON", "TECHNICAL"
  scheduledDate DateTime
  duration      Int? // Duration in minutes
  location      String? // Location or meeting link

  interviewerIds String? // JSON array of User IDs
  interviewers   String? // Names of interviewers

  status         String  @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  score          Float? // Interview score
  feedback       String? // Interview feedback
  recommendation String? // Hire/No hire recommendation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobApplicationId])
  @@index([scheduledDate])
  @@index([status])
  @@map("interviews")
}

// ============================================
// HELPDESK SYSTEM MODELS
// ============================================

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN // Baru dibuat, belum ditangani
  IN_PROGRESS // Sedang ditangani
  WAITING_CUSTOMER // Menunggu response dari customer
  RESOLVED // Sudah diselesaikan
  CLOSED // Ditutup (final)
}

// Ticket Category - Kategori untuk ticket helpdesk
model TicketCategory {
  id           String  @id @default(cuid())
  name         String  @unique // e.g., "Koneksi Terputus", "Billing", "Permintaan Upgrade"
  description  String?
  color        String? @default("#3b82f6") // Hex color untuk UI
  icon         String? // Icon name (optional)
  displayOrder Int     @default(0) // Untuk sorting di UI
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("ticket_categories")
}

// Ticket - Main ticket model
model Ticket {
  id           String @id @default(cuid())
  ticketNumber String @unique // Format: TIK-YYYYMMDD-XXXX

  // Customer Info
  pelangganId String
  pelanggan   Pelanggan @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  userId      String? // User ID yang terkait (optional)

  // Ticket Details
  categoryId  String?
  category    TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subject     String
  description String          @db.Text

  // Status & Priority
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  // Assignment
  assignedToId String? // User ID (staff yang handle)
  assignedAt   DateTime?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  firstResponseAt DateTime? // First staff response time
  resolvedAt      DateTime? // When marked as resolved
  closedAt        DateTime? // When closed

  // Customer feedback
  rating   Int? // 1-5 rating (after resolved)
  feedback String? // Customer feedback text

  // Metadata
  lastActivityAt DateTime @default(now()) // Last message/update time
  tags           String? // JSON array of tags (optional)

  // Relations
  messages    TicketMessage[]
  attachments TicketAttachment[]
  workOrders  WorkOrder[]       // Link to work orders created from this ticket
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pelangganId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([ticketNumber])
  @@index([pelangganId, status]) // Common query
  @@map("tickets")
}

// Ticket Message - Messages/replies dalam ticket
model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Message Details
  message    String  @db.Text
  isInternal Boolean @default(false) // Internal note (hanya staff yang lihat)

  // Sender Info
  senderType String // "CUSTOMER" or "STAFF"
  senderId   String? // User ID (jika staff), null jika customer
  senderName String // Nama pengirim untuk display

  // Metadata
  isFirstResponse Boolean  @default(false) // First staff response marker
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([createdAt])
  @@index([senderType])
  @@map("ticket_messages")
}

// Ticket Attachment - File attachments
model TicketAttachment {
  id String @id @default(cuid())

  // Relations (attachment bisa untuk ticket atau message)
  ticketId  String?
  ticket    Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId String?
  message   TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // File Details
  fileName String // Original filename
  filePath String // Stored file path
  fileSize Int // Size in bytes
  fileType String // MIME type

  // Uploader Info
  uploadedBy String? // User ID or customer ID
  uploadedAt DateTime @default(now())

  @@index([ticketId])
  @@index([messageId])
  @@index([uploadedAt])
  @@map("ticket_attachments")
}

