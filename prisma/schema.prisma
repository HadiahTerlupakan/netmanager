generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model ARAgingSnapshot {
  id               String   @id
  snapshotDate     DateTime @default(now())
  current          BigInt   @default(0)
  overdue30        BigInt   @default(0)
  overdue60        BigInt   @default(0)
  overdue90        BigInt   @default(0)
  totalOutstanding BigInt   @default(0)
  totalCustomers   Int      @default(0)
  createdAt        DateTime @default(now())
  tenantId         String?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([snapshotDate])
  @@index([tenantId])
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Announcement {
  id        String             @id
  title     String
  content   String
  target    TargetAudience     @default(ALL)
  isActive  Boolean            @default(true)
  isPinned  Boolean            @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime
  createdBy String?
  tenantId  String?
  user      User?              @relation(fields: [createdBy], references: [id])
  tenant    Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reads     AnnouncementRead[]

  @@index([isActive])
  @@index([target])
  @@index([tenantId])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  userId         String?
  pelangganId    String?
  portal         String
  readAt         DateTime     @default(now())
  tenantId       String?
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([announcementId, userId])
  @@unique([announcementId, pelangganId])
  @@index([announcementId])
  @@index([userId])
  @@index([pelangganId])
  @@index([tenantId])
}

model Attendance {
  id                                String           @id
  userId                            String
  checkIn                           DateTime         @default(now())
  checkInDate                       DateTime?
  checkOut                          DateTime?
  checkInPhoto                      String?
  checkOutPhoto                     String?
  status                            AttendanceStatus @default(ON_TIME)
  notes                             String?
  location                          String?
  checkOutLocation                  String?
  createdAt                         DateTime         @default(now())
  updatedAt                         DateTime
  geofenceStatus                    String?
  geofenceDistance                  Float?
  geofenceSiteName                  String?
  checkOutGeofenceStatus            String?
  checkOutGeofenceDistance          Float?
  geofenceMeta                      Json?
  tenantId                          String?
  correctedAt                       DateTime?
  correctedById                     String?
  correctionReason                  String?
  correctionNotes                   String?
  correctionEvidencePhotoUrl        String?
  correctionReplacementAttendanceId String?
  correctionSourceAttendanceId      String?
  correctionSource                  String?
  tenant                            Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                              User             @relation(fields: [userId], references: [id])
  correctedBy                       User?            @relation("AttendanceCorrectedBy", fields: [correctedById], references: [id])
  correctionReplacementAttendance   Attendance?      @relation("AttendanceCorrectionReplacement", fields: [correctionReplacementAttendanceId], references: [id])
  correctionReplacementSources      Attendance[]     @relation("AttendanceCorrectionReplacement")
  correctionSourceAttendance        Attendance?      @relation("AttendanceCorrectionSource", fields: [correctionSourceAttendanceId], references: [id])
  correctionSourceReplacements      Attendance[]     @relation("AttendanceCorrectionSource")
  overtime                          Overtime[]

  @@unique([userId, checkInDate, tenantId], map: "idx_attendance_user_checkin_date_tenant")
  @@unique([correctionReplacementAttendanceId])
  @@unique([correctionSourceAttendanceId])
  @@index([checkIn])
  @@index([status])
  @@index([userId])
  @@index([userId, checkIn])
  @@index([userId, checkIn(sort: Desc)], map: "idx_attendance_user_checkin")
  @@index([userId, checkOut(sort: Desc)], map: "idx_attendance_user_checkout")
  @@index([tenantId])
  @@index([tenantId, correctedAt])
  @@index([correctionReplacementAttendanceId])
  @@index([correctionSourceAttendanceId])
}

model AttendanceEvaluation {
  id                      String                      @id @default(cuid())
  tenantId                String
  userId                  String
  workDate                DateTime
  finalStatus             AttendanceStatus
  reviewState             String
  rawPresenceState        String?
  workMinutes             Int                         @default(0)
  lateMinutes             Int                         @default(0)
  overtimeMinutesApproved Int                         @default(0)
  overtimeMinutesHeld     Int                         @default(0)
  payrollHoldState        String                      @default("NONE")
  holidayState            String?
  leaveState              String?
  scheduleState           String?
  evidenceQuality         String?
  reasonCodes             Json                        @default("[]")
  anomalyCodes            Json                        @default("[]")
  sourceRefs              Json                        @default("{}")
  evaluationVersion       Int                         @default(1)
  evaluatedAt             DateTime                    @default(now())
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  audits                  AttendanceEvaluationAudit[]
  tenant                  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, workDate])
  @@index([tenantId, workDate])
  @@index([tenantId, reviewState])
  @@index([userId, evaluatedAt(sort: Desc)], map: "idx_eval_user_date")
}

model AttendanceEvaluationAudit {
  id                String                @id @default(cuid())
  evaluationId      String?
  tenantId          String
  userId            String
  workDate          DateTime
  action            String
  previousSnapshot  Json?
  nextSnapshot      Json?
  reason            String
  actorType         String
  actorId           String?
  evaluationVersion Int
  createdAt         DateTime              @default(now())
  evaluation        AttendanceEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, workDate])
  @@index([evaluationId])
}

model EmployeeLocation {
  id           String   @id @default(uuid())
  userId       String
  latitude     Float
  longitude    Float
  accuracy     Float?
  altitude     Float?
  speed        Float?
  heading      Float?
  batteryLevel Float?
  isMoving     Boolean  @default(false)
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
  @@index([userId, recordedAt])
  @@index([tenantId])
  @@map("employee_locations")
}

model Bandwidth {
  id                     String       @id
  name                   String
  maxLimitDownload       String
  maxLimitUpload         String
  burstLimitDownload     String?
  burstLimitUpload       String?
  minLimitDownload       String?
  minLimitUpload         String?
  burstThresholdDownload String?
  burstThresholdUpload   String?
  burstTimeDownload      Int?
  burstTimeUpload        Int?
  priority               Int?
  uploadSpeed            Int?
  downloadSpeed          Int?
  description            String?
  status                 Status       @default(AKTIF)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime
  siteId                 String?
  tenantId               String?
  site                   Sites?       @relation(fields: [siteId], references: [id])
  tenant                 Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hargaPaket             HargaPaket[]

  @@unique([name, tenantId], name: "name_tenantId")
  @@index([siteId])
  @@index([tenantId])
}

model Coupon {
  id             String        @id
  code           String
  description    String?
  discountType   DiscountType
  discountValue  Float
  startDate      DateTime
  endDate        DateTime
  minTransaction Int           @default(0)
  maxDiscount    Int?
  quota          Int           @default(0)
  usedCount      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  couponUsage    CouponUsage[]

  @@unique([tenantId, code], name: "tenantId_code")
  @@index([tenantId])
}

model CouponUsage {
  id          String     @id
  couponId    String
  userId      String?
  pelangganId String?
  usedAt      DateTime   @default(now())
  tenantId    String?
  coupon      Coupon     @relation(fields: [couponId], references: [id])
  pelanggan   Pelanggan? @relation(fields: [pelangganId], references: [id])
  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@index([pelangganId])
  @@index([tenantId])
}

model CustomerCohort {
  id               String   @id
  cohortMonth      Int
  cohortYear       Int
  initialCustomers Int
  month0Revenue    BigInt   @default(0)
  month1Revenue    BigInt   @default(0)
  month2Revenue    BigInt   @default(0)
  month3Revenue    BigInt   @default(0)
  month6Revenue    BigInt   @default(0)
  month12Revenue   BigInt   @default(0)
  activeMonth0     Int      @default(0)
  activeMonth1     Int      @default(0)
  activeMonth3     Int      @default(0)
  activeMonth6     Int      @default(0)
  activeMonth12    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  tenantId         String?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([cohortYear, cohortMonth])
  @@index([cohortYear, cohortMonth])
  @@index([tenantId])
}

model ExpenseCategory {
  id        String            @id @default(cuid())
  name      String
  type      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  parentId  String?
  tenantId  String?
  coaId     String?
  expenses  Expense[]
  parent    ExpenseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ExpenseCategory[] @relation("CategoryHierarchy")
  tenant    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rabItems  RabItem[]

  @@unique([tenantId, name], name: "tenantId_name")
  @@index([type])
  @@index([parentId])
  @@index([tenantId])
}

model Expense {
  id                String            @id @default(uuid())
  date              DateTime          @default(now())
  amount            BigInt
  category          String
  description       String?
  userId            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  siteId            String?
  depreciation      BigInt?           @default(0)
  expenseCategoryId String?
  mixRadiusGroupId  String?
  usefulLife        Int?              @default(0)
  accountId         String?
  categoryId        String?
  rabItemId         String?
  rabProjectId      String?
  invoiceFile       String?
  invoiceNumber     String?
  fakturPajakNo     String?
  fakturPajakDate   DateTime?
  vendorNpwp        String?
  tenantId          String?
  financialAccount  FinancialAccount? @relation(fields: [accountId], references: [id])
  expenseCategory   ExpenseCategory?  @relation(fields: [expenseCategoryId], references: [id])
  rabItem           RabItem?          @relation(fields: [rabItemId], references: [id])
  rabProject        RabProject?       @relation(fields: [rabProjectId], references: [id])
  site              Sites?            @relation(fields: [siteId], references: [id])
  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User?             @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([date])
  @@index([userId])
  @@index([siteId])
  @@index([mixRadiusGroupId])
  @@index([rabProjectId])
  @@index([rabItemId])
  @@index([tenantId])
}

model HargaPaket {
  id                     String                   @id
  name                   String
  bandwidthId            String?
  profilePPPId           String
  harga                  Int
  durasi                 Int                      @default(30)
  durasiUnit             DurasiUnit               @default(HARI)
  usePPN                 Boolean                  @default(false)
  ppnPercentage          Float?
  useDiscount            Boolean                  @default(false)
  discountType           DiscountType?
  discountValue          Float?
  discountDuration       Int?
  discountDurationUnit   DurasiUnit?
  description            String?
  featured               Boolean                  @default(false)
  status                 Status                   @default(AKTIF)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  siteId                 String?
  tenantId               String?
  bandwidth              Bandwidth?               @relation(fields: [bandwidthId], references: [id])
  profilePPP             ProfilePPP               @relation(fields: [profilePPPId], references: [id])
  site                   Sites?                   @relation(fields: [siteId], references: [id])
  tenant                 Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pelanggan              Pelanggan[]
  pelangganPending       Pelanggan[]              @relation("PelangganPendingPackage")
  resellerPackagePrice   ResellerPackagePrice[]
  resellerCommissionRule ResellerCommissionRule[]

  @@unique([tenantId, name, siteId], name: "tenantId_name_siteId")
  @@index([bandwidthId])
  @@index([featured])
  @@index([profilePPPId])
  @@index([siteId])
  @@index([status])
  @@index([tenantId])
}

model Investor {
  id           String                @id @default(uuid())
  username     String                @unique
  passwordHash String?
  namaLengkap  String
  perusahaan   String?
  noTelp       String?
  email        String?               @unique
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tenantId     String?
  tenant       Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payouts      InvestorPayout[]
  rabProjects  RabInvestor[]
  deposits     InvestorDeposit[]
  profitShares InvestorProfitShare[]
  config       InvestorConfig?

  @@index([tenantId])
}

model InvestorPayout {
  id            String   @id @default(uuid())
  investorId    String
  amount        BigInt
  date          DateTime @default(now())
  bankName      String?
  accountNumber String?
  accountName   String?
  reference     String?
  notes         String?
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String?
  investor      Investor @relation(fields: [investorId], references: [id])
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([investorId])
  @@index([date])
  @@index([tenantId])
}

model RabInvestor {
  id                 String     @id @default(uuid())
  rabProjectId       String
  investorId         String
  investmentAmount   BigInt     @default(0)
  profitSharePercent Float      @default(0)
  tenantId           String?
  investor           Investor   @relation(fields: [investorId], references: [id])
  rabProject         RabProject @relation(fields: [rabProjectId], references: [id])
  tenant             Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([rabProjectId, investorId])
  @@index([tenantId])
}

model Holiday {
  id          String   @id
  date        DateTime
  description String
  isNational  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([date, tenantId])
  @@index([tenantId])
}

model Joinbox {
  id                          String          @id
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status          @default(AKTIF)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime
  keteranganJumlahKabelFeeder String?
  images                      String[]        @default([])
  siteId                      String?
  tenantId                    String?
  site                        Sites?          @relation(fields: [siteId], references: [id])
  tenant                      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  joinboxInput                JoinboxInput[]
  joinboxOutput               JoinboxOutput[]

  @@index([siteId])
  @@index([tenantId])
}

model JoinboxInput {
  id        String  @id
  joinboxId String
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String
  tenantId  String?
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id])
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([joinboxId, idx])
  @@index([tenantId])
}

model JoinboxOutput {
  id        String  @id
  joinboxId String
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String
  tenantId  String?
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id])
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([joinboxId, idx])
  @@index([tenantId])
}

model KmzFile {
  id          String   @id
  name        String
  filename    String
  filePath    String
  fileSize    Int
  description String?
  lineColor   String   @default("#3388ff")
  isActive    Boolean  @default(true)
  status      Status   @default(AKTIF)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  kmlPath     String
  siteId      String?
  tenantId    String?
  site        Sites?   @relation(fields: [siteId], references: [id])
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([siteId])
  @@index([tenantId])
}

model LeaveRequest {
  id              String      @id
  userId          String
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  reason          String
  attachmentUrl   String?
  attachments     String[]    @default([])
  status          LeaveStatus @default(PENDING)
  approvedBy      String?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  replacementDate DateTime?
  tenantId        String?

  // Timeline tracking fields
  submittedAt          DateTime  @default(now())
  firstReminderSentAt  DateTime?
  secondReminderSentAt DateTime?
  finalReminderSentAt  DateTime?
  autoRejectedAt       DateTime?
  autoRejectionReason  String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User    @relation(fields: [userId], references: [id])

  @@index([startDate])
  @@index([status])
  @@index([userId])
  @@index([startDate, endDate], map: "idx_leave_dates")
  @@index([tenantId])
  @@index([userId, tenantId, createdAt(sort: Desc)], map: "idx_leave_user_tenant_date")
}

model LeaveBalance {
  id        String    @id
  userId    String
  year      Int
  leaveType LeaveType
  quota     Int
  used      Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, year, leaveType])
  @@index([userId])
  @@index([year])
  @@index([tenantId])
}

model MRRMovement {
  id           String   @id
  month        Int
  year         Int
  movementType String
  pelangganId  String?
  amount       BigInt
  description  String?
  createdAt    DateTime @default(now())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([movementType])
  @@index([pelangganId])
  @@index([year, month])
  @@index([tenantId])
}

model MikroTikRouter {
  id                     String                  @id
  name                   String
  ipAddress              String
  timezone               String                  @default("+07:00 Asia/Jakarta")
  apiPort                Int                     @default(8728)
  apiUsername            String
  apiPassword            String
  authPort               Int                     @default(7265)
  accountingPort         Int                     @default(7266)
  secretRadius           String
  isolirUrl              String?
  description            String?
  pingStatus             String                  @default("offline")
  userOnline             Int                     @default(0)
  lastStatusCheck        DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  apiPasswordGenerated   String?
  apiUsernameGenerated   String?
  siteId                 String?
  tenantId               String?
  site                   Sites?                  @relation(fields: [siteId], references: [id])
  tenant                 Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profilePPP             ProfilePPP[]
  configuration_restores ConfigurationRestores[]
  network_alerts         NetworkAlerts[]
  network_performance    NetworkPerformance[]

  @@unique([tenantId, ipAddress])
  @@index([pingStatus])
  @@index([siteId])
  @@index([tenantId])
}

model AccelPppServer {
  id          String  @id @default(cuid())
  name        String
  ipAddress   String
  description String?

  nasIdentifier String?
  radiusSecret  String
  authPort      Int     @default(1812)
  acctPort      Int     @default(1813)
  coaPort       Int     @default(3799)

  cliHost     String
  cliPort     Int     @default(2001)
  cliPassword String?

  sshHost             String?
  sshPort             Int       @default(22)
  sshUser             String?
  sshPassword         String?
  sshPrivateKey       String?
  lastProvisionAt     DateTime?
  lastProvisionStatus String?

  pingStatus      String    @default("offline")
  userOnline      Int       @default(0)
  lastStatusCheck DateTime?

  siteId   String?
  tenantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site   Sites?  @relation(fields: [siteId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, ipAddress])
  @@index([pingStatus])
  @@index([siteId])
  @@index([tenantId])
}

model Odc {
  id                          String      @id
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status      @default(AKTIF)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime
  otbCoreId                   String?     @unique
  keteranganJumlahKabelFeeder String?
  siteId                      String?
  images                      String[]    @default([])
  attenuationIn               Float?
  attenuationOut              Float?
  inputCoreColor              String?
  tenantId                    String?
  otbCore                     OtbCore?    @relation(fields: [otbCoreId], references: [id])
  site                        Sites?      @relation(fields: [siteId], references: [id])
  tenant                      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  odcOutput                   OdcOutput[]

  @@index([siteId])
  @@index([tenantId])
}

model OdcOutput {
  id        String  @id
  odcId     String
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String
  tenantId  String?
  odc       Odc     @relation(fields: [odcId], references: [id])
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  odp       Odp?

  @@unique([odcId, idx])
  @@index([tenantId])
}

model Odp {
  id                          String      @id
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status      @default(AKTIF)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime
  odcOutputId                 String?     @unique
  keteranganJumlahKabelFeeder String?
  siteId                      String?
  images                      String[]    @default([])
  attenuationIn               Float?
  attenuationOut              Float?
  inputCoreColor              String?
  tenantId                    String?
