  @@index([wbsId])
  @@index([tenantId])
  @@map("rab_items")
}

model RabWbs {
  id           String     @id @default(cuid())
  rabProjectId String
  name         String
  order        Int        @default(0)
  tenantId     String?
  items        RabItem[]
  rabProject   RabProject @relation(fields: [rabProjectId], references: [id], onDelete: Cascade)
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([rabProjectId])
  @@index([tenantId])
  @@map("rab_wbs")
}

model RabDisbursement {
  id            String    @id @default(cuid())
  rabItemId     String
  name          String
  percentage    Float
  amount        BigInt
  estimatedDate DateTime?
  isPaid        Boolean   @default(false)
