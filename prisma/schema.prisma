model Shift {
  id          String   @id @default(uuid())
  name        String // "Pagi", "Siang", "Malam"
  code        String?  @unique // "S1", "S2", "S3"
  startTime   String // "06:00"
  endTime     String // "14:00"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([isActive])
}

model Canvasing {
  id          String          @id @default(uuid())
  nama        String
  noKtp       String
  noTelpon    String
  email       String?
  alamat      String
  kabel       Int
  odp         String?
  paket       String
  sn          String?
  latitude    Float?
  longitude   Float?
  foto        String?
  fotoKtp     String?
  status      CanvasingStatus @default(PENDING)
  salesId     String
  sales       User            @relation("SalesCanvasing", fields: [salesId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  approvedBy  String?
  approvedAt  DateTime?
  approver    User?           @relation("ApproverCanvasing", fields: [approvedBy], references: [id])
  workOrderId String?
  workOrder   WorkOrders?     @relation(fields: [workOrderId], references: [id])
  // Point Claim System
  isLocked    Boolean         @default(false) // Readonly setelah claim disubmit
  pointClaims PointClaim[]

  @@index([salesId])
  @@index([status])
  @@map("canvasing")
}

enum CanvasingStatus {
  PENDING
  APPROVED
  REJECTED
}

// Point Claim untuk Canvasing
// Poin bertingkat: WO In Progress=5, WO Completed=+3, Claim Approved=+2 (Total Max=10)
model PointClaim {
  id          String    @id @default(uuid())
  canvasingId String
  canvasing   Canvasing @relation(fields: [canvasingId], references: [id], onDelete: Cascade)
  salesId     String
  sales       User      @relation("SalesPointClaim", fields: [salesId], references: [id])

  // Bukti Upload
  buktiUrls     String[] // Multiple foto bukti
  buktiMetadata Json? // Metadata foto (size, type, etc)
  keterangan    String? // Catatan dari sales

  // Poin
  pointValue Int @default(2) // Poin claim = 2 (total jadi 10)

  // Status & Approval
  status       PointClaimStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?            @relation("ReviewerPointClaim", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([canvasingId]) // Satu canvasing hanya bisa punya satu claim
  @@index([canvasingId])
  @@index([salesId])
  @@index([status])
  @@map("point_claims")
}

enum PointClaimStatus {
  PENDING
  APPROVED
  REJECTED
}
