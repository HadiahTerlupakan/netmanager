generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model ARAgingSnapshot {
  id               String   @id
  snapshotDate     DateTime @default(now())
  current          BigInt   @default(0)
  overdue30        BigInt   @default(0)
  overdue60        BigInt   @default(0)
  overdue90        BigInt   @default(0)
  totalOutstanding BigInt   @default(0)
  totalCustomers   Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([snapshotDate])
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Announcement {
  id        String             @id
  title     String
  content   String
  target    TargetAudience     @default(ALL)
  isActive  Boolean            @default(true)
  isPinned  Boolean            @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime
  createdBy String?
  user      User?              @relation(fields: [createdBy], references: [id])
  reads     AnnouncementRead[]

  @@index([isActive])
  @@index([target])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  userId         String?
  pelangganId    String?
  portal         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@unique([announcementId, pelangganId])
  @@index([announcementId])
  @@index([userId])
  @@index([pelangganId])
}

model Attendance {
  id                       String           @id
  userId                   String
  checkIn                  DateTime         @default(now())
  checkOut                 DateTime?
  checkInPhoto             String?
  checkOutPhoto            String?
  status                   AttendanceStatus @default(ON_TIME)
  notes                    String?
  location                 String?
  checkOutLocation         String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime
  geofenceStatus           String?
  geofenceDistance         Float?
  geofenceSiteName         String?
  checkOutGeofenceStatus   String?
  checkOutGeofenceDistance Float?
  geofenceMeta             Json?
  user                     User             @relation(fields: [userId], references: [id])
  overtime                 Overtime[]

  @@index([checkIn])
  @@index([status])
  @@index([userId])
  @@index([userId, checkIn])
  @@index([userId, checkIn(sort: Desc)], map: "idx_attendance_user_checkin")
  @@index([userId, checkOut(sort: Desc)], map: "idx_attendance_user_checkout")
}

model EmployeeLocation {
  id           String   @id @default(uuid())
  userId       String
  latitude     Float
  longitude    Float
  accuracy     Float?
  altitude     Float?
  speed        Float?
  heading      Float?
  batteryLevel Float?
  isMoving     Boolean  @default(false)
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
  @@index([userId, recordedAt])
  @@map("employee_locations")
}

model Bandwidth {
  id                     String       @id
  name                   String       @unique
  maxLimitDownload       String
  maxLimitUpload         String
  burstLimitDownload     String?
  burstLimitUpload       String?
  minLimitDownload       String?
  minLimitUpload         String?
  burstThresholdDownload String?
  burstThresholdUpload   String?
  burstTimeDownload      Int?
  burstTimeUpload        Int?
  priority               Int?
  uploadSpeed            Int?
  downloadSpeed          Int?
  description            String?
  status                 Status       @default(AKTIF)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime
  siteId                 String?
  site                   Sites?       @relation(fields: [siteId], references: [id])
  hargaPaket             HargaPaket[]

  @@index([siteId])
}

model Coupon {
  id             String        @id
  code           String        @unique
  description    String?
  discountType   DiscountType
  discountValue  Float
  startDate      DateTime
  endDate        DateTime
  minTransaction Int           @default(0)
  maxDiscount    Int?
  quota          Int           @default(0)
  usedCount      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  couponUsage    CouponUsage[]
}

model CouponUsage {
  id          String     @id
  couponId    String
  userId      String?
  pelangganId String?
  usedAt      DateTime   @default(now())
  coupon      Coupon     @relation(fields: [couponId], references: [id])
  pelanggan   Pelanggan? @relation(fields: [pelangganId], references: [id])

  @@index([couponId])
  @@index([pelangganId])
}

model CustomerCohort {
  id               String   @id
  cohortMonth      Int
  cohortYear       Int
  initialCustomers Int
  month0Revenue    BigInt   @default(0)
  month1Revenue    BigInt   @default(0)
  month2Revenue    BigInt   @default(0)
  month3Revenue    BigInt   @default(0)
  month6Revenue    BigInt   @default(0)
  month12Revenue   BigInt   @default(0)
  activeMonth0     Int      @default(0)
  activeMonth1     Int      @default(0)
  activeMonth3     Int      @default(0)
  activeMonth6     Int      @default(0)
  activeMonth12    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@unique([cohortYear, cohortMonth])
  @@index([cohortYear, cohortMonth])
}

model ExpenseCategory {
  id        String            @id @default(cuid())
  name      String
  type      String // "CAPEX" or "OPEX"
  parentId  String?
  parent    ExpenseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ExpenseCategory[] @relation("CategoryHierarchy")
  expenses  Expense[]
  rabItems  RabItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([type])
  @@index([parentId])
}

model Expense {
  id                String           @id
  date              DateTime         @default(now())
  amount            BigInt
  depreciation      BigInt?          @default(0)
  usefulLife        Int?             @default(0)
  category          String
  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id])

  categoryId       String?
  accountId        String?
  financialAccount FinancialAccount? @relation(fields: [accountId], references: [id])

  description      String?
  userId           String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime
  siteId           String?
  mixRadiusGroupId String?
  site             Sites?               @relation(fields: [siteId], references: [id])
  mixRadiusGroup   MixRadiusOwnerGroup? @relation(fields: [mixRadiusGroupId], references: [id])
  user             User?                @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([date])
  @@index([userId])
  @@index([siteId])
  @@index([mixRadiusGroupId])
}

model HargaPaket {
  id                   String        @id
  name                 String
  bandwidthId          String?
  profilePPPId         String
  siteId               String?
  harga                Int
  durasi               Int           @default(30)
  durasiUnit           DurasiUnit    @default(HARI)
  usePPN               Boolean       @default(false)
  ppnPercentage        Float?
  useDiscount          Boolean       @default(false)
  discountType         DiscountType?
  discountValue        Float?
  discountDuration     Int?
  discountDurationUnit DurasiUnit?
  description          String?
  featured             Boolean       @default(false)
  status               Status        @default(AKTIF)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  bandwidth            Bandwidth?    @relation(fields: [bandwidthId], references: [id])
  profilePPP           ProfilePPP    @relation(fields: [profilePPPId], references: [id])
  site                 Sites?        @relation(fields: [siteId], references: [id])
  pelanggan            Pelanggan[]

  @@unique([name, siteId])
  @@index([bandwidthId])
  @@index([featured])
  @@index([profilePPPId])
  @@index([siteId])
  @@index([status])
}

model Investor {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  passwordHash String?
  namaLengkap  String
  perusahaan   String?
  noTelp       String?
  email        String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rabProjects RabInvestor[]
}

model RabInvestor {
  id                 String @id @default(uuid())
  rabProjectId       String
  investorId         String
  investmentAmount   BigInt @default(0) // Berapa banyak dana dari investor ini
  profitSharePercent Float  @default(0) // Berapa persen bagi hasil untuk investor ini

  rabProject RabProject @relation(fields: [rabProjectId], references: [id])
  investor   Investor   @relation(fields: [investorId], references: [id])

  @@unique([rabProjectId, investorId])
}

model Holiday {
  id          String   @id
  date        DateTime @unique
  description String
  isNational  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Joinbox {
  id                          String          @id
  name                        String
  location                    String?
  notes                       String?
  images                      String[]        @default([])
  latitude                    Float?
  longitude                   Float?
  status                      Status          @default(AKTIF)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime
  keteranganJumlahKabelFeeder String?
  joinboxInput                JoinboxInput[]
  joinboxOutput               JoinboxOutput[]
  siteId                      String?
  site                        Sites?          @relation(fields: [siteId], references: [id])

  @@index([siteId])
}

model JoinboxInput {
  id        String  @id
  joinboxId String
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id])

  @@unique([joinboxId, idx])
}

model JoinboxOutput {
  id        String  @id
  joinboxId String
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id])

  @@unique([joinboxId, idx])
}

model KmzFile {
  id          String   @id
  name        String
  filename    String
  filePath    String
  fileSize    Int
  description String?
  lineColor   String   @default("#3388ff")
  isActive    Boolean  @default(true)
  status      Status   @default(AKTIF)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  kmlPath     String
  siteId      String?
  site        Sites?   @relation(fields: [siteId], references: [id])

  @@index([siteId])
}

model LeaveRequest {
  id              String      @id
  userId          String
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  reason          String
  attachmentUrl   String?
  attachments     String[]    @default([])
  status          LeaveStatus @default(PENDING)
  approvedBy      String?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  replacementDate DateTime?
  user            User        @relation(fields: [userId], references: [id])

  @@index([startDate])
  @@index([status])
  @@index([userId])
  @@index([startDate, endDate], map: "idx_leave_dates")
}

// Leave Balance - Tracking kuota cuti per user per tahun
model LeaveBalance {
  id        String    @id
  userId    String
  year      Int
  leaveType LeaveType
  quota     Int // Jatah total untuk tahun ini
  used      Int       @default(0) // Sudah digunakan
  createdAt DateTime  @default(now())
  updatedAt DateTime
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, year, leaveType])
  @@index([userId])
  @@index([year])
}

model MRRMovement {
  id           String   @id
  month        Int
  year         Int
  movementType String
  pelangganId  String?
  amount       BigInt
  description  String?
  createdAt    DateTime @default(now())

  @@index([movementType])
  @@index([pelangganId])
  @@index([year, month])
}

model MikroTikRouter {
  id                     String                  @id
  name                   String
  ipAddress              String                  @unique
  timezone               String                  @default("+07:00 Asia/Jakarta")
  apiPort                Int                     @default(8728)
  apiUsername            String
  apiPassword            String
  authPort               Int                     @default(7265)
  accountingPort         Int                     @default(7266)
  secretRadius           String
  isolirUrl              String?
  description            String?
  pingStatus             String                  @default("offline")
  userOnline             Int                     @default(0)
  lastStatusCheck        DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  apiPasswordGenerated   String?
  apiUsernameGenerated   String?
  siteId                 String?
  site                   Sites?                  @relation(fields: [siteId], references: [id])
  profilePPP             ProfilePPP[]
  configuration_restores ConfigurationRestores[]
  network_alerts         NetworkAlerts[]
  network_performance    NetworkPerformance[]

  @@index([pingStatus])
  @@index([siteId])
}

model Odc {
  id                          String      @id
  name                        String
  location                    String?
  notes                       String?
  images                      String[]    @default([])
  latitude                    Float?
  longitude                   Float?
  status                      Status      @default(AKTIF)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime
  otbCoreId                   String?     @unique
  keteranganJumlahKabelFeeder String?
  attenuationIn               Float?
  attenuationOut              Float?
  inputCoreColor              String?
  siteId                      String?
  otbCore                     OtbCore?    @relation(fields: [otbCoreId], references: [id])
  site                        Sites?      @relation(fields: [siteId], references: [id])
  odcOutput                   OdcOutput[]

  @@index([siteId])
}

model OdcOutput {
  id        String @id
  odcId     String
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String
  odc       Odc    @relation(fields: [odcId], references: [id])
  odp       Odp?

  @@unique([odcId, idx])
}

model Odp {
  id                          String      @id
  name                        String
  location                    String?
  notes                       String?
  images                      String[]    @default([])
  latitude                    Float?
  longitude                   Float?
  status                      Status      @default(AKTIF)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime
  odcOutputId                 String?     @unique
  keteranganJumlahKabelFeeder String?
  attenuationIn               Float?
  attenuationOut              Float?
  inputCoreColor              String?
  siteId                      String?
  odcOutput                   OdcOutput?  @relation(fields: [odcOutputId], references: [id])
  site                        Sites?      @relation(fields: [siteId], references: [id])
  odpOutput                   OdpOutput[]
  pelanggan                   Pelanggan[]

  @@index([siteId])
}

model OdpOutput {
  id        String @id
  odpId     String
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String
  odp       Odp    @relation(fields: [odpId], references: [id])

  @@unique([odpId, idx])
}

model Otb {
  id                          String    @id
  name                        String
  location                    String?
  coreCount                   Int
  notes                       String?
  images                      String[]  @default([])
  latitude                    Float?
  longitude                   Float?
  status                      Status    @default(AKTIF)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime
  keteranganJumlahKabelFeeder String?
  siteId                      String?
  site                        Sites?    @relation(fields: [siteId], references: [id])
  otbCore                     OtbCore[]

  @@index([siteId])
}

model OtbCore {
  id        String @id
  otbId     String
  idx       Int
  slotName  String
  tubeColor String
  coreColor String
  odc       Odc?
  otb       Otb    @relation(fields: [otbId], references: [id])

  @@unique([otbId, idx])
}

model Overtime {
  id                 String         @id
  userId             String
  attendanceId       String?
  reason             String
  startTime          DateTime?
  endTime            DateTime?
  startPhoto         String?
  startLocation      String?
  endPhoto           String?
  endLocation        String?
  duration           Int?
  status             OvertimeStatus @default(PENDING)
  rejectionReason    String?
  approvedBy         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  // Holiday/Off-day tracking fields
  isHolidayOvertime  Boolean        @default(false)
  isNationalHoliday  Boolean        @default(false)
  isOffDay           Boolean        @default(false)
  holidayDescription String?
  attendance         Attendance?    @relation(fields: [attendanceId], references: [id])

  user User @relation(fields: [userId], references: [id])

  @@index([startTime])
  @@index([status])
  @@index([userId])
  @@index([userId, status], map: "idx_overtime_user_status")
}

model Pelanggan {
  id                            String              @id
  idPelanggan                   String              @unique
  nama                          String
  username                      String
  password                      String
  hargaPaketId                  String
  tipe                          TipePelanggan       @default(REGULER)
  tanggalAktif                  DateTime
  jatuhTempo                    DateTime
  status                        Status              @default(AKTIF)
  syncStatus                    String              @default("PENDING") // PENDING, SYNCED, FAILED
  syncRetryCount                Int                 @default(0)
  syncError                     String?
  alamat                        String?
  noTelp                        String?
  email                         String?
  catatan                       String?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime
  biayaInstalasi                Int?
  biayaInstalasiDiskon          Float?
  biayaInstalasiIsRecurring     Boolean             @default(false)
  biayaLainnya                  Int?
  biayaLainnyaDiskon            Float?
  biayaLainnyaIsRecurring       Boolean             @default(false)
  biayaSewaPerangkat            Int?
  biayaSewaPerangkatDiskon      Float?
  biayaSewaPerangkatIsRecurring Boolean             @default(true)
  discountDuration              Int?
  discountDurationUnit          DurasiUnit?
  discountType                  DiscountType?
  discountValue                 Float?
  keteranganBiayaLainnya        String?
  useDiscount                   Boolean             @default(false)
  usePPN                        Boolean             @default(true)
  useProrate                    Boolean             @default(false)
  is2FAEnabled                  Boolean             @default(false)
  isBillNotifEnabled            Boolean             @default(true)
  isPromoEnabled                Boolean             @default(false)
  jenisDokumen                  String?
  noDokumen                     String?
  fileBAST                      String?
  fileKTP                       String?
  fileRumahSekitar              String?
  kabupatenKota                 String?
  kecamatan                     String?
  kelurahanDesa                 String?
  latitude                      Float?
  longitude                     Float?
  provinsi                      String?
  odpId                         String?
  passwordHash                  String?
  tokenVersion                  Int                 @default(1)
  userId                        String?
  autoIsolir                    Boolean             @default(true)
  siteId                        String?
  mixRadiusId                   String?             @unique
  lastSyncedAt                  DateTime?
  pushToken                     String?
  pushTokenUpdatedAt            DateTime?
  lastVersionCode               Int?
  lastVersionName               String?
  lastVersionUpdate             DateTime?
  couponUsage                   CouponUsage[]
  hargaPaket                    HargaPaket          @relation(fields: [hargaPaketId], references: [id])
  odp                           Odp?                @relation(fields: [odpId], references: [id])
  site                          Sites?              @relation(fields: [siteId], references: [id])
  user                          User?               @relation(fields: [userId], references: [id])
  customer_usage                CustomerUsage[]
  service_suspension            ServiceSuspension[]
  support_tickets               SupportTickets[]
  work_orders                   WorkOrders[]

  @@index([email])
  @@index([siteId])
  @@index([hargaPaketId])
  @@index([idPelanggan])
  @@index([jatuhTempo])
  @@index([status])
  @@index([tanggalAktif])
  @@index([tipe])
}

model Permission {
  id          String   @id
  name        String
  action      String
  resource    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  role        Role[]   @relation("PermissionToRole")

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
}

model Pole {
  id         String   @id
  name       String
  location   String?
  notes      String?
  images     String[] @default([])
  latitude   Float?
  longitude  Float?
  cableSlack Boolean  @default(false)
  status     Status   @default(AKTIF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  siteId     String?
  site       Sites?   @relation(fields: [siteId], references: [id])

  @@index([siteId])
}

model ProfilePPP {
  id               String          @id
  name             String          @unique
  localAddress     String
  remoteAddress    String
  dnsServer        String?
  sessionTimeout   Int?
  idleTimeout      Int?
  mikroTikRouterId String?
  description      String?
  status           Status          @default(AKTIF)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  hargaPaket       HargaPaket[]
  mikroTikRouter   MikroTikRouter? @relation(fields: [mikroTikRouterId], references: [id])
  siteId           String?
  site             Sites?          @relation(fields: [siteId], references: [id])

  @@index([mikroTikRouterId])
  @@index([siteId])
}

model ReminderLog {
  id            String    @id
  pelangganId   String
  reminderType  String
  channel       String
  recipient     String
  subject       String?
  message       String
  status        String    @default("PENDING")
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([pelangganId])
  @@index([status])
}

model RevenueSnapshot {
  id               String   @id
  snapshotDate     DateTime
  snapshotType     String   @default("DAILY")
  totalMRR         BigInt   @default(0)
  totalARR         BigInt   @default(0)
  newMRR           BigInt   @default(0)
  expansionMRR     BigInt   @default(0)
  contractionMRR   BigInt   @default(0)
  churnMRR         BigInt   @default(0)
  reactivationMRR  BigInt   @default(0)
  activeCustomers  Int      @default(0)
  newCustomers     Int      @default(0)
  churnedCustomers Int      @default(0)
  arpu             Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([snapshotDate, snapshotType])
  @@index([snapshotDate])
  @@index([snapshotType])
}

model Role {
  id                  String       @id
  name                String       @unique
  description         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime
  accessAdminPanel    Boolean      @default(false)
  accessEmployeePanel Boolean      @default(false)
  isRestricted        Boolean      @default(false)
  isTechnical         Boolean      @default(false)
  isSuperAdmin        Boolean      @default(false)
  canApproveRab       Boolean      @default(false)
  user                User[]
  permission          Permission[] @relation("PermissionToRole")

  @@index([accessAdminPanel])
  @@index([accessEmployeePanel])
  @@index([isRestricted])
  @@map("roles")
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id          String   @id
  key         String   @unique
  value       String?
  encrypted   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([key])
}

model SystemLog {
  id        String   @id
  type      LogType
  action    String
  subject   String
  details   String?
  userId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([type])
  @@index([userId])
}

model User {
  id                                         String                    @id
  name                                       String?
  email                                      String                    @unique
  passwordHash                               String?
  createdAt                                  DateTime                  @default(now())
  updatedAt                                  DateTime
  emailVerified                              DateTime?
  image                                      String?
  phone                                      String?
  departmentId                               String?
  siteId                                     String?
  roleId                                     String?
  isActive                                   Boolean                   @default(true)
  workingHourMode                            WorkingHourMode           @default(FIXED)
