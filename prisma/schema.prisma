generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model ARAgingSnapshot {
  id               String   @id
  snapshotDate     DateTime @default(now())
  current          BigInt   @default(0)
  overdue30        BigInt   @default(0)
  overdue60        BigInt   @default(0)
  overdue90        BigInt   @default(0)
  totalOutstanding BigInt   @default(0)
  totalCustomers   Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([snapshotDate])
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Announcement {
  id        String             @id
  title     String
  content   String
  target    TargetAudience     @default(ALL)
  isActive  Boolean            @default(true)
  isPinned  Boolean            @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime
  createdBy String?
  user      User?              @relation(fields: [createdBy], references: [id])
  reads     AnnouncementRead[]

  @@index([isActive])
  @@index([target])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  userId         String?
  pelangganId    String?
  portal         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@unique([announcementId, pelangganId])
  @@index([announcementId])
  @@index([userId])
  @@index([pelangganId])
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  SICK
  PERMIT
  DAY_OFF
}

model Attendance {
  id                       String           @id
  userId                   String
  checkIn                  DateTime         @default(now())
  checkOut                 DateTime?
  checkInPhoto             String?
  checkOutPhoto            String?
  status                   AttendanceStatus @default(ON_TIME)
  notes                    String?
  location                 String?
  checkOutLocation         String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime
  geofenceStatus           String?
  geofenceDistance         Float?
  geofenceSiteName         String?
  checkOutGeofenceStatus   String?
  checkOutGeofenceDistance Float?
  geofenceMeta             Json?
  user                     User             @relation(fields: [userId], references: [id])
  overtime                 Overtime[]

  @@index([checkIn])
  @@index([status])
  @@index([userId])
  @@index([userId, checkIn])
}

model EmployeeLocation {
  id           String   @id @default(uuid())
  userId       String
  latitude     Float
  longitude    Float
  accuracy     Float?
  altitude     Float?
  speed        Float?
  heading      Float?
  batteryLevel Float?
  isMoving     Boolean  @default(false)
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
  @@index([userId, recordedAt])
  @@map("employee_locations")
}

model Bandwidth {
  id                     String       @id
  name                   String       @unique
  maxLimitDownload       String
  maxLimitUpload         String
  burstLimitDownload     String?
  burstLimitUpload       String?
  minLimitDownload       String?
  minLimitUpload         String?
  burstThresholdDownload String?
  burstThresholdUpload   String?
  burstTimeDownload      Int?
  burstTimeUpload        Int?
  priority               Int?
  uploadSpeed            Int?
  downloadSpeed          Int?
  description            String?
  status                 Status       @default(AKTIF)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime
  hargaPaket             HargaPaket[]
}

model Coupon {
  id             String        @id
  code           String        @unique
  description    String?
  discountType   DiscountType
  discountValue  Float
  startDate      DateTime
  endDate        DateTime
  minTransaction Int           @default(0)
  maxDiscount    Int?
  quota          Int           @default(0)
  usedCount      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  couponUsage    CouponUsage[]
}

model CouponUsage {
  id          String     @id
  couponId    String
  userId      String?
  pelangganId String?
  usedAt      DateTime   @default(now())
  coupon      Coupon     @relation(fields: [couponId], references: [id])
  pelanggan   Pelanggan? @relation(fields: [pelangganId], references: [id])

  @@index([couponId])
  @@index([pelangganId])
}

model CustomerCohort {
  id               String   @id
  cohortMonth      Int
  cohortYear       Int
  initialCustomers Int
  month0Revenue    BigInt   @default(0)
  month1Revenue    BigInt   @default(0)
  month2Revenue    BigInt   @default(0)
  month3Revenue    BigInt   @default(0)
  month6Revenue    BigInt   @default(0)
  month12Revenue   BigInt   @default(0)
  activeMonth0     Int      @default(0)
  activeMonth1     Int      @default(0)
  activeMonth3     Int      @default(0)
  activeMonth6     Int      @default(0)
  activeMonth12    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@unique([cohortYear, cohortMonth])
  @@index([cohortYear, cohortMonth])
}

model Expense {
  id          String   @id
  date        DateTime @default(now())
  amount      BigInt
  category    String
  description String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  siteId      String?
  site        Sites?   @relation(fields: [siteId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([date])
  @@index([userId])
  @@index([siteId])
}

model HargaPaket {
  id                   String        @id
  name                 String        @unique
  bandwidthId          String?
  profilePPPId         String
  harga                Int
  durasi               Int           @default(30)
  durasiUnit           DurasiUnit    @default(HARI)
  usePPN               Boolean       @default(false)
  ppnPercentage        Float?
  useDiscount          Boolean       @default(false)
  discountType         DiscountType?
  discountValue        Float?
  discountDuration     Int?
  discountDurationUnit DurasiUnit?
  description          String?
  featured             Boolean       @default(false)
  status               Status        @default(AKTIF)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  bandwidth            Bandwidth?    @relation(fields: [bandwidthId], references: [id])
  profilePPP           ProfilePPP    @relation(fields: [profilePPPId], references: [id])
  pelanggan            Pelanggan[]

  @@index([bandwidthId])
  @@index([featured])
  @@index([profilePPPId])
  @@index([status])
}

model Holiday {
  id          String   @id
  date        DateTime @unique
  description String
  isNational  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Invoice {
  id             String        @id
  invoiceNumber  String        @unique
  pelangganId    String
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  subtotal       BigInt        @default(0)
  taxAmount      BigInt        @default(0)
  discountAmount BigInt        @default(0)
  totalAmount    BigInt        @default(0)
  paidAmount     BigInt        @default(0)
  notes          String?
  terms          String?
  sentAt         DateTime?
  paidAt         DateTime?
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  siteId         String?
  pelanggan      Pelanggan     @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  site           Sites?        @relation(fields: [siteId], references: [id])
  invoiceItem    InvoiceItem[]
  payment        Payment[]

  @@index([dueDate])
  @@index([invoiceNumber])
  @@index([issueDate])
  @@index([pelangganId])
  @@index([status])
  @@index([siteId])
}

model InvoiceItem {
  id          String   @id
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   BigInt
  totalPrice  BigInt
  itemType    ItemType @default(SERVICE)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Joinbox {
  id                          String          @id
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status          @default(AKTIF)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime
  keteranganJumlahKabelFeeder String?
  joinboxInput                JoinboxInput[]
  joinboxOutput               JoinboxOutput[]
}

model JoinboxInput {
  id        String  @id
  joinboxId String
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id])

  @@unique([joinboxId, idx])
}

model JoinboxOutput {
  id        String  @id
  joinboxId String
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id])

  @@unique([joinboxId, idx])
}

model KmzFile {
  id          String   @id
  name        String
  filename    String
  filePath    String
  fileSize    Int
  description String?
  lineColor   String   @default("#3388ff")
  isActive    Boolean  @default(true)
  status      Status   @default(AKTIF)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  kmlPath     String
}

model LeaveRequest {
  id              String      @id
  userId          String
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  reason          String
  attachmentUrl   String?
  attachments     String[]    @default([])
  status          LeaveStatus @default(PENDING)
  approvedBy      String?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  replacementDate DateTime?
  user            User        @relation(fields: [userId], references: [id])

  @@index([startDate])
  @@index([status])
  @@index([userId])
}

model MRRMovement {
  id           String   @id
  month        Int
  year         Int
  movementType String
  pelangganId  String?
  amount       BigInt
  description  String?
  createdAt    DateTime @default(now())

  @@index([movementType])
  @@index([pelangganId])
  @@index([year, month])
}

model MikroTikRouter {
  id                     String                  @id
  name                   String
  ipAddress              String                  @unique
  timezone               String                  @default("+07:00 Asia/Jakarta")
  apiPort                Int                     @default(8728)
  apiUsername            String
  apiPassword            String
  authPort               Int                     @default(7265)
  accountingPort         Int                     @default(7266)
  secretRadius           String
  isolirUrl              String?
  description            String?
  pingStatus             String                  @default("offline")
  userOnline             Int                     @default(0)
  lastStatusCheck        DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  apiPasswordGenerated   String?
  apiUsernameGenerated   String?
  siteId                 String?
  site                   Sites?                  @relation(fields: [siteId], references: [id])
  profilePPP             ProfilePPP[]
  configuration_restores ConfigurationRestores[]
  network_alerts         NetworkAlerts[]
  network_performance    NetworkPerformance[]

  @@index([pingStatus])
  @@index([siteId])
}

model Odc {
  id                          String      @id
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status      @default(AKTIF)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime
  otbCoreId                   String      @unique
  keteranganJumlahKabelFeeder String?
  siteId                      String?
  otbCore                     OtbCore     @relation(fields: [otbCoreId], references: [id])
  site                        Sites?      @relation(fields: [siteId], references: [id])
  odcOutput                   OdcOutput[]

  @@index([siteId])
}

model OdcOutput {
  id        String @id
  odcId     String
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String
  odc       Odc    @relation(fields: [odcId], references: [id])
  odp       Odp?

  @@unique([odcId, idx])
}

model Odp {
  id                          String      @id
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status      @default(AKTIF)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime
  odcOutputId                 String      @unique
  keteranganJumlahKabelFeeder String?
  siteId                      String?
  odcOutput                   OdcOutput   @relation(fields: [odcOutputId], references: [id])
  site                        Sites?      @relation(fields: [siteId], references: [id])
  odpOutput                   OdpOutput[]
  pelanggan                   Pelanggan[]

  @@index([siteId])
}

model OdpOutput {
  id        String @id
  odpId     String
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String
  odp       Odp    @relation(fields: [odpId], references: [id])

  @@unique([odpId, idx])
}

model Olt {
  id                     String                  @id
  name                   String
  ipAddress              String                  @unique
  type                   String
  version                String?
  temperature            Int?
  connectedDevices       Int                     @default(0)
  model                  String?
  uptime                 String?
  syncStatus             String                  @default("0")
  syncDate               DateTime?
  telnetConnected        Boolean                 @default(false)
  snmpConnected          Boolean                 @default(false)
  snmpCommunityWrite     String                  @default("public")
  snmpVersion            String                  @default("2")
  snmpPort               Int                     @default(161)
  telnetUsername         String                  @default("zte")
  telnetPassword         String
  telnetPort             Int                     @default(23)
  onuLastSync            DateTime?
  onuSyncEnabled         Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  siteId                 String?
  site                   Sites?                  @relation(fields: [siteId], references: [id])
  onu                    Onu[]
  onuType                OnuType[]
  speedProfile           SpeedProfile[]
  configuration_restores ConfigurationRestores[]
  network_alerts         NetworkAlerts[]
  network_performance    NetworkPerformance[]

  @@index([siteId])
}

model Onu {
  id                     String                  @id
  oltId                  String
  name                   String
  description            String?
  pppoe                  String?
  gponOnu                String
  status                 String
  rxOlt                  String?
  rxOnu                  String?
  serialNumber           String?
  actualType             String?
  lastUpdate             DateTime                @default(now())
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  authMode               String?
  batteryStatus          String?
  configState            String?
  distance               Float?
  dyingGaspTime          DateTime?
  equipmentId            String?
  firmwareVersion        String?
  hardwareVersion        String?
  laserBiasCurrent       Float?
  lastDeregTime          DateTime?
  lastSeen               DateTime?
  loid                   String?
  macAddress             String?
  opticalTransceiverType String?
  password               String?
  powerLevel             String?
  registerTime           DateTime?
  registrationMode       String?
  rxBytes                BigInt?
  rxDrops                BigInt?
  rxErrors               BigInt?
  rxPackets              BigInt?
  rxPowerStatus          String?
  softwareVersion        String?
  temperature            Float?
  txBytes                BigInt?
  txDrops                BigInt?
  txErrors               BigInt?
  txOlt                  String?
  txOnu                  String?
  txPackets              BigInt?
  txPowerStatus          String?
  vendorId               String?
  wifiChannel            Int?
  wifiEnable             Boolean?
  wifiSecurityMode       String?
  wifiSsid               String?
  compositeIndex         Int?
  descOid                String?
  nameOid                String?
  rxOltOid               String?
  rxOnuOid               String?
  statusOid              String?
  olt                    Olt                     @relation(fields: [oltId], references: [id], onDelete: Cascade)
  configuration_restores ConfigurationRestores[]
  network_alerts         NetworkAlerts[]
  network_performance    NetworkPerformance[]

  @@unique([oltId, gponOnu])
  @@index([lastSeen])
  @@index([lastUpdate])
  @@index([macAddress])
  @@index([oltId, gponOnu])
  @@index([oltId])
  @@index([oltId, lastUpdate])
  @@index([oltId, status])
  @@index([registerTime])
  @@index([serialNumber])
  @@index([status])
  @@index([status, lastUpdate])
}

model OnuType {
  id                    String   @id
  oltId                 String
  name                  String
  ethernetPorts         Int      @default(0)
  wifi                  Int      @default(0)
  voipPorts             Int      @default(0)
  ponType               String?
  description           String?
  maxTcont              Int?
  maxGemPort            Int?
  maxSwitchPerSlot      Int?
  maxFlowPerSwitch      Int?
  maxIpHost             Int?
  maxIpv6Host           Int?
  serviceAbilityN1      String?
  serviceAbility1M      String?
  serviceAbility1P      String?
  wifiMgmtViaNonOmci    String?
  omciSendMode          String?
  defaultMulticastRange String?
  vrg                   String?
  mgcConfigureMode      String?
  maxVeip               Int?
  extendedOmci          String?
  location              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime
  olt                   Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)

  @@unique([oltId, name])
  @@index([oltId])
}

model Otb {
  id                          String    @id
  name                        String
  location                    String?
  coreCount                   Int
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status    @default(AKTIF)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime
  keteranganJumlahKabelFeeder String?
  siteId                      String?
  site                        Sites?    @relation(fields: [siteId], references: [id])
  otbCore                     OtbCore[]

  @@index([siteId])
}

model OtbCore {
  id        String @id
  otbId     String
  idx       Int
  slotName  String
  tubeColor String
  coreColor String
  odc       Odc?
  otb       Otb    @relation(fields: [otbId], references: [id])

  @@unique([otbId, idx])
}

model Overtime {
  id              String         @id
  userId          String
  attendanceId    String?
  reason          String
  startTime       DateTime?
  endTime         DateTime?
  startPhoto      String?
  startLocation   String?
  endPhoto        String?
  endLocation     String?
  duration        Int?
  status          OvertimeStatus @default(PENDING)
  rejectionReason String?
  approvedBy      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  attendance      Attendance?    @relation(fields: [attendanceId], references: [id])
  user            User           @relation(fields: [userId], references: [id])

  @@index([startTime])
  @@index([status])
  @@index([userId])
}

model Payment {
  id            String        @id
  invoiceId     String?
  pelangganId   String
  amount        BigInt
  paymentDate   DateTime
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([pelangganId])
}

model PaymentGatewayConfig {
  id           String    @id
  provider     String    @unique
  providerName String
  isEnabled    Boolean   @default(false)
  isProduction Boolean   @default(false)
  priority     Int       @default(0)
  apiKey       String?
  apiSecret    String?
  clientKey    String?
  merchantId   String?
  webhookUrl   String?
  callbackUrl  String?
  settings     Json?
  lastTestedAt DateTime?
  testStatus   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  createdBy    String?

  @@index([isEnabled])
  @@index([priority])
  @@index([provider])
}

model Pelanggan {
  id                            String              @id
  idPelanggan                   String              @unique
  nama                          String
  username                      String
  password                      String
  passwordLogin                 String
  hargaPaketId                  String
  tipe                          TipePelanggan       @default(REGULER)
  tanggalAktif                  DateTime
  jatuhTempo                    DateTime
  status                        Status              @default(AKTIF)
  alamat                        String?
  noTelp                        String?
  email                         String?
  catatan                       String?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime
  biayaInstalasi                Int?
  biayaInstalasiDiskon          Float?
  biayaInstalasiIsRecurring     Boolean             @default(false)
  biayaLainnya                  Int?
  biayaLainnyaDiskon            Float?
  biayaLainnyaIsRecurring       Boolean             @default(false)
  biayaSewaPerangkat            Int?
  biayaSewaPerangkatDiskon      Float?
  biayaSewaPerangkatIsRecurring Boolean             @default(true)
  discountDuration              Int?
  discountDurationUnit          DurasiUnit?
  discountType                  DiscountType?
  discountValue                 Float?
  keteranganBiayaLainnya        String?
  useDiscount                   Boolean             @default(false)
  usePPN                        Boolean             @default(true)
  useProrate                    Boolean             @default(false)
  is2FAEnabled                  Boolean             @default(false)
  isBillNotifEnabled            Boolean             @default(true)
  isPromoEnabled                Boolean             @default(false)
  jenisDokumen                  String?
  noDokumen                     String?
  fileBAST                      String?
  fileKTP                       String?
  fileRumahSekitar              String?
  kabupatenKota                 String?
  kecamatan                     String?
  kelurahanDesa                 String?
  latitude                      Float?
  longitude                     Float?
  provinsi                      String?
  odpId                         String?
  passwordHash                  String?
  tokenVersion                  Int                 @default(1)
  userId                        String?
  autoIsolir                    Boolean             @default(true)
  siteId                        String?
  couponUsage                   CouponUsage[]
  invoice                       Invoice[]
  hargaPaket                    HargaPaket          @relation(fields: [hargaPaketId], references: [id])
  odp                           Odp?                @relation(fields: [odpId], references: [id])
  site                          Sites?              @relation(fields: [siteId], references: [id])
  user                          User?               @relation(fields: [userId], references: [id])
  customer_usage                CustomerUsage[]
  service_suspension            ServiceSuspension[]
  support_tickets               SupportTickets[]
  work_orders                   WorkOrders[]

  @@index([email])
  @@index([siteId])
  @@index([hargaPaketId])
  @@index([idPelanggan])
  @@index([jatuhTempo])
  @@index([status])
  @@index([tanggalAktif])
  @@index([tipe])
}

model Permission {
  id          String   @id
  name        String
  action      String
  resource    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  role        Role[]   @relation("PermissionToRole")

  @@unique([resource, action])
  @@index([resource]) // For filtering by resource type
  @@index([action]) // For filtering by action type
}

model Pole {
  id         String   @id
  name       String
  location   String?
  notes      String?
  latitude   Float?
  longitude  Float?
  cableSlack Boolean  @default(false)
  status     Status   @default(AKTIF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  siteId     String?
  site       Sites?   @relation(fields: [siteId], references: [id])

  @@index([siteId])
}

model ProfilePPP {
  id               String          @id
  name             String          @unique
  localAddress     String
  remoteAddress    String
  dnsServer        String?
  sessionTimeout   Int?
  idleTimeout      Int?
  mikroTikRouterId String?
  description      String?
  status           Status          @default(AKTIF)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  hargaPaket       HargaPaket[]
  mikroTikRouter   MikroTikRouter? @relation(fields: [mikroTikRouterId], references: [id])

  @@index([mikroTikRouterId])
}

model ReminderLog {
  id            String    @id
  pelangganId   String
  reminderType  String
  channel       String
  recipient     String
  subject       String?
  message       String
  status        String    @default("PENDING")
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())

