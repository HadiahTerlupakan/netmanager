  amount         Decimal               @db.Decimal(19, 2)
  depositType    InvestorDepositType
  date           DateTime
  bankName       String?
  accountNumber  String?
  accountName    String?
  reference      String?
  notes          String?
  proofFileUrl   String?
  status         InvestorDepositStatus @default(PENDING)
