generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String?
  email               String         @unique
  passwordHash        String?
  role                Role           @default(USER)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  bankAccountsCreated BankAccount[]  @relation("BankAccountCreatedBy")
  bankAccountsUpdated BankAccount[]  @relation("BankAccountUpdatedBy")
  pelanggan           Pelanggan[]
  pemasukanCreated    Pemasukan[]    @relation("PemasukanCreatedBy")
  pemasukanUpdated    Pemasukan[]    @relation("PemasukanUpdatedBy")
  pengeluaranCreated  Pengeluaran[]  @relation("PengeluaranCreatedBy")
  pengeluaranUpdated  Pengeluaran[]  @relation("PengeluaranUpdatedBy")
  sessions            Session[]
  transactionsCreated Transaction[]  @relation("TransactionCreatedBy")
  transactionsUpdated Transaction[]  @relation("TransactionUpdatedBy")
  barangMasuk         BarangMasuk[]  @relation("EmployeeBarangMasuk")
  barangKeluar        BarangKeluar[] @relation("EmployeeBarangKeluar")
  tickets             Ticket[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Olt {
  id                 String         @id @default(cuid())
  name               String
  ipAddress          String         @unique
  type               String
  version            String?
  temperature        Int?
  connectedDevices   Int            @default(0)
  model              String?
  uptime             String?
  syncStatus         String         @default("0")
  syncDate           DateTime?
  telnetConnected    Boolean        @default(false)
  snmpConnected      Boolean        @default(false)
  snmpCommunityWrite String         @default("public")
  snmpVersion        String         @default("2")
  snmpPort           Int            @default(161)
  telnetUsername     String         @default("zte")
  telnetPassword     String
  telnetPort         Int            @default(23)
  onuLastSync        DateTime?
  onuSyncEnabled     Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  onus               Onu[]
  onuTypes           OnuType[]
  speedProfiles      SpeedProfile[]
}

model Otb {
  id                          String    @id @default(cuid())
  name                        String
  location                    String?
  coreCount                   Int
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status    @default(AKTIF)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  keteranganJumlahKabelFeeder String?
  cores                       OtbCore[]
}

model OtbCore {
  id        String @id @default(cuid())
  otbId     String
  idx       Int
  slotName  String
  tubeColor String
  coreColor String
  odc       Odc?
  otb       Otb    @relation(fields: [otbId], references: [id])

  @@unique([otbId, idx])
}

model Odc {
  id                          String      @id @default(cuid())
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status      @default(AKTIF)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  otbCoreId                   String      @unique
  keteranganJumlahKabelFeeder String?
  otbCore                     OtbCore     @relation(fields: [otbCoreId], references: [id])
  outputs                     OdcOutput[]
}

model OdcOutput {
  id        String @id @default(cuid())
  odcId     String
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String
  odc       Odc    @relation(fields: [odcId], references: [id])
  odp       Odp?

  @@unique([odcId, idx])
}

model Odp {
  id                          String      @id @default(cuid())
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status      @default(AKTIF)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  odcOutputId                 String      @unique
  keteranganJumlahKabelFeeder String?
  odcOutput                   OdcOutput   @relation(fields: [odcOutputId], references: [id])
  outputs                     OdpOutput[]
  pelanggans                  Pelanggan[]
}

model OdpOutput {
  id        String @id @default(cuid())
  odpId     String
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String
  odp       Odp    @relation(fields: [odpId], references: [id])

  @@unique([odpId, idx])
}

model Joinbox {
  id                          String          @id @default(cuid())
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status          @default(AKTIF)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  keteranganJumlahKabelFeeder String?
  inputs                      JoinboxInput[]
  outputs                     JoinboxOutput[]
}

model JoinboxInput {
  id        String  @id @default(cuid())
  joinboxId String
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id])

  @@unique([joinboxId, idx])
}

model JoinboxOutput {
  id        String  @id @default(cuid())
  joinboxId String
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id])

  @@unique([joinboxId, idx])
}

model Pole {
  id         String   @id @default(cuid())
  name       String
  location   String?
  notes      String?
  latitude   Float?
  longitude  Float?
  cableSlack Boolean  @default(false)
  status     Status   @default(AKTIF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KmzFile {
  id          String   @id @default(cuid())
  name        String
  filename    String
  filePath    String
  fileSize    Int
  description String?
  lineColor   String   @default("#3388ff")
  isActive    Boolean  @default(true)
  status      Status   @default(AKTIF)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  kmlPath     String
}

model Onu {
  id                     String    @id @default(cuid())
  oltId                  String
  name                   String
  description            String?
  pppoe                  String?
  gponOnu                String
  status                 String
  rxOlt                  String?
  rxOnu                  String?
  serialNumber           String?
  actualType             String?
  lastUpdate             DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  authMode               String?
  batteryStatus          String?
  configState            String?
  distance               Float?
  dyingGaspTime          DateTime?
  equipmentId            String?
  firmwareVersion        String?
  hardwareVersion        String?
  laserBiasCurrent       Float?
  lastDeregTime          DateTime?
  lastSeen               DateTime?
  loid                   String?
  macAddress             String?
  opticalTransceiverType String?
  password               String?
  powerLevel             String?
  registerTime           DateTime?
  registrationMode       String?
  rxBytes                BigInt?
  rxDrops                BigInt?
  rxErrors               BigInt?
  rxPackets              BigInt?
  rxPowerStatus          String?
  softwareVersion        String?
  temperature            Float?
  txBytes                BigInt?
  txDrops                BigInt?
  txErrors               BigInt?
  txOlt                  String?
  txOnu                  String?
  txPackets              BigInt?
  txPowerStatus          String?
  vendorId               String?
  wifiChannel            Int?
  wifiEnable             Boolean?
  wifiSecurityMode       String?
  wifiSsid               String?
  compositeIndex         Int?
  descOid                String?
  nameOid                String?
  rxOltOid               String?
  rxOnuOid               String?
  statusOid              String?
  olt                    Olt       @relation(fields: [oltId], references: [id], onDelete: Cascade)

  @@unique([oltId, gponOnu])
  @@index([oltId])
  @@index([status])
  @@index([lastUpdate])
  @@index([registerTime])
  @@index([lastSeen])
  @@index([serialNumber])
  @@index([macAddress])
  @@index([oltId, status])
  @@index([oltId, lastUpdate])
  @@index([status, lastUpdate])
  @@index([oltId, gponOnu])
}

model OnuType {
  id                    String   @id @default(cuid())
  oltId                 String
  name                  String
  ethernetPorts         Int      @default(0)
  wifi                  Int      @default(0)
  voipPorts             Int      @default(0)
  ponType               String?
  description           String?
  maxTcont              Int?
  maxGemPort            Int?
  maxSwitchPerSlot      Int?
  maxFlowPerSwitch      Int?
  maxIpHost             Int?
  maxIpv6Host           Int?
  serviceAbilityN1      String?
  serviceAbility1M      String?
  serviceAbility1P      String?
  wifiMgmtViaNonOmci    String?
  omciSendMode          String?
  defaultMulticastRange String?
  vrg                   String?
  mgcConfigureMode      String?
  maxVeip               Int?
  extendedOmci          String?
  location              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  olt                   Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)

  @@unique([oltId, name])
  @@index([oltId])
}

model SpeedProfile {
  id           String   @id @default(cuid())
  oltId        String
  profileType  String   @default("Download")
  name         String
  type         Int
  bandwidthSir Int
  burstPir     Int
  fixed        Int?
  assured      Int?
  maximum      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  olt          Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)

  @@unique([oltId, profileType, name])
  @@index([oltId])
  @@index([profileType])
}

model MikroTikRouter {
  id              String       @id @default(cuid())
  name            String
  ipAddress       String       @unique
  timezone        String       @default("+07:00 Asia/Jakarta")
  apiPort         Int          @default(8728)
  apiUsername     String
  apiPassword     String
  authPort        Int          @default(7265)
  accountingPort  Int          @default(7266)
  secretRadius    String
  isolirUrl       String?
  description     String?
  pingStatus      String       @default("offline")
  userOnline      Int          @default(0)
  lastStatusCheck DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  profilePPPs     ProfilePPP[]

  @@index([pingStatus])
}

model Bandwidth {
  id                     String       @id @default(cuid())
  name                   String       @unique
  maxLimitDownload       String
  maxLimitUpload         String
  burstLimitDownload     String?
  burstLimitUpload       String?
  minLimitDownload       String?
  minLimitUpload         String?
  burstThresholdDownload String?
  burstThresholdUpload   String?
  burstTimeDownload      Int?
  burstTimeUpload        Int?
  priority               Int?
  uploadSpeed            Int?
  downloadSpeed          Int?
  description            String?
  status                 Status       @default(AKTIF)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  hargaPakets            HargaPaket[]
}

model ProfilePPP {
  id               String          @id @default(cuid())
  name             String          @unique
  localAddress     String
  remoteAddress    String
  dnsServer        String?
  sessionTimeout   Int?
  idleTimeout      Int?
  mikroTikRouterId String?
  description      String?
  status           Status          @default(AKTIF)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  hargaPakets      HargaPaket[]
  mikroTikRouter   MikroTikRouter? @relation(fields: [mikroTikRouterId], references: [id])

  @@index([mikroTikRouterId])
}

model HargaPaket {
  id                   String        @id @default(cuid())
  name                 String        @unique
  bandwidthId          String?
  profilePPPId         String
  harga                Int
  durasi               Int           @default(30)
  durasiUnit           DurasiUnit    @default(HARI)
  usePPN               Boolean       @default(false)
  ppnPercentage        Float?
  useDiscount          Boolean       @default(false)
  discountType         DiscountType?
  discountValue        Float?
  discountDuration     Int?
  discountDurationUnit DurasiUnit?
  description          String?
  featured             Boolean       @default(false)
  status               Status        @default(AKTIF)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  bandwidth            Bandwidth?    @relation(fields: [bandwidthId], references: [id])
  profilePPP           ProfilePPP    @relation(fields: [profilePPPId], references: [id])
  pelanggans           Pelanggan[]

  @@index([bandwidthId])
  @@index([profilePPPId])
  @@index([status])
  @@index([featured])
}

model Pelanggan {
  id                            String          @id @default(cuid())
  idPelanggan                   String          @unique
  nama                          String
  username                      String
  password                      String
  passwordLogin                 String
  hargaPaketId                  String
  tipe                          TipePelanggan   @default(REGULER)
  tanggalAktif                  DateTime
  jatuhTempo                    DateTime
  status                        Status          @default(AKTIF)
  alamat                        String?
  noTelp                        String?
  email                         String?
  catatan                       String?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
  biayaInstalasi                Int?
  biayaInstalasiDiskon          Float?
  biayaInstalasiIsRecurring     Boolean         @default(false)
  biayaLainnya                  Int?
  biayaLainnyaDiskon            Float?
  biayaLainnyaIsRecurring       Boolean         @default(false)
  biayaSewaPerangkat            Int?
  biayaSewaPerangkatDiskon      Float?
  biayaSewaPerangkatIsRecurring Boolean         @default(true)
  discountDuration              Int?
  discountDurationUnit          DurasiUnit?
  discountType                  DiscountType?
  discountValue                 Float?
  keteranganBiayaLainnya        String?
  useDiscount                   Boolean         @default(false)
  usePPN                        Boolean         @default(true)
  useProrate                    Boolean         @default(false)
  jenisDokumen                  String?
  noDokumen                     String?
  fileBAST                      String?
  fileKTP                       String?
  fileRumahSekitar              String?
  kabupatenKota                 String?
  kecamatan                     String?
  kelurahanDesa                 String?
  latitude                      Float?
  longitude                     Float?
  provinsi                      String?
  odpId                         String?
  passwordHash                  String?
  tokenVersion                  Int             @default(1)
  userId                        String?
  manualPayments                ManualPayment[]
  hargaPaket                    HargaPaket      @relation(fields: [hargaPaketId], references: [id])
  odp                           Odp?            @relation(fields: [odpId], references: [id])
  user                          User?           @relation(fields: [userId], references: [id])
  tagihans                      Tagihan[]
  tickets                       Ticket[]
  workOrders                    WorkOrder[]

  @@index([idPelanggan])
  @@index([hargaPaketId])
  @@index([status])
  @@index([tipe])
  @@index([tanggalAktif])
  @@index([jatuhTempo])
  @@index([email])
}

model Tagihan {
  id                  String                      @id @default(cuid())
  pelangganId         String
  noTagihan           String                      @unique
  periodeBulan        Int
  periodeTahun        Int
  subtotal            Int
  diskon              Int                         @default(0)
  ppn                 Int                         @default(0)
  biayaInstalasi      Int                         @default(0)
  biayaSewaPerangkat  Int                         @default(0)
  biayaLainnya        Int                         @default(0)
  total               Int
  status              TagihanStatus               @default(BELUM_LUNAS)
  jatuhTempo          DateTime
  tanggalBayar        DateTime?
  metodePembayaran    String?
  catatan             String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  manualPayments      ManualPayment[]
  paymentTransactions PaymentGatewayTransaction[]
  paymentLink         PaymentLink?
  pelanggan           Pelanggan                   @relation(fields: [pelangganId], references: [id], onDelete: Cascade)

  @@unique([pelangganId, periodeBulan, periodeTahun])
  @@index([pelangganId])
  @@index([status])
  @@index([jatuhTempo])
  @@index([noTagihan])
  @@index([periodeBulan, periodeTahun])
  @@index([createdAt])
}

model PaymentGatewayConfig {
  id           String                      @id @default(cuid())
  provider     String                      @unique
  providerName String
  isEnabled    Boolean                     @default(false)
  isProduction Boolean                     @default(false)
  priority     Int                         @default(0)
  apiKey       String?
  apiSecret    String?
  clientKey    String?
  merchantId   String?
  webhookUrl   String?
  callbackUrl  String?
  settings     Json?
  lastTestedAt DateTime?
  testStatus   String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  createdBy    String?
  transactions PaymentGatewayTransaction[]

  @@index([provider])
  @@index([isEnabled])
  @@index([priority])
}

model PaymentGatewayTransaction {
  id              String               @id @default(cuid())
  provider        String
  orderId         String               @unique
  transactionId   String?              @unique
  tagihanId       String
  amount          BigInt
  paymentMethod   String?
  bankCode        String?
  status          String               @default("PENDING")
  paidAt          DateTime?
  expiredAt       DateTime?
  paymentUrl      String?
  qrCodeUrl       String?
  vaNumber        String?
  webhookReceived Boolean              @default(false)
  webhookData     Json?
  customerEmail   String?
  customerPhone   String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  providerConfig  PaymentGatewayConfig @relation(fields: [provider], references: [provider])
  tagihan         Tagihan              @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  @@index([tagihanId])
  @@index([status])
  @@index([orderId])
  @@index([transactionId])
  @@index([createdAt])
}

model PaymentLink {
  id           String    @id @default(cuid())
  tagihanId    String    @unique
  linkToken    String    @unique
  paymentUrl   String
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tagihan      Tagihan   @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  @@index([linkToken])
  @@index([tagihanId])
}

model CompanyBankAccount {
  id             String          @id @default(cuid())
  bankName       String
  accountNumber  String
  accountName    String
  isActive       Boolean         @default(true)
  priority       Int             @default(1)
  logo           String?
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  manualPayments ManualPayment[]

  @@index([isActive])
  @@index([priority])
}

model ManualPayment {
  id              String             @id @default(cuid())
  tagihanId       String
  pelangganId     String
  bankAccountId   String
  amount          BigInt
  senderName      String
  transferDate    DateTime
  proofImageUrl   String
  notes           String?
  status          String             @default("PENDING")
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bankAccount     CompanyBankAccount @relation(fields: [bankAccountId], references: [id])
  pelanggan       Pelanggan          @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  tagihan         Tagihan            @relation(fields: [tagihanId], references: [id], onDelete: Cascade)

  @@index([tagihanId])
  @@index([pelangganId])
  @@index([status])
  @@index([createdAt])
}

model Pengeluaran {
  id              String          @id @default(cuid())
  tanggal         DateTime
  tipePengeluaran TipePengeluaran @default(OPEX)
  kategori        String
  deskripsi       String
  jumlah          BigInt
  metodeBayar     String?
  catatan         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String?
  updatedBy       String?
  budgetId        String?
  isApproved      Boolean         @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  nomorBukti      String?
  createdByUser   User?           @relation("PengeluaranCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?           @relation("PengeluaranUpdatedBy", fields: [updatedBy], references: [id])

  @@index([tanggal])
  @@index([kategori])
  @@index([tipePengeluaran])
  @@index([budgetId])
  @@index([isApproved])
}

model Pemasukan {
  id            String    @id @default(cuid())
  tanggal       DateTime
  kategori      String
  deskripsi     String
  jumlah        BigInt
  metodeBayar   String?
  catatan       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  isVerified    Boolean   @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?
  nomorBukti    String?
  createdByUser User?     @relation("PemasukanCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?     @relation("PemasukanUpdatedBy", fields: [updatedBy], references: [id])

  @@index([tanggal])
  @@index([kategori])
  @@index([isVerified])
}

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String?
  encrypted   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model OAuthProviderConfig {
  id           String    @id @default(cuid())
  provider     String    @unique
  providerName String
  isEnabled    Boolean   @default(false)
  isProduction Boolean   @default(false)
  priority     Int       @default(0)
  clientId     String?
  clientSecret String?
  tenantId     String?
  scope        String?
  redirectUri  String?
  settings     Json?
  lastTestedAt DateTime?
  testStatus   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?

  @@index([provider])
  @@index([isEnabled])
  @@index([priority])
  @@map("oauth_provider_configs")
}

model BankAccount {
  id              String           @id @default(cuid())
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  mataUang        String           @default("IDR")
  namaBank        String
  namaPemilik     String
  nomorRekening   String
  saldoAwal       BigInt
  saldoSaatIni    BigInt
  updatedBy       String?
  createdByUser   User?            @relation("BankAccountCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?            @relation("BankAccountUpdatedBy", fields: [updatedBy], references: [id])
  statements      BankStatement[]
  reconciliations Reconciliation[]
  transactions    Transaction[]
}

model BankStatement {
  id                  String                @id @default(cuid())
  bankAccountId       String
  transactionDate     DateTime
  description         String
  reference           String?
  debit               BigInt                @default(0)
  credit              BigInt                @default(0)
  balance             BigInt
  isReconciled        Boolean               @default(false)
  reconciledAt        DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  bankAccount         BankAccount           @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  reconciliationMatch ReconciliationMatch[]

  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([isReconciled])
  @@index([bankAccountId, transactionDate])
}

model Reconciliation {
  id                String      @id @default(cuid())
  bankAccountId     String
  month             Int
  year              Int
  openingBalance    BigInt
  closingBalance    BigInt
  totalDeposits     BigInt
  totalWithdrawals  BigInt
  systemDeposits    BigInt
  systemWithdrawals BigInt
  difference        BigInt
