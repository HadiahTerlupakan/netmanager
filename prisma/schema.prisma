generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  FINANCE
}

enum Status {
  AKTIF
  NONAKTIF
  MAINTENANCE
}

enum DurasiUnit {
  JAM
  HARI
  BULAN
  TAHUN
}

enum DiscountType {
  FIXED
  PERCENT
}

enum TipePelanggan {
  REGULER
  NON_REGULER
}

enum TagihanStatus {
  BELUM_LUNAS
  LUNAS
  TERLAMBAT
}

enum TipePengeluaran {
  CAPEX
  OPEX
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  
  pengeluaransCreated Pengeluaran[] @relation("PengeluaranCreatedBy")
  pengeluaransUpdated Pengeluaran[] @relation("PengeluaranUpdatedBy")
  pemasukansCreated  Pemasukan[] @relation("PemasukanCreatedBy")
  pemasukansUpdated  Pemasukan[] @relation("PemasukanUpdatedBy")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Olt {
  id                 String    @id @default(cuid())
  name               String
  ipAddress          String
  type               String // e.g., ZTE-C300
  version            String? // e.g., C300 Version V2.1.0 Software
  temperature        Int? // in Celsius
  connectedDevices   Int       @default(0)
  model              String? // device model
  uptime             String? // e.g., "17 days 14 hours 26 minutes"
  syncStatus         String    @default("0") // percentage
  syncDate           DateTime?
  telnetConnected    Boolean   @default(false)
  snmpConnected      Boolean   @default(false)
  // SNMP Configuration
  snmpCommunityWrite String    @default("public")
  snmpVersion        String    @default("2")
  snmpPort           Int       @default(161)
  // Telnet Configuration
  telnetUsername     String    @default("zte")
  telnetPassword     String
  telnetPort         Int       @default(23)
  // ONU Sync Configuration
  onuLastSync        DateTime? // Waktu terakhir sync ONU data dari SNMP
  onuSyncEnabled     Boolean   @default(true) // Enable/disable auto sync ONU
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  onus          Onu[] // Relasi ke ONU
  onuTypes      OnuType[] // Relasi ke OnuType
  speedProfiles SpeedProfile[] // Relasi ke SpeedProfile

  @@unique([ipAddress])
}

model Otb {
  id                        String   @id @default(cuid())
  name                      String
  location                  String?
  coreCount                 Int
  notes                     String?
  keteranganJumlahKabelFeeder String?
  latitude                  Float?
  longitude                 Float?
  status                    Status   @default(AKTIF)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  cores OtbCore[]
}

model OtbCore {
  id        String @id @default(cuid())
  otbId     String
  otb       Otb    @relation(fields: [otbId], references: [id], onDelete: Restrict)
  idx       Int
  slotName  String
  tubeColor String
  coreColor String

  // Back relation: satu slot OTB dapat memiliki satu ODC terhubung
  odc Odc?

  @@unique([otbId, idx])
}

model Odc {
  id                        String   @id @default(cuid())
  name                      String
  location                  String?
  notes                     String?
  keteranganJumlahKabelFeeder String?
  latitude                  Float?
  longitude                 Float?
  status                    Status   @default(AKTIF)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relasi ke slot OTB (OtbCore). Satu ODC menempati satu slot OTB sebagai INPUT.
  otbCoreId String  @unique
  otbCore   OtbCore @relation(fields: [otbCoreId], references: [id], onDelete: Restrict)

  // OUTPUT: Banyak output cores dari ODC ini
  outputs OdcOutput[]
}

model OdcOutput {
  id        String @id @default(cuid())
  odcId     String
  odc       Odc    @relation(fields: [odcId], references: [id], onDelete: Restrict)
  idx       Int // Urutan output core (0-based)
  slotName  String // Nama slot output
  redaman   Float? // Redaman dalam dB (opsional)
  tubeColor String // Warna tube
  coreColor String // Warna core

  // Back relation: satu output core bisa dipakai 0..1 ODP
  odp Odp?

  @@unique([odcId, idx])
}

model Odp {
  id                        String   @id @default(cuid())
  name                      String
  location                  String?
  notes                     String?
  keteranganJumlahKabelFeeder String?
  latitude                  Float?
  longitude                 Float?
  status                    Status   @default(AKTIF)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relasi INPUT: ODP mengambil input dari salah satu output core ODC
  odcOutputId String    @unique
  odcOutput   OdcOutput @relation(fields: [odcOutputId], references: [id], onDelete: Restrict)

  // OUTPUT: Banyak output cores dari ODP ini
  outputs OdpOutput[]

  // Relasi ke Pelanggan
  pelanggans Pelanggan[]
}

model OdpOutput {
  id        String @id @default(cuid())
  odpId     String
  odp       Odp    @relation(fields: [odpId], references: [id], onDelete: Restrict)
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String

  @@unique([odpId, idx])
}

// JOINbox (Bridge/Closure) models
model Joinbox {
  id                        String   @id @default(cuid())
  name                      String
  location                  String?
  notes                     String?
  keteranganJumlahKabelFeeder String?
  latitude                  Float?
  longitude                 Float?
  status                    Status   @default(AKTIF)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  inputs  JoinboxInput[]
  outputs JoinboxOutput[]
}

model JoinboxInput {
  id        String  @id @default(cuid())
  joinboxId String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id], onDelete: Restrict)
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String

  @@unique([joinboxId, idx])
}

model JoinboxOutput {
  id        String  @id @default(cuid())
  joinboxId String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id], onDelete: Restrict)
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String

  @@unique([joinboxId, idx])
}

model Pole {
  id         String   @id @default(cuid())
  name       String
  location   String?
  notes      String?
  latitude   Float?
  longitude  Float?
  cableSlack Boolean  @default(false)
  status     Status   @default(AKTIF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KmzFile {
  id          String   @id @default(cuid())
  name        String
  filename    String
  filePath    String // Path ke file KML hasil ekstrak
  fileSize    Int // Size dalam bytes
  description String?
  lineColor   String   @default("#3388ff") // Warna garis KMZ (hex color)
  isActive    Boolean  @default(true)
  status      Status   @default(AKTIF)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ONU (Optical Network Unit) - Data dari SNMP OLT
model Onu {
  id           String    @id @default(cuid())
  oltId        String
  olt          Olt       @relation(fields: [oltId], references: [id], onDelete: Cascade)
  name         String // ONU name/identifier
  description  String? // ONU description
  pppoe        String? // PPPoE username (jika ada)
  gponOnu      String // Format: "slot/port:onuId" atau "1/3/1:3"
  status       String // Online, LOS, DyingGasp, OffLine, Unknown
  rxOlt        String? // RX power dari OLT (dBm)
  rxOnu        String? // RX power dari ONU (dBm)
  txOlt        String? // TX power ke OLT (dBm)
  txOnu        String? // TX power dari ONU (dBm)
  serialNumber String? // Serial number ONU
  actualType   String? // ONU type/model
  registerTime DateTime? // Waktu registrasi ONU
  distance     Float? // Jarak fiber dalam km (dihitung dari signal)
  lastSeen     DateTime? // Waktu terakhir komunikasi

  // Basic Info Fields (OID: 1.3.6.1.4.1.3902.1012.3.28.1.1.12, etc)
  registrationMode String? // Registration mode (SN, Password, LOID, dll)
  softwareVersion  String? // Software version ONU
  hardwareVersion  String? // Hardware version ONU
  temperature      Float? // Temperature in Celsius
  laserBiasCurrent Float? // Laser bias current in mA

  // New fields from ZTE-AN-PON-MIB (OID: 1.3.6.1.4.1.3902.1082.50.10.2.2)
  vendorId               String? // ONU vendor ID (zxAnOnuVendorId)
  equipmentId            String? // ONU equipment ID (zxAnOnuEquipmentId)
  firmwareVersion        String? // Firmware version (zxAnOnuFirmwareVersion)
  macAddress             String? // ONU MAC address (zxAnOnuMacAddress)
  batteryStatus          String? // Battery status (zxAnOnuBatteryStatus)
  opticalTransceiverType String? // Optical transceiver type (zxAnOnuOpticalTransceiverType)
  lastDeregTime          DateTime? // Last deregistration time (zxAnOnuLastDeregTime)
  authMode               String? // Authentication mode (zxAnOnuAuthMode)
  loid                   String? // Logical ONU ID (zxAnOnuLoid)
  password               String? // ONU password (zxAnOnuPassword)

  // ONU Status fields (OID: 1.3.6.1.4.1.3902.1082.50.10.2.3)
  configState   String? // Configuration state (zxAnOnuConfigState)
  powerLevel    String? // Power level (zxAnOnuPowerLevel)
  dyingGaspTime DateTime? // Dying gasp time (zxAnOnuDyingGaspTime)

  // Additional optical power status (OID: 1.3.6.1.4.1.3902.1082.50.10.2.28)
  rxPowerStatus String? // RX power status (zxAnOnuRxPowerStatus)
  txPowerStatus String? // TX power status (zxAnOnuTxPowerStatus)

  // Performance Statistics (OID: 1.3.6.1.4.1.3902.1082.50.10.2.31)
  rxBytes   BigInt? // Total bytes received (zxAnGponOnuPonRxBytes)
  txBytes   BigInt? // Total bytes transmitted (zxAnGponOnuPonTxBytes)
  rxPackets BigInt? // Total packets received (zxAnGponOnuPonRxPackets)
  txPackets BigInt? // Total packets transmitted (zxAnGponOnuPonTxPackets)
  rxErrors  BigInt? // Total RX errors (zxAnGponOnuPonRxErrors)
  txErrors  BigInt? // Total TX errors (zxAnGponOnuPonTxErrors)
  rxDrops   BigInt? // Total RX drops (zxAnGponOnuPonRxDrops)
  txDrops   BigInt? // Total TX drops (zxAnGponOnuPonTxDrops)

  // WiFi Configuration (OID: 1.3.6.1.4.1.3902.1082.50.10.2.20)
  wifiEnable       Boolean? // WiFi enable status (zxAnOnuWifiEnable)
  wifiSsid         String? // WiFi SSID (zxAnOnuWifiSsid)
  wifiSecurityMode String? // WiFi security mode (zxAnOnuWifiSecurityMode)
  wifiChannel      Int? // WiFi channel (zxAnOnuWifiChannel)

  // SNMP OID fields - untuk fast SNMP GET tanpa perlu menghitung composite index
  statusOid      String? // Full OID untuk status (e.g., "1.3.6.1.4.1.3902.1012.3.28.2.1.4.268566528.3")
  rxOltOid       String? // Full OID untuk RX OLT
  rxOnuOid       String? // Full OID untuk RX ONU
  nameOid        String? // Full OID untuk name
  descOid        String? // Full OID untuk description
  compositeIndex Int? // Composite index untuk backup (jika OID tidak tersedia)

  lastUpdate DateTime @default(now()) // Waktu terakhir data di-update dari SNMP
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([oltId, gponOnu]) // Satu ONU unik per OLT berdasarkan gponOnu
  
  // Single-column indexes for basic queries
  @@index([oltId])
  @@index([status])
  @@index([lastUpdate])
  @@index([registerTime])
  @@index([lastSeen])
  @@index([serialNumber])
  @@index([macAddress])
  
  // Composite indexes for optimized filtering & sorting (Phase 5)
  @@index([oltId, status]) // Filter by OLT + status (very common query)
  @@index([oltId, lastUpdate]) // OLT list sorted by update time
  @@index([status, lastUpdate]) // Status filter sorted by update
  @@index([oltId, gponOnu]) // Fast lookup by OLT + gponOnu (alternative to unique)
}

// ONU Type - Tipe ONU yang didukung per OLT
model OnuType {
  id                    String   @id @default(cuid())
  oltId                 String
  olt                   Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)
  name                  String // Nama tipe ONU (e.g., "ZTE", "H640GW", "HG8245H")
  ethernetPorts         Int      @default(0) // Jumlah port Ethernet
  wifi                  Int      @default(0) // Jumlah WiFi
  voipPorts             Int      @default(0) // Jumlah port VoIP
  // Detail dari show onu-type
  ponType               String? // PON type (e.g., "gpon")
  description           String? // Description
  maxTcont              Int? // Max T-CONT
  maxGemPort            Int? // Max GEM port
  maxSwitchPerSlot      Int? // Max switch per slot
  maxFlowPerSwitch      Int? // Max flow per switch
  maxIpHost             Int? // Max IP host
  maxIpv6Host           Int? // Max IPv6 host
  serviceAbilityN1      String? // Service ability N:1 (e.g., "support")
  serviceAbility1M      String? // Service ability 1:M (e.g., "support")
  serviceAbility1P      String? // Service ability 1:P (e.g., "support")
  wifiMgmtViaNonOmci    String? // WIFI mgmt via non OMCI (e.g., "disable")
  omciSendMode          String? // OMCI send mode (e.g., "async")
  defaultMulticastRange String? // Default multicast range (e.g., "none")
  vrg                   String? // VRG (e.g., "disable")
  mgcConfigureMode      String? // MGC configure mode (e.g., "zte")
  maxVeip               Int? // Max VEIP
  extendedOmci          String? // Extended OMCI (e.g., "disable")
  location              String? // Location (e.g., "disable")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([oltId, name]) // Satu tipe ONU unik per OLT berdasarkan name
  @@index([oltId])
}

// Speed Profile - Profil kecepatan untuk OLT
model SpeedProfile {
  id           String   @id @default(cuid())
  oltId        String
  olt          Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)
  profileType  String   @default("Download") // "Download" atau "Upload"
  name         String // Nama profil (e.g., "1G", "10Mbps", "20Mbps")
  type         Int // Tipe bandwidth: 1-5 (Fixed, Assured, dll)
  bandwidthSir Int // Bandwidth SIR dalam kbps
  burstPir     Int // Burst PIR dalam kbps
  fixed        Int? // Fixed bandwidth dalam kbps (jika type = 1)
  assured      Int? // Assured bandwidth dalam kbps (jika type = 2 atau 3)
  maximum      Int? // Maximum bandwidth dalam kbps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([oltId, profileType, name]) // Satu profil unik per OLT berdasarkan profileType dan name
  @@index([oltId])
  @@index([profileType])
}

// MikroTik Router [NAS]
model MikroTikRouter {
  id              String    @id @default(cuid())
  name            String // Nama Router
  ipAddress       String // IP Router atau domain
  timezone        String    @default("+07:00 Asia/Jakarta") // Zona Waktu
  apiPort         Int       @default(8728) // Port API
  apiUsername     String // Username API
  apiPassword     String // Password API
  authPort        Int       @default(7265) // Authentication Port
  accountingPort  Int       @default(7266) // Accounting Port
  secretRadius    String // Secret Radius
  isolirUrl       String? // URL Info Isolir (optional)
  description     String? // Deskripsi
  pingStatus      String    @default("offline") // Status ping: "online" atau "offline"
  userOnline      Int       @default(0) // Jumlah user online
  lastStatusCheck DateTime? // Waktu terakhir cek status
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profilePPPs ProfilePPP[] // Profile PPP yang menggunakan router ini sebagai target

  @@unique([ipAddress])
  @@index([pingStatus])
}

// Bandwidth - Profil bandwidth untuk paket internet (sesuai format Queue MikroTik)
model Bandwidth {
  id                     String   @id @default(cuid())
  name                   String   @unique // Nama bandwidth (e.g., "10 Mbps", "20 Mbps", "100 Mbps")
  // Max Limit (wajib)
  maxLimitDownload       String // Max Limit Download (format: "10M" atau "10240k")
  maxLimitUpload         String // Max Limit Upload (format: "10M" atau "10240k")
  // Burst Limit (opsional)
  burstLimitDownload     String? // Burst Limit Download (format: "15M" atau "15360k")
  burstLimitUpload       String? // Burst Limit Upload (format: "15M" atau "15360k")
  // Min Limit (opsional)
  minLimitDownload       String? // Min Limit Download (format: "5M" atau "5120k")
  minLimitUpload         String? // Min Limit Upload (format: "5M" atau "5120k")
  // Burst Threshold (opsional)
  burstThresholdDownload String? // Burst Threshold Download (format: "12M" atau "12288k")
  burstThresholdUpload   String? // Burst Threshold Upload (format: "12M" atau "12288k")
  // Burst Time (opsional, dalam detik)
  burstTimeDownload      Int? // Burst Time Download (dalam detik)
  burstTimeUpload        Int? // Burst Time Upload (dalam detik)
  // Priority (opsional, 1-8)
  priority               Int? // Priority (1-8, default: 8)
  // Legacy fields (untuk backward compatibility)
  uploadSpeed            Int? // Kecepatan upload dalam kbps (deprecated, gunakan maxLimitUpload)
  downloadSpeed          Int? // Kecepatan download dalam kbps (deprecated, gunakan maxLimitDownload)
  description            String? // Deskripsi bandwidth
  status                 Status   @default(AKTIF)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  hargaPakets HargaPaket[]
}

// ProfilePPP - Profil PPPoE untuk autentikasi
model ProfilePPP {
  id               String          @id @default(cuid())
  name             String          @unique // Nama profile PPP (e.g., "Profile-10M", "Profile-20M")
  localAddress     String // Local IP address pool
  remoteAddress    String // Remote IP address pool
  dnsServer        String? // DNS Server (e.g., "8.8.8.8,8.8.4.4")
  sessionTimeout   Int? // Session timeout dalam detik
  idleTimeout      Int? // Idle timeout dalam detik
  // Rate limit diambil dari Bandwidth yang terkait melalui HargaPaket
  mikroTikRouterId String? // Target MikroTik Router (optional)
  mikroTikRouter   MikroTikRouter? @relation(fields: [mikroTikRouterId], references: [id], onDelete: SetNull)
  description      String? // Deskripsi profile
  status           Status          @default(AKTIF)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  hargaPakets HargaPaket[]

  @@index([mikroTikRouterId])
}

// HargaPaket - Daftar paket internet dengan harga
model HargaPaket {
  id                   String        @id @default(cuid())
  name                 String        @unique // Nama paket (e.g., "Paket 10 Mbps", "Paket Gaming")
  bandwidthId          String? // Bandwidth (opsional, rate limit diambil dari Profile PPP)
  bandwidth            Bandwidth?    @relation(fields: [bandwidthId], references: [id], onDelete: SetNull)
  profilePPPId         String
  profilePPP           ProfilePPP    @relation(fields: [profilePPPId], references: [id], onDelete: Restrict)
  harga                Int // Harga dalam rupiah
  durasi               Int           @default(30) // Durasi (nilai numerik)
  durasiUnit           DurasiUnit    @default(HARI) // Unit durasi: JAM, HARI, atau BULAN
  usePPN               Boolean       @default(false) // Gunakan PPN atau tidak
  ppnPercentage        Float? // Persentase PPN (jika usePPN = true)
  useDiscount          Boolean       @default(false) // Gunakan diskon atau tidak
  discountType         DiscountType? // Jenis diskon: FIXED atau PERCENT
  discountValue        Float? // Nilai diskon (nominal jika FIXED, persentase jika PERCENT)
  discountDuration     Int? // Durasi diskon berlaku (nilai numerik)
  discountDurationUnit DurasiUnit? // Unit durasi diskon: JAM, HARI, BULAN, atau TAHUN
  description          String? // Deskripsi paket
  featured             Boolean       @default(false) // Paket unggulan
  status               Status        @default(AKTIF)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  pelanggans Pelanggan[] // Relasi ke Pelanggan

  @@index([bandwidthId])
  @@index([profilePPPId])
  @@index([status])
  @@index([featured])
}

// Pelanggan - Data pelanggan PPPoE
model Pelanggan {
  id                            String        @id @default(cuid())
  idPelanggan                   String        @unique // ID Pelanggan 8 digit (unique)
  nama                          String // Nama lengkap pelanggan
  username                      String // Username PPPoE
  password                      String // Password PPPoE (untuk koneksi PPPoE)
  passwordLogin                 String // Password Login Portal (untuk login di portal pelanggan)
  hargaPaketId                  String
  hargaPaket                    HargaPaket    @relation(fields: [hargaPaketId], references: [id], onDelete: Restrict)
  tipe                          TipePelanggan @default(REGULER) // Tipe pelanggan: REGULER atau NON_REGULER
  tanggalAktif                  DateTime // Tanggal aktif layanan
  jatuhTempo                    DateTime // Tanggal jatuh tempo pembayaran
  status                        Status        @default(AKTIF) // Status: AKTIF, NONAKTIF, MAINTENANCE
  alamat                        String? // Alamat pelanggan
  provinsi                      String? // Provinsi
  kabupatenKota                 String? // Kabupaten/Kota
  kelurahanDesa                 String? // Kelurahan/Desa
  kecamatan                     String? // Kecamatan
  noTelp                        String? // Nomor telepon
  email                         String? // Email pelanggan
  latitude                      Float? // Titik koordinat latitude
  longitude                     Float? // Titik koordinat longitude
  jenisDokumen                  String? // Jenis dokumen: KTP, SIM, atau Paspor
  noDokumen                     String? // Nomor dokumen (KTP/SIM/Paspor)
  fileKTP                       String? // Path file KTP
  fileRumahSekitar              String? // Path file Rumah Sekitar
  fileBAST                      String? // Path file BAST
  catatan                       String? // Catatan tambahan
  usePPN                        Boolean       @default(true) // Gunakan PPN atau tidak
  useDiscount                   Boolean       @default(false) // Gunakan diskon atau tidak
  useProrate                    Boolean       @default(false) // Gunakan perhitungan prorate atau tidak
  // Custom diskon per pelanggan (jika diisi, akan override diskon dari paket)
  discountType                  DiscountType? // Jenis diskon custom: FIXED atau PERCENT
  discountValue                 Float? // Nilai diskon custom (nominal jika FIXED, persentase jika PERCENT)
  discountDuration              Int? // Durasi diskon custom berlaku (nilai numerik)
  discountDurationUnit          DurasiUnit? // Unit durasi diskon custom: JAM, HARI, BULAN, atau TAHUN
  // Biaya lain-lain
  biayaInstalasi                Int? // Biaya instalasi (opsional)
  biayaInstalasiIsRecurring     Boolean       @default(false) // Apakah biaya instalasi berulang atau 1x
  biayaInstalasiDiskon          Float? // Diskon persentase untuk biaya instalasi (opsional)
  biayaSewaPerangkat            Int? // Biaya sewa perangkat (opsional)
  biayaSewaPerangkatIsRecurring Boolean       @default(true) // Apakah biaya sewa perangkat berulang atau 1x (default: berulang)
  biayaSewaPerangkatDiskon      Float? // Diskon persentase untuk sewa perangkat (opsional)
  biayaLainnya                  Int? // Biaya lain-lain (opsional)
  biayaLainnyaIsRecurring       Boolean       @default(false) // Apakah biaya lain-lain berulang atau 1x
  biayaLainnyaDiskon            Float? // Diskon persentase untuk biaya lain-lain (opsional)
  keteranganBiayaLainnya        String? // Keterangan untuk biaya lain-lain
  odpId                         String? // ODP yang digunakan pelanggan (opsional)
  odp                           Odp?          @relation(fields: [odpId], references: [id], onDelete: SetNull)
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  tagihans Tagihan[] // Relasi ke Tagihan

  @@index([idPelanggan])
  @@index([hargaPaketId])
  @@index([status])
  @@index([tipe])
  @@index([tanggalAktif])
  @@index([jatuhTempo])
  @@index([email])
}

// Tagihan - Data tagihan pelanggan
model Tagihan {
  id                String         @id @default(cuid())
  pelangganId       String
  pelanggan         Pelanggan      @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  noTagihan         String         @unique // Nomor tagihan (format: TAG-YYYYMM-XXXX)
  periodeBulan      Int // 1-12
  periodeTahun      Int // 2024, 2025, dll
  // Rincian tagihan
  subtotal          Int // Subtotal sebelum PPN dan diskon
  diskon            Int @default(0) // Jumlah diskon
  ppn               Int @default(0) // Jumlah PPN
  biayaInstalasi    Int @default(0) // Biaya instalasi (jika recurring)
  biayaSewaPerangkat Int @default(0) // Biaya sewa perangkat (jika recurring)
  biayaLainnya      Int @default(0) // Biaya lain-lain (jika recurring)
  total             Int // Total tagihan (subtotal - diskon + ppn + biaya tambahan)
  // Status dan tanggal
  status            TagihanStatus  @default(BELUM_LUNAS)
  jatuhTempo        DateTime // Tanggal jatuh tempo pembayaran
  tanggalBayar      DateTime? // Tanggal pembayaran (jika sudah dibayar)
  metodePembayaran  String? // Metode pembayaran (e.g., "TRANSFER", "CASH", "OVO", dll)
  catatan           String? // Catatan tambahan
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  paymentTransactions PaymentGatewayTransaction[]
  paymentLink         PaymentLink?

  @@unique([pelangganId, periodeBulan, periodeTahun]) // Satu tagihan per pelanggan per periode
  @@index([pelangganId])
  @@index([status])
  @@index([jatuhTempo])
  @@index([noTagihan])
  @@index([periodeBulan, periodeTahun])
  @@index([createdAt])
}

// ============================================
// PAYMENT GATEWAY TABLES
// ============================================

// Payment Gateway Configuration (Multi-provider support)
model PaymentGatewayConfig {
  id              String   @id @default(cuid())
  
  // Provider identification
  provider        String   @unique // "XENDIT", "MIDTRANS", "DUITKU", "BCA_API", "DANA_API"
  providerName    String   // Display name: "Xendit", "Midtrans", etc.
  
  // Configuration
  isEnabled       Boolean  @default(false)
  isProduction    Boolean  @default(false) // Sandbox vs Production
  priority        Int      @default(0) // Higher = preferred (for auto-routing)
  
  // API Credentials (ENCRYPTED!)
  apiKey          String?  // Main API key/Server key (encrypted)
  apiSecret       String?  // Secret key (encrypted, if applicable)
  clientKey       String?  // Client key (for frontend, if applicable)
  merchantId      String?  // Merchant/Account ID
  
  // Additional settings
  webhookUrl      String?  // Auto-generated webhook URL
  callbackUrl     String?  // Payment callback URL
  
  // Provider-specific settings (JSON)
  settings        Json?    // { "enabledMethods": ["bank_transfer", "ewallet"], "fees": {...} }
  
  // Metadata
  lastTestedAt    DateTime? // Last successful test
  testStatus      String?   // "SUCCESS", "FAILED", error message
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?  // Admin user ID
  
  // Relations
  transactions    PaymentGatewayTransaction[]
  
  @@index([provider])
  @@index([isEnabled])
  @@index([priority])
}

// Payment Gateway Transactions
model PaymentGatewayTransaction {
  id                String    @id @default(cuid())
  
  // Gateway details
  provider          String    // "XENDIT", "MIDTRANS", etc.
  providerConfig    PaymentGatewayConfig @relation(fields: [provider], references: [provider])
  orderId           String    @unique // Our internal order ID (TAG-XXX-YYY)
  transactionId     String?   @unique // Gateway's transaction ID
  
  // Payment details
  tagihanId         String    // Link to invoice
  tagihan           Tagihan   @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  amount            BigInt    // Amount in rupiah
  paymentMethod     String?   // "bank_transfer", "gopay", "credit_card", etc.
  bankCode          String?   // "bca", "mandiri", "bni", etc.
  
  // Status tracking
  status            String    @default("PENDING") // PENDING, PAID, EXPIRED, CANCELLED, FAILED
  paidAt            DateTime? // When payment completed
  expiredAt         DateTime? // Payment link expiry
  
  // Gateway response
  paymentUrl        String?   // Payment page URL
  qrCodeUrl         String?   // For QRIS/e-wallet
  vaNumber          String?   // Virtual account number (for bank transfer)
  
  // Webhook data
  webhookReceived   Boolean   @default(false)
  webhookData       Json?     // Store raw webhook payload
  
  // Metadata
  customerEmail     String?
  customerPhone     String?
  notes             String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tagihanId])
  @@index([status])
  @@index([orderId])
  @@index([transactionId])
  @@index([createdAt])
}

// Payment Links (Persistent links for customer portal)
model PaymentLink {
  id            String   @id @default(cuid())
  
  tagihanId     String   @unique // One link per invoice
  tagihan       Tagihan  @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  
  linkToken     String   @unique // URL-safe token for public link
  paymentUrl    String   // Full payment URL
  
  isActive      Boolean  @default(true)
  expiresAt     DateTime? // Optional expiry
  
  // Track usage
  viewCount     Int      @default(0) // How many times opened
  lastViewedAt  DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([linkToken])
  @@index([tagihanId])
}

// Pengeluaran - Data pengeluaran untuk cashflow
model Pengeluaran {
  id            String          @id @default(cuid())
  tanggal       DateTime        // Tanggal pengeluaran
  tipePengeluaran TipePengeluaran @default(OPEX) // CAPEX atau OPEX
  kategori      String          // Kategori pengeluaran (e.g., "OPERASIONAL", "PEMELIHARAAN", "GAJI", dll)
  deskripsi     String          // Deskripsi pengeluaran
  jumlah        BigInt          // Jumlah pengeluaran (dalam rupiah)
  metodeBayar   String?         // Metode pembayaran (e.g., "TRANSFER", "CASH", dll)
  catatan       String?         // Catatan tambahan
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     String?         // User ID yang membuat (optional)
  updatedBy     String?         // User ID yang update terakhir (optional)
  
  // Budget tracking
  budgetId      String?         // Link to budget for tracking
  
  // Approval workflow
  isApproved    Boolean         @default(false)
  approvedBy    String?         // User ID yang approve
  approvedAt    DateTime?       // Waktu approval
  
  createdByUser User? @relation("PengeluaranCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("PengeluaranUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tanggal])
  @@index([kategori])
  @@index([tipePengeluaran])
  @@index([budgetId])
  @@index([isApproved])
}

// Pemasukan - Data pemasukan manual untuk cashflow
model Pemasukan {
  id          String   @id @default(cuid())
  tanggal     DateTime // Tanggal pemasukan
  kategori    String   // Kategori pemasukan (e.g., "PENJUALAN", "INVESTASI", "BONUS", "LAINNYA", dll)
  deskripsi   String   // Deskripsi pemasukan
  jumlah     BigInt   // Jumlah pemasukan (dalam rupiah)
  metodeBayar String? // Metode pembayaran (e.g., "TRANSFER", "CASH", dll)
  catatan     String? // Catatan tambahan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  // User ID yang membuat (optional)
  updatedBy   String?  // User ID yang update terakhir (optional)
  
  // Verification workflow
  isVerified  Boolean  @default(false)
  verifiedBy  String?  // User ID yang verify
  verifiedAt  DateTime? // Waktu verification
  
  createdByUser User? @relation("PemasukanCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("PemasukanUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tanggal])
  @@index([kategori])
  @@index([isVerified])
}

// Settings - Konfigurasi aplikasi
model Settings {
  id          String   @id @default(cuid())
  key         String   @unique // Key pengaturan (e.g., "GOOGLE_GEMINI_API_KEY")
  value       String? // Value pengaturan (bisa null untuk rahasia)
  encrypted   Boolean  @default(false) // Apakah value di-encrypt
  description String? // Deskripsi pengaturan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ============================================
// FINANCE MODULES - AR, Bank Reconciliation, MRR/ARR
// ============================================

// BankAccount - Support multiple bank accounts
model BankAccount {
  id              String   @id @default(cuid())
  accountName     String   // e.g., "BCA Operasional", "Mandiri Payroll"
  bankName        String   // e.g., "BCA", "Mandiri", "BRI"
  accountNumber   String   @unique
  accountType     String   @default("CHECKING") // CHECKING, SAVINGS, E_WALLET
  balance         BigInt   @default(0) // Current balance in system
  currency        String   @default("IDR")
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  statements      BankStatement[]
  reconciliations Reconciliation[]

  @@index([bankName])
  @@index([isActive])
}

// BankStatement - Imported from bank
model BankStatement {
  id                String    @id @default(cuid())
  bankAccountId     String
  bankAccount       BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactionDate   DateTime
  description       String
  reference         String?   // Bank reference number
  debit             BigInt    @default(0) // Money out
  credit            BigInt    @default(0) // Money in
  balance           BigInt    // Balance after this transaction
  isReconciled      Boolean   @default(false)
  reconciledAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reconciliationMatch ReconciliationMatch[]

  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([isReconciled])
  @@index([bankAccountId, transactionDate])
}

// Reconciliation - Monthly reconciliation records
model Reconciliation {
  id                String      @id @default(cuid())
  bankAccountId     String
  bankAccount       BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  month             Int         // 1-12
  year              Int         // 2024, 2025
  openingBalance    BigInt
  closingBalance    BigInt
  totalDeposits     BigInt      // Total in dari bank statement
  totalWithdrawals  BigInt      // Total out dari bank statement
  systemDeposits    BigInt      // Total in dari system (Invoice payments)
  systemWithdrawals BigInt      // Total out dari system (Expenses)
  difference        BigInt      // Should be 0 when reconciled
  isCompleted       Boolean     @default(false)
  completedAt       DateTime?
  completedBy       String?     // User ID
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([bankAccountId, month, year])
  @@index([bankAccountId])
  @@index([year, month])
}

// ReconciliationMatch - Mapping between bank statements and system records
model ReconciliationMatch {
  id                String         @id @default(cuid())
  bankStatementId   String
  bankStatement     BankStatement  @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  matchType         String         // "PAYMENT_IN", "PAYMENT_OUT", "INTERNAL_TRANSFER"
  matchedEntityType String         // "TAGIHAN", "PENGELUARAN", "PEMASUKAN"
  matchedEntityId   String         // ID of Tagihan/Pengeluaran/Pemasukan
  confidence        Float          @default(1.0) // 0.0-1.0, for auto-matching
  notes             String?
  matchedBy         String?        // User ID (null for auto-match)
  createdAt         DateTime       @default(now())

  @@index([bankStatementId])
  @@index([matchedEntityType, matchedEntityId])
}

// CollectionTask - Tasks untuk follow-up piutang
model CollectionTask {
  id              String   @id @default(cuid())
  pelangganId     String
  tagihanId       String?  // Optional, bisa untuk specific tagihan
  assignedTo      String?  // User ID
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  dueDate         DateTime
  notes           String?
  resolution      String?  // Notes ketika task completed
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  followUps       CollectionFollowUp[]

  @@index([pelangganId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
}

// CollectionFollowUp - Log komunikasi dengan pelanggan
model CollectionFollowUp {
  id                String          @id @default(cuid())
  collectionTaskId  String
  collectionTask    CollectionTask  @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  method            String          // "PHONE", "WHATSAPP", "EMAIL", "SMS", "VISIT"
  notes             String          // Isi komunikasi
  response          String?         // Response dari pelanggan
  followUpBy        String?         // User ID
  followUpAt        DateTime        @default(now())

  @@index([collectionTaskId])
  @@index([followUpAt])
}

// Payment - Track payment details (enhancement to existing flow)
model Payment {
  id              String    @id @default(cuid())
  tagihanId       String?   // Optional, payment could be for multiple tagihan
  pelangganId     String
  amount          BigInt
  paymentDate     DateTime
  paymentMethod   String    // "TRANSFER", "CASH", "OVO", "GOPAY", etc.
  bankAccountId   String?   // Which bank account received this payment
  reference       String?   // Payment reference number
  notes           String?
  verifiedBy      String?   // User ID who verified
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tagihanId])
  @@index([pelangganId])
  @@index([paymentDate])
  @@index([bankAccountId])
}

// ARAgingSnapshot - Historical aging data for trending
model ARAgingSnapshot {
  id              String   @id @default(cuid())
  snapshotDate    DateTime @default(now())
  current         BigInt   @default(0) // 0-30 days
  overdue30       BigInt   @default(0) // 31-60 days
  overdue60       BigInt   @default(0) // 61-90 days
  overdue90       BigInt   @default(0) // 90+ days
  totalOutstanding BigInt  @default(0)
  totalCustomers  Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([snapshotDate])
}

// MRRMovement - Track MRR changes
model MRRMovement {
  id              String   @id @default(cuid())
  month           Int      // 1-12
  year            Int
  movementType    String   // "NEW", "EXPANSION", "CONTRACTION", "CHURN", "REACTIVATION"
  pelangganId     String?  // Optional, for tracking specific customer
  amount          BigInt   // Amount of MRR change
  description     String?
  createdAt       DateTime @default(now())

  @@index([year, month])
  @@index([movementType])
  @@index([pelangganId])
}

// RevenueSnapshot - Daily/Monthly revenue aggregates
model RevenueSnapshot {
  id                    String   @id @default(cuid())
  snapshotDate          DateTime
  snapshotType          String   @default("DAILY") // DAILY, MONTHLY
  totalMRR              BigInt   @default(0)
  totalARR              BigInt   @default(0)
  newMRR                BigInt   @default(0)
  expansionMRR          BigInt   @default(0)
  contractionMRR        BigInt   @default(0)
  churnMRR              BigInt   @default(0)
  reactivationMRR       BigInt   @default(0)
  activeCustomers       Int      @default(0)
  newCustomers          Int      @default(0)
  churnedCustomers      Int      @default(0)
  arpu                  Int      @default(0) // Average Revenue Per User
  createdAt             DateTime @default(now())

  @@unique([snapshotDate, snapshotType])
  @@index([snapshotDate])
  @@index([snapshotType])
}

// ReminderLog - Track semua reminder yang dikirim
model ReminderLog {
  id              String   @id @default(cuid())
  pelangganId     String
  tagihanId       String?  // Optional
  reminderType    String   // "PRE_DUE", "DUE_DATE", "OVERDUE_7", "OVERDUE_14", "OVERDUE_30"
  channel         String   // "EMAIL", "WHATSAPP", "SMS"
  recipient       String   // Email or phone number
  subject         String?  // For email
  message         String
  status          String   @default("PENDING") // PENDING, SENT, FAILED, DELIVERED
  sentAt          DateTime?
  deliveredAt     DateTime?
  failureReason   String?
  createdAt       DateTime @default(now())

  @@index([pelangganId])
  @@index([tagihanId])
  @@index([status])
  @@index([createdAt])
}

// CustomerCohort - Customer cohort tracking
model CustomerCohort {
  id                String   @id @default(cuid())
  cohortMonth       Int      // Month of first customer registration (1-12)
  cohortYear        Int      // Year of first customer registration
  initialCustomers  Int      // Number of customers in this cohort initially
  month0Revenue     BigInt   @default(0) // Revenue in month 0 (registration month)
  month1Revenue     BigInt   @default(0) // Revenue in month 1
  month2Revenue     BigInt   @default(0) // Revenue in month 2
  month3Revenue     BigInt   @default(0) // Revenue in month 3
  month6Revenue     BigInt   @default(0) // Revenue in month 6
  month12Revenue    BigInt   @default(0) // Revenue in month 12
  activeMonth0      Int      @default(0) // Active customers in month 0
  activeMonth1      Int      @default(0) // Active customers in month 1
  activeMonth3      Int      @default(0) // Active customers in month 3
  activeMonth6      Int      @default(0) // Active customers in month 6
  activeMonth12     Int      @default(0) // Active customers in month 12
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([cohortYear, cohortMonth])
  @@index([cohortYear, cohortMonth])
}

// ============================================
// TAX MANAGEMENT & BUDGETING SYSTEM
// ============================================

// TaxRecord - Track all tax transactions (PPN, PPh)
model TaxRecord {
  id                String   @id @default(cuid())
  taxType           String   // "PPN_IN", "PPN_OUT", "PPH_21", "PPH_23", "PPH_4_2"
  taxPeriod         Int      // Month (1-12)
  taxYear           Int
  taxableAmount     BigInt   // DPP (Dasar Pengenaan Pajak)
  taxAmount         BigInt   // Jumlah pajak
  taxRate           Float    // Tax rate (e.g., 0.11 for 11%)
  reference         String?  // Invoice number, payment reference
  relatedEntityType String?  // "TAGIHAN", "VENDOR_INVOICE", "PAYROLL"
  relatedEntityId   String?  // ID of related entity
  status            String   @default("DRAFT") // DRAFT, FILED, PAID
  filedAt           DateTime?
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  updatedBy         String?
  
  @@index([taxType, taxPeriod, taxYear])
  @@index([relatedEntityType, relatedEntityId])
  @@index([status])
  @@index([taxPeriod, taxYear])
}

// TaxFilingDeadline - Track tax filing deadlines
model TaxFilingDeadline {
  id        String   @id @default(cuid())
  taxType   String   // "PPN", "PPH_21", "PPH_23", "PPH_4_2", "PPH_ANNUAL"
  period    Int      // Month (1-12)
  year      Int
  deadline  DateTime
  status    String   @default("PENDING") // PENDING, FILED, LATE
  filedAt   DateTime?
  filedBy   String?  // User ID
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([taxType, period, year])
  @@index([deadline])
  @@index([status])
  @@index([year, period])
}

// BudgetCategory - Hierarchical budget categories
model BudgetCategory {
  id          String           @id @default(cuid())
  code        String           @unique // "OPEX_OPR", "CAPEX_NET", etc.
  name        String           // "Operational Expense", "Network CAPEX"
  type        String           // "OPEX", "CAPEX"
  parentId    String?
  parent      BudgetCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    BudgetCategory[] @relation("CategoryHierarchy")
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  budgets Budget[]
  
  @@index([type])
  @@index([parentId])
  @@index([isActive])
}

// Budget - Monthly budget planning and tracking
model Budget {
  id              String          @id @default(cuid())
  year            Int
  month           Int
  categoryId      String
  category        BudgetCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department      String?         // For larger organizations
  budgetAmount    BigInt
  actualAmount    BigInt          @default(0)
  variance        BigInt          @default(0) // actualAmount - budgetAmount
  variancePercent Float           @default(0) // (variance / budgetAmount) * 100
  status          String          @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, ACTIVE, CLOSED
  approvedBy      String?         // User ID
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String?
  updatedBy       String?
  
  alerts BudgetAlert[]
  
  @@unique([year, month, categoryId])
  @@index([year, month])
  @@index([status])
  @@index([categoryId])
}

// CashFlowForecast - Cash flow projections
model CashFlowForecast {
  id                String   @id @default(cuid())
  forecastDate      DateTime // Date being forecasted
  scenarioType      String   // "BEST_CASE", "WORST_CASE", "MOST_LIKELY"
  projectedRevenue  BigInt
  projectedExpenses BigInt
  projectedCashFlow BigInt   // revenue - expenses
  projectedBalance  BigInt   // cumulative balance
  confidence        Float    @default(0.7) // 0.0-1.0
  assumptions       String?  // JSON: assumptions used
  notes             String?
  createdAt         DateTime @default(now())
  createdBy         String?
  
  @@index([forecastDate])
  @@index([scenarioType])
  @@index([forecastDate, scenarioType])
}

// BudgetAlert - Budget monitoring alerts
model BudgetAlert {
  id        String   @id @default(cuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  alertType String   // "APPROACHING_LIMIT", "EXCEEDED", "VARIANCE_HIGH"
  threshold Float    // Percentage threshold (e.g., 80, 100, 120)
  message   String
  isRead    Boolean  @default(false)
  readAt    DateTime?
  readBy    String?
  createdAt DateTime @default(now())
  
  @@index([budgetId])
  @@index([isRead])
  @@index([createdAt])
}

// USO (Universal Service Obligation) - ISP Compliance
model USOContribution {
  id              String    @id @default(cuid())
  quarter         Int       // 1-4
  year            Int
  
  // Financial data
  totalRevenue    BigInt    // Gross revenue for quarter
  usoRate         Float     @default(0.0125) // 1.25%
  usoAmount       BigInt    // Calculated: revenue * rate
  
  // Status tracking
  status          String    @default("DRAFT") // DRAFT, CALCULATED, FILED, PAID
  calculatedAt    DateTime?
  filedAt         DateTime?
  filedBy         String?
  paidAt          DateTime?
  paidBy          String?
  
  // Reference
  paymentReference String?  // Reference to Pengeluaran ID
  notes           String?   @db.Text
  
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  
  @@unique([quarter, year])
  @@index([status])
  @@index([year, quarter])
  @@map("uso_contributions")
}

// Deferred Revenue - Subscription revenue recognition
model DeferredRevenue {
  id                String   @id @default(cuid())
  
  // Source
  tagihanId         String?  // Reference to original invoice
  customerId        String?  // Customer reference
  
  // Financial
  totalAmount       BigInt   // Total deferred amount
  recognizedAmount  BigInt   @default(0) // Already recognized
  remainingAmount   BigInt   // Still deferred
  
  // Schedule
  startDate         DateTime // When to start recognizing
  endDate           DateTime // When to stop
  periodMonths      Int      // Number of months (e.g., 12)
  monthlyAmount     BigInt   // Amount per month
  
  // Status
  status            String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  
  // Metadata
  description       String?
  notes             String?  @db.Text
  
  // Audit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  
  // Relations
  recognitions      RevenueRecognition[]
  
  @@index([status])
  @@index([tagihanId])
  @@index([startDate, endDate])
  @@map("deferred_revenues")
}

// Revenue Recognition - Monthly recognition tracking
model RevenueRecognition {
  id                  String   @id @default(cuid())
  deferredRevenueId   String
  deferredRevenue     DeferredRevenue @relation(fields: [deferredRevenueId], references: [id], onDelete: Cascade)
  
  // Recognition details
  recognitionDate     DateTime // Month being recognized (start of month)
  amount              BigInt   // Amount recognized
  notes               String?
  
  // Link to Pemasukan (auto-created recognized revenue)
  pemasukanId         String?  // Auto-created Pemasukan
  
  // Audit
  createdAt           DateTime @default(now())
  recognizedBy        String?
  
  @@index([deferredRevenueId])
  @@index([recognitionDate])
  @@unique([deferredRevenueId, recognitionDate])
  @@map("revenue_recognitions")
}
