// ==================== SALARY MODELS ====================

model Salary {
  id              String           @id @default(uuid())
  userId          String
  month           Int
  year            Int
  status          SalaryStatus     @default(DRAFT)
  basicSalary     Float
  totalEarnings   Float            @default(0)
  totalDeductions Float            @default(0)
  netSalary       Float            @default(0)
  calculatedAt    DateTime?
  auditedById     String?
  auditedAt       DateTime?
  auditNotes      String?
  approvedById    String?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  approvedBy      User?            @relation("SalaryApprovedBy", fields: [approvedById], references: [id])
  auditedBy       User?            @relation("SalaryAuditedBy", fields: [auditedById], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  details         SalaryDetail[]
  revisions       SalaryRevision[]

  @@unique([userId, month, year])
  @@index([month, year])
  @@index([status])
  @@map("salaries")
}

model SalaryComponent {
  id             String                @id @default(uuid())
  name           String                @unique
  type           SalaryComponentType
  rateType       RateType              @default(FIXED)
  defaultAmount  Float?
  description    String?
  isActive       Boolean               @default(true)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  details        SalaryDetail[]
  userComponents UserSalaryComponent[]

  @@map("salary_components")
}

model SalaryDetail {
  id          String              @id @default(uuid())
  salaryId    String
  componentId String?
  name        String
  type        SalaryComponentType
  quantity    Float?
  rate        Float?
  amount      Float
  notes       String?
  component   SalaryComponent?    @relation(fields: [componentId], references: [id])
  salary      Salary              @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@index([salaryId])
  @@map("salary_details")
}

model SalaryRevision {
  id          String  @id @default(uuid())
  salaryId    String
  field       String
  oldValue    String?
  newValue    String?
  reason      String
  revisedById String

  createdAt DateTime @default(now())

  salary Salary @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@index([salaryId])
  @@map("salary_revisions")
}

model UserSalaryComponent {
  id          String  @id @default(uuid())
  userId      String
  componentId String
  amount      Float
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([userId, componentId])
  @@index([userId])
  @@map("user_salary_components")
}

model WorkOrderMaterial {
  id          String   @id @default(uuid())
  workOrderId String
  barangId    String
  quantity    Float
  satuan      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrder WorkOrders @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  barang    Barang     @relation(fields: [barangId], references: [id])

  @@index([workOrderId])
  @@index([barangId])
  @@map("work_order_materials")
}

model WorkOrderTemplateItem {
  id          String   @id @default(uuid())
  templateId  String
  title       String
  description String?
  order       Int      @default(0)
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template WorkOrderTemplates @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("work_order_template_items")
}

// ==================== MAPPING MODELS ====================

model MappingNode {
  nodeId         String   @id @map("node_id")
  type           String // 'olt', 'odc', 'odp', 'ont'
  name           String?
  latitude       Float?
  longitude      Float?
  capacity       Int      @default(0)
  splitter       String?
  pppoe          String?
  serialNumber   String?  @map("serialnumber")
  notes          String?
  attenuationIn  Float?   @map("attenuation_in")
  attenuationOut Float?   @map("attenuation_out")
  inputCoreColor String?  @map("input_core_color")
  photo          String?
  metadata       Json?    @map("metadata") // For extra fields like poleSize, hasSlack, etc.
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  outgoingEdges MappingEdge[] @relation("SourceNode")
  incomingEdges MappingEdge[] @relation("TargetNode")

  @@map("mapping_nodes")
}

model MappingEdge {
  edgeId    String   @id @default(uuid()) @map("edge_id")
  source    String
  target    String
  name      String?  @map("name") // Label for the fiber line
  fiberType String?  @map("fiber_type") // 'odc_to_odc', 'odp_to_odp'
  distance  Float?
  waypoints String? // JSON String: [[lat,lng], [lat,lng]]
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  sourceNode MappingNode @relation("SourceNode", fields: [source], references: [nodeId])
  targetNode MappingNode @relation("TargetNode", fields: [target], references: [nodeId])

  @@index([source])
  @@index([target])
  @@map("mapping_edges")
}

model MapSettings {
  id          Int      @id @default(autoincrement())
  centerLat   String?  @map("center_lat")
  centerLng   String?  @map("center_lng")
  maxZoomIn   String?  @map("max_zoom_in")
  maxZoomOut  String?  @map("max_zoom_out")
  defaultZoom String?  @map("default_zoom")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("map_settings")
}

enum RabPaymentType {
  PREPAID
  POSTPAID
}

enum RabRecoveryType {
  PERCENTAGE
  FIXED
}

model RabProject {
  id               String  @id @default(cuid())
  name             String
  description             String?
  siteId                  String?
  mixRadiusGroupId        String?
  mixRadiusInvestorSiteId String?

  // Financial Projections (Monthly)
  projectedRevenue BigInt @default(0)
  projectedOpex    BigInt @default(0)

  // Growth Period Settings
  targetSubscribers Int? // Target number of subscribers
  arpu              BigInt? // Average Revenue Per User
  growthType        RabGrowthType  @default(LINEAR)
  paymentType       RabPaymentType @default(PREPAID)

  // LINEAR: subscribersPerMonth (how many new subs per month)
  // PERCENTAGE: initialPercent (starting %), monthlyGrowthPercent (% increase per month)
  // CUSTOM: milestones array [{month, percent}]
  growthSettings Json?

  // Project Timeline
  startDate DateTime? // When the project starts

  status                   RabStatus @default(DRAFT)
  investmentDurationMonths Int       @default(12)

  // Profit Sharing & Recovery
  investmentRecoveryType     RabRecoveryType @default(PERCENTAGE)
  investmentRecoveryValue    Float           @default(50) // e.g. 50% or fixed amount
  investorProfitSharePercent Float           @default(50) // Share of remaining profit
  nplTolerancePercent        Float           @default(0) // Toleransi NPL / Bad Debt (%)

  contingencyPercent  Float   @default(0) // 0-100
  contingencyAmount   BigInt  @default(0)
  hasDisbursementPlan Boolean @default(false)

  items     RabItem[]
  wbsGroups RabWbs[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actualAchievements RabActualAchievement[]
  approvals          RabApproval[]
  investors          RabInvestor[]

  site                  Sites?                 @relation(fields: [siteId], references: [id])
  mixRadiusGroup        MixRadiusOwnerGroup?   @relation(fields: [mixRadiusGroupId], references: [id])
  mixRadiusInvestorSite MixRadiusInvestorSite? @relation(fields: [mixRadiusInvestorSiteId], references: [id])
  creator               User?                  @relation(fields: [createdBy], references: [id])

  @@index([siteId])
  @@index([status])
  @@map("rab_projects")
}

model RabApproval {
  id           String   @id @default(cuid())
  rabProjectId String
  userId       String
  status       String   @default("APPROVED") // e.g. "APPROVED", "REJECTED"
  notes        String?
  createdAt    DateTime @default(now())

  rabProject RabProject @relation(fields: [rabProjectId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rabProjectId, userId])
  @@index([rabProjectId])
  @@index([userId])
  @@map("rab_approvals")
}

model RabItem {
  id                String           @id @default(cuid())
  rabProjectId      String
  name              String
  description       String?
  quantity          Int              @default(1)
  unitPrice         BigInt
  totalPrice        BigInt
  category          RabItemCategory  @default(HARDWARE)
  expenseType       RabExpenseType   @default(CAPEX)
  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  wbsId String?

  rabProject    RabProject        @relation(fields: [rabProjectId], references: [id], onDelete: Cascade)
  wbs           RabWbs?           @relation(fields: [wbsId], references: [id], onDelete: SetNull)
  disbursements RabDisbursement[]

  @@index([wbsId])
  @@map("rab_items")
}

model RabWbs {
  id           String @id @default(cuid())
  rabProjectId String
  name         String
  order        Int    @default(0)

  rabProject RabProject @relation(fields: [rabProjectId], references: [id], onDelete: Cascade)
  items      RabItem[]

  @@index([rabProjectId])
  @@map("rab_wbs")
}

model RabDisbursement {
  id            String    @id @default(cuid())
  rabItemId     String
  name          String
  percentage    Float
  amount        BigInt
  estimatedDate DateTime?
  isPaid        Boolean   @default(false)

  rabItem RabItem @relation(fields: [rabItemId], references: [id], onDelete: Cascade)

  @@index([rabItemId])
  @@map("rab_disbursements")
}

