/// Approval matrix: role × scope × nominal range. Saat approve PR/PO,
/// guard memastikan role approver punya threshold yang cover nominal.
/// `maxAmount` null artinya tidak ada batas atas (untuk role tertinggi).
model ApprovalThreshold {
  id          String                 @id @default(uuid())
  scope       ApprovalThresholdScope
  roleId      String
  minAmount   Float                  @default(0)
  maxAmount   Float?
  description String?
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenantId    String?
  role        Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant      Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, scope, isActive])
  @@index([roleId])
  @@map("approval_thresholds")
}

