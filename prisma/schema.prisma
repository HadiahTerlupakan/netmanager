model InvestorProfitShare {
  id           String                    @id @default(cuid())
  investorId   String
  configId     String
  periodStart  DateTime
  periodEnd    DateTime
  netProfit    Decimal                   @db.Decimal(19, 2)
  sharePercent Float
  shareAmount  Decimal                   @db.Decimal(19, 2)
  status       InvestorProfitShareStatus @default(CALCULATED)
  approvedAt   DateTime?
  approvedById String?
  paidAt       DateTime?
  paidById     String?
  payoutId     String?
  journalId    String?
  notes        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  tenantId     String?
  investor     Investor                  @relation(fields: [investorId], references: [id])
