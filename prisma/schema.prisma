enum OltVendor {
  ZTE
  HSGQ
  HIOSO
  CDATA
}

enum OltStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
}

enum OnuStatus {
  UNREGISTERED
  REGISTERED
  ACTIVE
  OFFLINE
  DISABLED
  LOS
  DYING_GASP
}

enum VlanPurpose {
  INTERNET
  IPTV
  VOIP
  MANAGEMENT
}

enum OltCommandResult {
  SUCCESS
  FAILED
  TIMEOUT
  PENDING
}

enum PreRegStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

enum OltCardStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
}

model OltDevice {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  vendor           OltVendor
  model            String
  ipAddress        String
  snmpCommunity    String?
  snmpPort         Int       @default(161)
  telnetPort       Int?      @default(23)
  telnetUser       String?
  telnetPass       String?
  telnetEnablePass String?
  defaultSlotFrame Int       @default(1)
  defaultSlot      Int       @default(1)
  totalPonPorts    Int
  location         String?
  status           OltStatus @default(ACTIVE)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  onus              OnuDevice[]
  vlanConfigs       OltVlanConfig[]
  bandwidthProfiles OltBandwidthProfile[]
  alerts            OltAlert[]
  cards             OltCard[]

  @@index([tenantId])
  @@map("olt_devices")
}

model OltCard {
  id        String        @id @default(cuid())
  tenantId  String
  oltId     String
  slotFrame Int
  slot      Int
  cardType  String?
  ponCount  Int
  status    OltCardStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  olt OltDevice @relation(fields: [oltId], references: [id], onDelete: Cascade)

  @@unique([oltId, slotFrame, slot])
  @@index([tenantId])
  @@map("olt_cards")
}

model OnuDevice {
  id               String    @id @default(cuid())
  tenantId         String
  oltId            String
  pelangganId      String?
  serialNumber     String
  slotFrame        Int       @default(1)
  slot             Int       @default(1)
  ponPort          Int
  onuIndex         Int?
  vendor           String?
  model            String?
  softwareVersion  String?
  distance         Int?
  status           OnuStatus @default(UNREGISTERED)
  rxPower          Float?
  txPower          Float?
  oltRxPower       Float?
  vlanId           Int?
  bandwidthProfile String?
  description      String?
  lastSeen         DateTime?
  registeredAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  olt          OltDevice         @relation(fields: [oltId], references: [id])
  pelanggan    Pelanggan?        @relation(fields: [pelangganId], references: [id])
  commandLogs  OltCommandLog[]
  powerHistory OnuPowerHistory[]
  alerts       OltAlert[]

  @@unique([oltId, serialNumber])
  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([oltId])
  @@index([pelangganId])
  @@index([status])
  @@index([oltId, ponPort, onuIndex])
  @@map("onu_devices")
}

model OltVlanConfig {
  id        String      @id @default(cuid())
  tenantId  String
  oltId     String
  ponPort   Int?
  vlanId    Int
  vlanName  String?
  purpose   VlanPurpose @default(INTERNET)
  createdAt DateTime    @default(now())

  olt OltDevice @relation(fields: [oltId], references: [id])

  @@index([oltId])
  @@map("olt_vlan_configs")
}

model OltCommandLog {
  id         String           @id @default(cuid())
  tenantId   String
  oltId      String
  onuId      String?
  command    String
  params     Json
  result     OltCommandResult
  errorMsg   String?
  executedBy String
  executedAt DateTime         @default(now())

  onu OnuDevice? @relation(fields: [onuId], references: [id])

  @@index([tenantId, executedAt])
  @@index([oltId])
  @@index([onuId])
  @@map("olt_command_logs")
}

model OnuPreRegistration {
  id               String       @id @default(cuid())
  tenantId         String
  serialNumber     String
  oltId            String?
  pelangganId      String?
  bandwidthProfile String?
  vlanId           Int?
  status           PreRegStatus @default(PENDING)
  completedAt      DateTime?
  createdBy        String
  createdAt        DateTime     @default(now())

  @@unique([tenantId, serialNumber])
  @@index([tenantId, status])
  @@map("onu_pre_registrations")
}

model OltBandwidthProfile {
  id           String   @id @default(cuid())
  tenantId     String
  oltId        String
  name         String
  uploadRate   Int
  downloadRate Int
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  olt OltDevice @relation(fields: [oltId], references: [id])

  @@index([tenantId])
  @@index([oltId])
  @@map("olt_bandwidth_profiles")
}

model OnuPowerHistory {
  id         String   @id @default(cuid())
  tenantId   String
  onuId      String
  rxPower    Float?
  txPower    Float?
  recordedAt DateTime @default(now())

  onu OnuDevice @relation(fields: [onuId], references: [id], onDelete: Cascade)

  @@index([onuId, recordedAt])
  @@index([tenantId, recordedAt])
  @@map("onu_power_history")
}

enum OltAlertType {
  LOS
  LOW_POWER
  OFFLINE
  CRITICAL_POWER
}

enum OltAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model OltAlert {
  id        String           @id @default(cuid())
  tenantId  String
  oltId     String
  onuId     String?
  type      OltAlertType
  message   String
  severity  OltAlertSeverity @default(WARNING)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  olt OltDevice  @relation(fields: [oltId], references: [id])
  onu OnuDevice? @relation(fields: [onuId], references: [id])

  @@index([tenantId, isRead, createdAt])
  @@index([oltId])
  @@index([onuId])
  @@map("olt_alerts")
}

enum InvestorDepositType {
  MODAL_AWAL
  TAMBAHAN_MODAL
  PINJAMAN
}

enum InvestorDepositStatus {
  PENDING
  VERIFIED
  COMPLETED
  REJECTED
}

enum InvestorProfitShareStatus {
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum InvestorShareMode {
  FIXED
  PROPORTIONAL
}

enum InvestorProfitPeriodType {
