  paidFromAccountId String?
  paymentStatus     PaymentStatus       @default(UNPAID)
  ppnAmount         Float               @default(0)
  ppnRate           Float               @default(0)
  fakturPajakNo     String?
  fakturPajakDate   DateTime?
  vendorNpwp        String?
  tenantId          String?
  items             PurchaseOrderItem[]
  jasaItems         PurchaseOrderJasaItem[]
  goodsReceipts     GoodsReceipt[]
  creator           User                @relation("POCreator", fields: [createdBy], references: [id])
  paidFromAccount   FinancialAccount?   @relation("POPaidFrom", fields: [paidFromAccountId], references: [id])
  processedBy       User?               @relation("POProcessor", fields: [processedById], references: [id])
  receivedBy        User?               @relation("POReceiver", fields: [receivedById], references: [id])
  supplier          Supplier?           @relation(fields: [supplierId], references: [id])
  tenant            Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseRequests  PurchaseRequest[]

  @@unique([tenantId, poNumber], name: "tenantId_poNumber")
  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String             @id @default(uuid())
  purchaseOrderId   String
  barangId          String
  quantity          Int
  receivedQuantity  Int                @default(0)
  unitPrice         Float
  totalPrice        Float
  tenantId          String?
  barang            Barang             @relation(fields: [barangId], references: [id])
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  goodsReceiptItems GoodsReceiptItem[]

  @@index([tenantId])
  @@map("purchase_order_items")
}

/// Item jasa pada Purchase Order. Harga diisi admin di PO (bukan di PR).
/// Tidak terkait stok/gudang; penyelesaian tetap via konfirmasi di restock.
model PurchaseOrderJasaItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  jasaId          String
  quantity        Int
  unitPrice       Float         @default(0)
  totalPrice      Float         @default(0)
  tenantId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  jasa            Jasa          @relation(fields: [jasaId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([jasaId])
  @@map("purchase_order_jasa_items")
}

/// Dokumen penerimaan barang per batch (GRN). Satu PO bisa punya banyak GRN
/// karena vendor bisa kirim parsial. Header GRN menyimpan referensi PO,
/// gudang tujuan, penerima, dan foto bukti; detail per barang di
/// GoodsReceiptItem. Status DRAFT → POSTED setelah stok benar-benar
/// di-update, supaya tidak double-count.
model GoodsReceipt {
  id              String             @id @default(uuid())
  grnNumber       String
  purchaseOrderId String
  gudangId        String
  receivedById    String
  receivedAt      DateTime           @default(now())
  status          GoodsReceiptStatus @default(POSTED)
  notes           String?
  fotoBukti       String[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenantId        String?
  items           GoodsReceiptItem[]
  goodsReturns    GoodsReturn[]
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  gudang          Gudang             @relation(fields: [gudangId], references: [id])
  receivedBy      User               @relation("GRNReceiver", fields: [receivedById], references: [id])
  tenant          Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, grnNumber], name: "tenantId_grnNumber")
  @@index([purchaseOrderId])
  @@index([tenantId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  barangId            String
  quantity            Int
  notes               String?
  tenantId            String?
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  barang              Barang            @relation(fields: [barangId], references: [id])
  tenant              Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  goodsReturnItems    GoodsReturnItem[]

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([tenantId])
  @@map("goods_receipt_items")
}

/// Dokumen Return to Vendor (RTV). Retur barang yang sudah diterima
/// kembali ke supplier karena rusak (DAMAGED), salah spesifikasi
/// (WRONG_SPEC), kelebihan kirim (EXCESS), atau alasan lain (OTHER).
/// Reference ke GoodsReceipt: traceability batch mana yang diretur.
/// Status SENT → RESOLVED (REFUNDED/REPLACED/CREDIT_NOTE) menandai
/// gimana vendor menyelesaikan klaim.
model GoodsReturn {
  id               String            @id @default(uuid())
  rtvNumber        String
  goodsReceiptId   String
  supplierId       String?
  gudangId         String
  reason           GoodsReturnReason
  status           GoodsReturnStatus @default(SENT)
  returnedById     String
  returnedAt       DateTime          @default(now())
  resolvedAt       DateTime?
  notes            String?
  fotoBukti        String[]
  refundAmount     Float?
  replacementGrnId String?
  creditNoteRef    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenantId         String?
  items            GoodsReturnItem[]
  goodsReceipt     GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  gudang           Gudang            @relation(fields: [gudangId], references: [id])
  returnedBy       User              @relation("RTVReturner", fields: [returnedById], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, rtvNumber], name: "tenantId_rtvNumber")
  @@index([goodsReceiptId])
  @@index([supplierId])
  @@index([tenantId])
  @@map("goods_returns")
}

model GoodsReturnItem {
  id                 String           @id @default(uuid())
  goodsReturnId      String
  goodsReceiptItemId String
  barangId           String
  quantity           Int
  notes              String?
  tenantId           String?
  goodsReturn        GoodsReturn      @relation(fields: [goodsReturnId], references: [id], onDelete: Cascade)
  goodsReceiptItem   GoodsReceiptItem @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  barang             Barang           @relation(fields: [barangId], references: [id])
  tenant             Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([goodsReturnId])
  @@index([goodsReceiptItemId])
  @@index([tenantId])
  @@map("goods_return_items")
}

model FinancialAccount {
  id             String          @id @default(uuid())
  name           String
  accountNumber  String?
  type           AccountType     @default(CASH)
  balance        Float           @default(0)
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenantId       String?
  coaId          String?
  expenses       Expense[]
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[] @relation("POPaidFrom")

  @@index([tenantId])
  @@map("financial_accounts")
}

model Asset {
  id                String                 @id @default(uuid())
  barangId          String
  kodeAsset         String
  purchaseDate      DateTime
  purchasePrice     Decimal                @db.Decimal(19, 2)
  currentValue      Decimal                @db.Decimal(19, 2)
  residualValue     Decimal                @default(0) @db.Decimal(19, 2)
  usefulLife        Int
  status            AssetStatus            @default(ACTIVE)
  location          String?
  assignedTo        String?
  assignedActorType String?
  assignedActorId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenantId          String?
  depreciationLogs  AssetDepreciationLog[]
  user              User?                  @relation(fields: [assignedTo], references: [id])
  barang            Barang                 @relation(fields: [barangId], references: [id])
  tenant            Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, kodeAsset], name: "tenantId_kodeAsset")
  @@index([barangId])
  @@index([status])
  @@index([assignedTo])
  @@index([assignedActorType, assignedActorId])
  @@index([tenantId])
  @@map("assets")
}

model AssetDepreciationLog {
  id        String   @id @default(uuid())
  assetId   String
  date      DateTime @default(now())
  amount    Decimal  @db.Decimal(19, 2)
  notes     String?
  createdAt DateTime @default(now())
  tenantId  String?
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([tenantId])
  @@map("asset_depreciation_logs")
}

model Salary {
  id              String           @id @default(uuid())
  userId          String
  month           Int
  year            Int
  status          SalaryStatus     @default(DRAFT)
  basicSalary     Float
  totalEarnings   Float            @default(0)
  totalDeductions Float            @default(0)
  netSalary       Float            @default(0)
  calculatedAt    DateTime?
  auditedById     String?
  auditedAt       DateTime?
  auditNotes      String?
  approvedById    String?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenantId        String?
  approvedBy      User?            @relation("SalaryApprovedBy", fields: [approvedById], references: [id])
  auditedBy       User?            @relation("SalaryAuditedBy", fields: [auditedById], references: [id])
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  details         SalaryDetail[]
  revisions       SalaryRevision[]

  @@unique([userId, month, year])
  @@index([month, year])
  @@index([status])
  @@index([tenantId])
  @@map("salaries")
}

model SalaryComponent {
  id             String                @id @default(uuid())
  name           String
  type           SalaryComponentType
  rateType       RateType              @default(FIXED)
  defaultAmount  Float?
  description    String?
  isActive       Boolean               @default(true)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tenantId       String?
  tenant         Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  details        SalaryDetail[]
  userComponents UserSalaryComponent[]

  @@unique([tenantId, name], name: "tenantId_name")
  @@index([tenantId])
  @@map("salary_components")
}

model SalaryDetail {
  id            String              @id @default(uuid())
  salaryId      String
  componentId   String?
  name          String
  type          SalaryComponentType
  quantity      Float?
  rate          Float?
  amount        Float
  notes         String?
  loanPaymentId String?             @unique
  tenantId      String?
  component     SalaryComponent?    @relation(fields: [componentId], references: [id])
  loanPayment   LoanPayment?        @relation(fields: [loanPaymentId], references: [id])
  salary        Salary              @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([salaryId])
  @@index([tenantId])
  @@map("salary_details")
}

model SalaryRevision {
  id          String   @id @default(uuid())
  salaryId    String
  field       String
  oldValue    String?
  newValue    String?
  reason      String
  revisedById String
  createdAt   DateTime @default(now())
  tenantId    String?
  salary      Salary   @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([salaryId])
  @@index([tenantId])
  @@map("salary_revisions")
}

model UserSalaryComponent {
  id          String          @id @default(uuid())
  userId      String
  componentId String
  amount      Float
  notes       String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenantId    String?
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, componentId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_salary_components")
}

model WorkOrderMaterial {
  id          String     @id @default(uuid())
  workOrderId String
  barangId    String
  quantity    Float
  satuan      String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenantId    String
  barang      Barang     @relation(fields: [barangId], references: [id])
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workOrder   WorkOrders @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([barangId])
  @@index([tenantId])
  @@map("work_order_materials")
}

model WorkOrderTemplateItem {
  id          String             @id @default(uuid())
  templateId  String
  title       String
  description String?
  order       Int                @default(0)
  isMandatory Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenantId    String?
  template    WorkOrderTemplates @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@index([tenantId])
  @@map("work_order_template_items")
}

model MappingNode {
  nodeId         String        @id @map("node_id")
  type           String
  name           String?
  latitude       Float?
  longitude      Float?
  capacity       Int           @default(0)
  splitter       String?
  pppoe          String?
  serialNumber   String?       @map("serialnumber")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")
  attenuationIn  Float?        @map("attenuation_in")
  attenuationOut Float?        @map("attenuation_out")
  inputCoreColor String?       @map("input_core_color")
  photo          String?
  metadata       Json?         @map("metadata")
  tenantId       String?
  siteId         String?
  outgoingEdges  MappingEdge[] @relation("SourceNode")
  incomingEdges  MappingEdge[] @relation("TargetNode")
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site           Sites?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([siteId])
  @@index([tenantId, siteId])
  @@map("mapping_nodes")
}

model MappingEdge {
  edgeId     String      @id @default(uuid()) @map("edge_id")
  source     String
  target     String
  fiberType  String?     @map("fiber_type")
  distance   Float?
  waypoints  String?
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at")
  name       String?     @map("name")
  tenantId   String?
  sourceNode MappingNode @relation("SourceNode", fields: [source], references: [nodeId])
  targetNode MappingNode @relation("TargetNode", fields: [target], references: [nodeId])
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([source])
  @@index([target])
  @@index([tenantId])
  @@map("mapping_edges")
}

model MapSettings {
  id          Int      @id @default(autoincrement())
  centerLat   String?  @map("center_lat")
  centerLng   String?  @map("center_lng")
  maxZoomIn   String?  @map("max_zoom_in")
  maxZoomOut  String?  @map("max_zoom_out")
  defaultZoom String?  @map("default_zoom")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("map_settings")
}

model RabProject {
  id                                  String                     @id @default(cuid())
  name                                String
  description                         String?
  siteId                              String?
  mixRadiusGroupId                    String?
  projectedRevenue                    BigInt                     @default(0)
  projectedOpex                       BigInt                     @default(0)
  status                              RabStatus                  @default(DRAFT)
  createdBy                           String?
  createdAt                           DateTime                   @default(now())
  updatedAt                           DateTime                   @updatedAt
  arpu                                BigInt?
  growthSettings                      Json?
  growthType                          RabGrowthType              @default(LINEAR)
  startDate                           DateTime?
  targetBasis                         RabTargetBasis             @default(HOMECONNECT)
  targetHomepass                      Int?
  targetTakeUpRatePercent             Float                      @default(100)
  targetSubscribers                   Int?
  contingencyAmount                   BigInt                     @default(0)
  contingencyPercent                  Float                      @default(0)
  hasDisbursementPlan                 Boolean                    @default(false)
  investmentDurationMonths            Int                        @default(12)
  investmentRecoveryType              RabRecoveryType            @default(PERCENTAGE)
  investmentRecoveryValue             Float                      @default(50)
  investorProfitSharePercent          Float                      @default(50)
  investorProfitShareMode             RabInvestorProfitShareMode @default(FLAT)
  investorProfitShareBeforeBepPercent Float                      @default(80)
  investorProfitShareAfterBepPercent  Float                      @default(60)
  paymentType                         RabPaymentType             @default(PREPAID)
  nplTolerancePercent                 Float                      @default(0)
  opexBufferFundingMode               RabOpexBufferFundingMode   @default(INVESTOR)
  opexBufferInvestorPercent           Float                      @default(100)
  opexBufferCompanyPercent            Float                      @default(0)
  opexBufferInvestorFixedAmount       BigInt                     @default(0)
  opexBufferSafetyPercent             Float                      @default(0)
  mixRadiusInvestorSiteId             String?
  finalApprovedRevisionId             String?
  tenantId                            String?
  expenses                            Expense[]
  investors                           RabInvestor[]
  actualAchievements                  RabActualAchievement[]
  approvals                           RabApproval[]
  items                               RabItem[]
  creator                             User?                      @relation(fields: [createdBy], references: [id])
  finalApprovedRevision               RabRevision?               @relation("FinalApprovedRevision", fields: [finalApprovedRevisionId], references: [id])
  site                                Sites?                     @relation(fields: [siteId], references: [id])
  tenant                              Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  revisions                           RabRevision[]              @relation("ProjectRevisions")
  wbsGroups                           RabWbs[]

  @@index([finalApprovedRevisionId])
  @@index([siteId])
  @@index([status])
  @@index([tenantId])
  @@map("rab_projects")
}

model RabRevision {
  id                      String                @id @default(cuid())
  rabProjectId            String
  revisionNumber          Int
  status                  RabRevisionStatus     @default(DRAFT)
  reason                  String?
  notes                   String?
  createdById             String
  submittedById           String?
  submittedAt             DateTime?
  approvedById            String?
  approvedAt              DateTime?
  rejectedById            String?
  rejectedAt              DateTime?
  totalCapex              BigInt                @default(0)
  totalOpex               BigInt                @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  tenantId                String?
  projectsUsingAsBaseline RabProject[]          @relation("FinalApprovedRevision")
  approvals               RabRevisionApproval[]
  items                   RabRevisionItem[]
  project                 RabProject            @relation("ProjectRevisions", fields: [rabProjectId], references: [id], onDelete: Cascade)
  tenant                  Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([rabProjectId, revisionNumber])
  @@index([rabProjectId])
  @@index([status])
  @@index([tenantId])
  @@map("rab_revisions")
}

model RabRevisionApproval {
  id            String      @id @default(cuid())
  rabRevisionId String
  userId        String
  status        String      @default("APPROVED")
  notes         String?
  createdAt     DateTime    @default(now())
  tenantId      String?
  rabRevision   RabRevision @relation(fields: [rabRevisionId], references: [id], onDelete: Cascade)
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rabRevisionId, userId])
  @@index([rabRevisionId])
  @@index([userId])
  @@index([tenantId])
  @@map("rab_revision_approvals")
}

model RabRevisionItem {
  id                String          @id @default(cuid())
  rabRevisionId     String
  rabItemId         String?
  name              String
  description       String?
  quantity          Int             @default(1)
  unitPrice         BigInt
  totalPrice        BigInt
  category          RabItemCategory @default(HARDWARE)
  expenseType       RabExpenseType  @default(CAPEX)
  expenseCategoryId String?
  wbsId             String?
  sortOrder         Int             @default(0)
  tenantId          String?
  rabRevision       RabRevision     @relation(fields: [rabRevisionId], references: [id], onDelete: Cascade)
  tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([rabRevisionId])
  @@index([rabItemId])
  @@index([wbsId])
  @@index([tenantId])
  @@map("rab_revision_items")
}

model RabApproval {
  id           String     @id @default(cuid())
  rabProjectId String
  userId       String
  status       String     @default("APPROVED")
  notes        String?
  createdAt    DateTime   @default(now())
  tenantId     String?
  rabProject   RabProject @relation(fields: [rabProjectId], references: [id], onDelete: Cascade)
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rabProjectId, userId])
  @@index([rabProjectId])
  @@index([userId])
  @@index([tenantId])
  @@map("rab_approvals")
}

model RabItem {
  id                String            @id @default(cuid())
  rabProjectId      String
  name              String
  description       String?
  quantity          Int               @default(1)
  unitPrice         BigInt
  totalPrice        BigInt
  category          RabItemCategory   @default(HARDWARE)
  expenseType       RabExpenseType    @default(CAPEX)
  expenseCategoryId String?
  wbsId             String?
