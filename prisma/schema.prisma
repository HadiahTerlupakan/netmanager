// Role-Based Access Control Models


// Menu Definition for granular role-based access control

// ===================================================================
// Notification System
// ===================================================================

model Notification {
  id       String  @id @default(cuid())
  type     String // 'WORK_ORDER', 'SYSTEM', 'TICKET', 'ALERT'
  priority String  @default("NORMAL") // 'LOW', 'NORMAL', 'HIGH', 'URGENT'
  title    String
  message  String
  link     String? // URL for navigation
  isRead   Boolean @default(false)

  // Target notification
  userId       String? // Specific user
  departmentId String? // All users in department

  // Reference to source
  sourceType String? // 'WORK_ORDER', 'TICKET', etc.
  sourceId   String? // ID of the source entity

  createdAt DateTime  @default(now())
  readAt    DateTime?

  user       User?       @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([departmentId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@map("notifications")
}

model PushSubscription {
  id         String  @id @default(cuid())
  userId     String
  endpoint   String  @unique
  p256dh     String // Public key for encryption
  auth       String // Auth secret
  userAgent  String? // Device/browser info
  isActive   Boolean @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  user       User @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("push_subscriptions")
}

// Customer Usage Tracking Model
model CustomerUsage {
  id                String   @id @default(cuid())
  pelangganId        String
  sessionId         String?  @map("session_id")
  sessionStartTime   DateTime @map("session_start_time")
  sessionEndTime     DateTime? @map("session_end_time")
  sessionDuration    BigInt?  @map("session_duration") // in seconds
  uploadBytes       BigInt?  @map("upload_bytes")
  downloadBytes     BigInt?  @map("download_bytes")
  totalBytes        BigInt?  @map("total_bytes")
  nasIpAddress      String?  @map("nas_ip_address")
  callingStationId  String?  @map("calling_station_id")
  calledStationId   String?  @map("called_station_id")
  terminateCause    String?  @map("terminate_cause")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  pelanggan         Pelanggan @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  
  @@index([pelangganId])
  @@index([sessionStartTime])
  @@index([sessionEndTime])
  @@index([nasIpAddress])
  @@map("customer_usage")
}

// Service Suspension Model
model ServiceSuspension {
  id                String   @id @default(cuid())
  pelangganId        String
  suspensionType     String   @map("suspension_type") // PAYMENT, VIOLATION, MAINTENANCE, REQUEST
  reason            String?
  suspendedAt        DateTime @default(now()) @map("suspended_at")
  suspendedBy        String?  @map("suspended_by") // User ID who suspended
  expectedResumeAt   DateTime? @map("expected_resume_at")
  actualResumeAt     DateTime? @map("actual_resume_at")
  resumedBy          String?  @map("resumed_by") // User ID who resumed
  notes             String?
  isActive          Boolean  @default(true) @map("is_active") // true if currently suspended
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  pelanggan         Pelanggan @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  
  @@index([pelangganId])
  @@index([suspensionType])
  @@index([suspendedAt])
  @@index([isActive])
  @@map("service_suspension")
}

// Network Performance Monitoring Models
model NetworkPerformance {
  id                String      @id @default(cuid())
  deviceId          String      // Reference to OLT, MikroTik Router, or ONU
  deviceType        String      // 'OLT', 'MIKROTIK', 'ONU'
  timestamp         DateTime    @default(now())
  cpuUsage          Float?      // CPU usage percentage
  memoryUsage       Float?      // Memory usage percentage
  temperature       Float?      // Device temperature in Celsius
  uptime            BigInt?     // Device uptime in seconds
  rxBytes          BigInt?     // Received bytes
  txBytes          BigInt?     // Transmitted bytes
  rxPackets        BigInt?     // Received packets
  txPackets        BigInt?     // Transmitted packets
  rxDrops          BigInt?     // Dropped received packets
  txDrops          BigInt?     // Dropped transmitted packets
  rxErrors         BigInt?     // Received packet errors
  txErrors         BigInt?     // Transmitted packet errors
  interfaceStatus  Json?       // Interface status information
  connectionCount   Int?        // Number of active connections
  bandwidthUsage   Float?      // Current bandwidth usage in Mbps
  signalStrength   Float?      // Signal strength in dBm (for wireless devices)
  powerLevel       String?     // Power level status
  customMetrics    Json?       // Custom device-specific metrics
  olt              Olt?        @relation("NetworkPerformanceOlt", fields: [deviceId], references: [id], onDelete: Cascade, map: "network_performance_olt_fkey")
  mikroTikRouter   MikroTikRouter? @relation("NetworkPerformanceMikroTik", fields: [deviceId], references: [id], onDelete: Cascade, map: "network_performance_mikrotik_fkey")
  onu              Onu?        @relation("NetworkPerformanceOnu", fields: [deviceId], references: [id], onDelete: Cascade, map: "network_performance_onu_fkey")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([deviceId, deviceType])
  @@index([timestamp])
  @@index([deviceType])
  @@index([deviceId, timestamp])
  @@map("network_performance")
}

model NetworkAlert {
  id              String            @id @default(cuid())
  deviceId        String            // Reference to OLT, MikroTik Router, or ONU
  deviceType      String            // 'OLT', 'MIKROTIK', 'ONU'
  alertType       AlertSeverity     // 'CRITICAL', 'WARNING', 'INFO'
  title           String
  message         String
  severity        AlertSeverity
  status          AlertStatus       @default(ACTIVE)
  threshold       Float?            // Alert threshold value
  currentValue    Float?            // Current value that triggered the alert
  metricName      String?           // Name of the metric that triggered the alert
  acknowledged    Boolean           @default(false)
  acknowledgedBy  String?           // User ID who acknowledged
  acknowledgedAt  DateTime?
  resolved        Boolean           @default(false)
  resolvedBy      String?           // User ID who resolved
  resolvedAt      DateTime?
  autoResolve     Boolean           @default(false)
  autoResolveTime Int?              // Auto-resolve time in minutes
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  olt             Olt?              @relation("NetworkAlertOlt", fields: [deviceId], references: [id], onDelete: Cascade, map: "network_alert_olt_fkey")
  mikrotikRouter   MikroTikRouter?    @relation("NetworkAlertMikroTik", fields: [deviceId], references: [id], onDelete: Cascade, map: "network_alert_mikrotik_fkey")
  onu             Onu?              @relation("NetworkAlertOnu", fields: [deviceId], references: [id], onDelete: Cascade, map: "network_alert_onu_fkey")

  @@index([deviceId, deviceType])
  @@index([status])
  @@index([severity])
  @@index([alertType])
  @@index([createdAt])
  @@index([isActive])
  @@map("network_alerts")
}

model DeviceBackup {
  id              String            @id @default(cuid())
  deviceId        String            // Reference to OLT, MikroTik Router, or ONU
  deviceType      String            // 'OLT', 'MIKROTIK', 'ONU'
  backupName      String
  description     String?
  backupType      BackupType        @default(MANUAL)
  filePath        String            // Path to backup file
  fileSize        Int               // File size in bytes
  fileHash        String?           // File hash for integrity verification
  compressionType String?           @default("gzip")
  isEncrypted     Boolean           @default(false)
  encryptionKey   String?           // Encryption key (encrypted)
  backupMethod    String?           // 'SNMP', 'API', 'SSH', 'TELNET'
  status          BackupStatus      @default(PENDING)
  errorMessage    String?
  scheduledAt     DateTime?
  completedAt     DateTime?
  createdBy       String?           // User ID who created the backup
  retentionDays   Int               @default(30) // Number of days to retain backup
  isAutoCleanup   Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  // olt             Olt?              @relation("DeviceBackupOlt", fields: [deviceId], references: [id], onDelete: Cascade, map: "device_backup_olt_fkey")
  // mikrotikRouter   MikroTikRouter?    @relation("DeviceBackupMikroTik", fields: [deviceId], references: [id], onDelete: Cascade, map: "device_backup_mikrotik_fkey")
  // onu             Onu?              @relation("DeviceBackupOnu", fields: [deviceId], references: [id], onDelete: Cascade, map: "device_backup_onu_fkey")
  configurationRestores ConfigurationRestore[] @relation("ConfigurationRestoreBackup")

  @@index([deviceId, deviceType])
  @@index([status])
  @@index([backupType])
  @@index([createdAt])
  @@index([scheduledAt])
  @@map("device_backups")
}

model ConfigurationRestore {
  id              String            @id @default(cuid())
  deviceId        String            // Reference to OLT, MikroTik Router, or ONU
  deviceType      String            // 'OLT', 'MIKROTIK', 'ONU'
  backupId        String            // Reference to DeviceBackup
  restoreName     String
  description     String?
  restoreMethod   String?           // 'SNMP', 'API', 'SSH', 'TELNET'
  status          RestoreStatus     @default(PENDING)
  progress        Int               @default(0) // Progress percentage
  errorMessage    String?
  warningMessage  String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  rollbackEnabled Boolean           @default(false)
  rollbackData    Json?             // Data for rollback if needed
  createdBy       String?           // User ID who initiated restore
  verifiedBy      String?           // User ID who verified restore
  verifiedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  olt             Olt?              @relation("ConfigurationRestoreOlt", fields: [deviceId], references: [id], onDelete: Cascade, map: "configuration_restore_olt_fkey")
  mikrotikRouter   MikroTikRouter?    @relation("ConfigurationRestoreMikroTik", fields: [deviceId], references: [id], onDelete: Cascade, map: "configuration_restore_mikrotik_fkey")
  onu             Onu?              @relation("ConfigurationRestoreOnu", fields: [deviceId], references: [id], onDelete: Cascade, map: "configuration_restore_onu_fkey")
  backup          DeviceBackup      @relation("ConfigurationRestoreBackup", fields: [backupId], references: [id], onDelete: Cascade)

  @@index([deviceId, deviceType])
  @@index([status])
  @@index([backupId])
  @@index([createdAt])
  @@index([scheduledAt])
  @@map("configuration_restores")
}

// Enums for Network Models
enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
}

enum BackupType {
  MANUAL
  SCHEDULED
  AUTOMATIC
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum RestoreStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
}

// Support Ticket System Enums
enum TicketStatus {
  OPEN            // Baru dibuat, belum ada respon
  IN_PROGRESS     // Sedang ditangani
  WAITING_CUSTOMER // Menunggu respon pelanggan
  RESOLVED        // Selesai
  CLOSED          // Ditutup
}

enum TicketCategory {
  TECHNICAL       // Masalah teknis (internet mati, lambat, dll)
  BILLING         // Masalah tagihan/pembayaran
  ACCOUNT         // Masalah akun
  OTHER           // Lainnya
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Support Ticket Model
model SupportTicket {
  id            String          @id @default(cuid())
  ticketNumber  String          @unique
  pelangganId   String
  category      TicketCategory
  priority      TicketPriority  @default(MEDIUM)
  subject       String
  description   String          @db.Text
  status        TicketStatus    @default(OPEN)
  assignedToId  String?
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  pelanggan     Pelanggan       @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  assignedTo    User?           @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  replies       TicketReply[]
  workOrders    WorkOrder[]

  @@index([pelangganId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@index([ticketNumber])
  @@map("support_tickets")
}

// Ticket Reply Model
model TicketReply {
  id            String        @id @default(cuid())
  ticketId      String
  senderId      String?       // NULL jika dari pelanggan (login via customer auth)
  pelangganId   String?       // ID pelanggan jika pengirim adalah pelanggan
  isFromAdmin   Boolean       @default(false)
  message       String        @db.Text
  attachments   Json?         // Array of file URLs
  createdAt     DateTime      @default(now())

  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender        User?         @relation("TicketReplySender", fields: [senderId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_replies")
}
