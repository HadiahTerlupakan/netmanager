generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailVerified DateTime?
  image         String?
  phone         String?
  departmentId  String?
  siteId        String?
  isActive      Boolean        @default(true)
  accounts      Account[]
  pelanggan     Pelanggan[]
  sessions      Session[]
  barangKeluar  BarangKeluar[] @relation("UserBarangKeluar")
  barangMasuk   BarangMasuk[]  @relation("UserBarangMasuk")
  department    Department?    @relation(fields: [departmentId], references: [id])
  site          Site?          @relation(fields: [siteId], references: [id])
  
  // Work Order Relations
  workOrdersCreated     WorkOrder[]           @relation("WorkOrderCreatedBy")
  workOrdersAssigned    WorkOrder[]           @relation("UserWorkOrders")
  workOrderTasks        WorkOrderTask[]       @relation("UserWorkOrderTasks")
  workOrderAssignments  WorkOrderAssignment[] @relation("UserWorkOrderAssignments")
  workOrderUpdates      WorkOrderUpdate[]     @relation("UserWorkOrderUpdates")
  workOrderAttachments  WorkOrderAttachment[] @relation("UserWorkOrderAttachments")
  workOrderTemplatesCreated WorkOrderTemplate[] @relation("WorkOrderTemplateCreatedBy")
  slasCreated           SLA[]                 @relation("SLACreatedBy")
  escalationsCreated    WorkOrderEscalation[] @relation("WorkOrderEscalationCreatedBy")
  
  // Notification Relations
  notifications         Notification[]        @relation("UserNotifications")
  pushSubscriptions     PushSubscription[]    @relation("UserPushSubscriptions")
  
  // Support Ticket Relations
  ticketsAssigned       SupportTicket[]       @relation("TicketAssignedTo")
  ticketReplies         TicketReply[]         @relation("TicketReplySender")
  
  @@index([departmentId])
  @@index([siteId])
  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Olt {
  id                 String         @id @default(cuid())
  name               String
  ipAddress          String         @unique
  type               String
  version            String?
  temperature        Int?
  connectedDevices   Int            @default(0)
  model              String?
  uptime             String?
  syncStatus         String         @default("0")
  syncDate           DateTime?
  telnetConnected    Boolean        @default(false)
  snmpConnected      Boolean        @default(false)
  snmpCommunityWrite String         @default("public")
  snmpVersion        String         @default("2")
  snmpPort           Int            @default(161)
  telnetUsername     String         @default("zte")
  telnetPassword     String
  telnetPort         Int            @default(23)
  onuLastSync        DateTime?
  onuSyncEnabled     Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  onus               Onu[]
  onuTypes           OnuType[]
  speedProfiles      SpeedProfile[]
  networkPerformance  NetworkPerformance[] @relation("NetworkPerformanceOlt")
  networkAlerts      NetworkAlert[] @relation("NetworkAlertOlt")
  // deviceBackups      DeviceBackup[] @relation("DeviceBackupOlt")
  configurationRestores ConfigurationRestore[] @relation("ConfigurationRestoreOlt")
}

model Otb {
  id                          String    @id @default(cuid())
  name                        String
  location                    String?
  coreCount                   Int
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status    @default(AKTIF)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  keteranganJumlahKabelFeeder String?
  cores                       OtbCore[]
}

model OtbCore {
  id        String @id @default(cuid())
  otbId     String
  idx       Int
  slotName  String
  tubeColor String
  coreColor String
  odc       Odc?
  otb       Otb    @relation(fields: [otbId], references: [id])

  @@unique([otbId, idx])
}

model Odc {
  id                          String      @id @default(cuid())
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status      @default(AKTIF)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  otbCoreId                   String      @unique
  keteranganJumlahKabelFeeder String?
  otbCore                     OtbCore     @relation(fields: [otbCoreId], references: [id])
  outputs                     OdcOutput[]
}

model OdcOutput {
  id        String @id @default(cuid())
  odcId     String
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String
  odc       Odc    @relation(fields: [odcId], references: [id])
  odp       Odp?

  @@unique([odcId, idx])
}

model Odp {
  id                          String      @id @default(cuid())
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status      @default(AKTIF)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  odcOutputId                 String      @unique
  keteranganJumlahKabelFeeder String?
  odcOutput                   OdcOutput   @relation(fields: [odcOutputId], references: [id])
  outputs                     OdpOutput[]
  pelanggans                  Pelanggan[]
}

model OdpOutput {
  id        String @id @default(cuid())
  odpId     String
  idx       Int
  slotName  String
  redaman   Float?
  tubeColor String
  coreColor String
  odp       Odp    @relation(fields: [odpId], references: [id])

  @@unique([odpId, idx])
}

model Joinbox {
  id                          String          @id @default(cuid())
  name                        String
  location                    String?
  notes                       String?
  latitude                    Float?
  longitude                   Float?
  status                      Status          @default(AKTIF)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  keteranganJumlahKabelFeeder String?
  inputs                      JoinboxInput[]
  outputs                     JoinboxOutput[]
}

model JoinboxInput {
  id        String  @id @default(cuid())
  joinboxId String
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id])

  @@unique([joinboxId, idx])
}

model JoinboxOutput {
  id        String  @id @default(cuid())
  joinboxId String
  idx       Int
  inputUnit String
  portUnit  String
  tubeColor String
  coreColor String
  joinbox   Joinbox @relation(fields: [joinboxId], references: [id])

  @@unique([joinboxId, idx])
}

model Pole {
  id         String   @id @default(cuid())
  name       String
  location   String?
  notes      String?
  latitude   Float?
  longitude  Float?
  cableSlack Boolean  @default(false)
  status     Status   @default(AKTIF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KmzFile {
  id          String   @id @default(cuid())
  name        String
  filename    String
  filePath    String
  fileSize    Int
  description String?
  lineColor   String   @default("#3388ff")
  isActive    Boolean  @default(true)
  status      Status   @default(AKTIF)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  kmlPath     String
}

model Onu {
  id                     String    @id @default(cuid())
  oltId                  String
  name                   String
  description            String?
  pppoe                  String?
  gponOnu                String
  status                 String
  rxOlt                  String?
  rxOnu                  String?
  serialNumber           String?
  actualType             String?
  lastUpdate             DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  authMode               String?
  batteryStatus          String?
  configState            String?
  distance               Float?
  dyingGaspTime          DateTime?
  equipmentId            String?
  firmwareVersion        String?
  hardwareVersion        String?
  laserBiasCurrent       Float?
  lastDeregTime          DateTime?
  lastSeen               DateTime?
  loid                   String?
  macAddress             String?
  opticalTransceiverType String?
  password               String?
  powerLevel             String?
  registerTime           DateTime?
  registrationMode       String?
  rxBytes                BigInt?
  rxDrops                BigInt?
  rxErrors               BigInt?
  rxPackets              BigInt?
  rxPowerStatus          String?
  softwareVersion        String?
  temperature            Float?
  txBytes                BigInt?
  txDrops                BigInt?
  txErrors               BigInt?
  txOlt                  String?
  txOnu                  String?
  txPackets              BigInt?
  txPowerStatus          String?
  vendorId               String?
  wifiChannel            Int?
  wifiEnable             Boolean?
  wifiSecurityMode       String?
  wifiSsid               String?
  compositeIndex         Int?
  descOid                String?
  nameOid                String?
  rxOltOid               String?
  rxOnuOid               String?
  statusOid              String?
  olt                    Olt       @relation(fields: [oltId], references: [id], onDelete: Cascade)
  networkPerformance     NetworkPerformance[] @relation("NetworkPerformanceOnu")
  networkAlerts          NetworkAlert[] @relation("NetworkAlertOnu")
  // deviceBackups          DeviceBackup[] @relation("DeviceBackupOnu")
  configurationRestores  ConfigurationRestore[] @relation("ConfigurationRestoreOnu")

  @@unique([oltId, gponOnu])
  @@index([oltId])
  @@index([status])
  @@index([lastUpdate])
  @@index([registerTime])
  @@index([lastSeen])
  @@index([serialNumber])
  @@index([macAddress])
  @@index([oltId, status])
  @@index([oltId, lastUpdate])
  @@index([status, lastUpdate])
  @@index([oltId, gponOnu])
}

model OnuType {
  id                    String   @id @default(cuid())
  oltId                 String
  name                  String
  ethernetPorts         Int      @default(0)
  wifi                  Int      @default(0)
  voipPorts             Int      @default(0)
  ponType               String?
  description           String?
  maxTcont              Int?
  maxGemPort            Int?
  maxSwitchPerSlot      Int?
  maxFlowPerSwitch      Int?
  maxIpHost             Int?
  maxIpv6Host           Int?
  serviceAbilityN1      String?
  serviceAbility1M      String?
  serviceAbility1P      String?
  wifiMgmtViaNonOmci    String?
  omciSendMode          String?
  defaultMulticastRange String?
  vrg                   String?
  mgcConfigureMode      String?
  maxVeip               Int?
  extendedOmci          String?
  location              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  olt                   Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)

  @@unique([oltId, name])
  @@index([oltId])
}

model SpeedProfile {
  id           String   @id @default(cuid())
  oltId        String
  profileType  String   @default("Download")
  name         String
  type         Int
  bandwidthSir Int
  burstPir     Int
  fixed        Int?
  assured      Int?
  maximum      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  olt          Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)

  @@unique([oltId, profileType, name])
  @@index([oltId])
  @@index([profileType])
}

model MikroTikRouter {
  id              String       @id @default(cuid())
  name            String
  ipAddress       String       @unique
  timezone        String       @default("+07:00 Asia/Jakarta")
  apiPort         Int          @default(8728)
  apiUsername     String
  apiPassword     String
  authPort        Int          @default(7265)
  accountingPort  Int          @default(7266)
  secretRadius    String
  isolirUrl       String?
  description     String?
  pingStatus      String       @default("offline")
  userOnline      Int          @default(0)
  lastStatusCheck DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  profilePPPs     ProfilePPP[]
  networkPerformance NetworkPerformance[] @relation("NetworkPerformanceMikroTik")
  networkAlerts     NetworkAlert[] @relation("NetworkAlertMikroTik")
  // deviceBackups     DeviceBackup[] @relation("DeviceBackupMikroTik")
  configurationRestores ConfigurationRestore[] @relation("ConfigurationRestoreMikroTik")

  @@index([pingStatus])
}

model Bandwidth {
  id                     String       @id @default(cuid())
  name                   String       @unique
  maxLimitDownload       String
  maxLimitUpload         String
  burstLimitDownload     String?
  burstLimitUpload       String?
  minLimitDownload       String?
  minLimitUpload         String?
  burstThresholdDownload String?
  burstThresholdUpload   String?
  burstTimeDownload      Int?
  burstTimeUpload        Int?
  priority               Int?
  uploadSpeed            Int?
  downloadSpeed          Int?
  description            String?
  status                 Status       @default(AKTIF)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  hargaPakets            HargaPaket[]
}

model ProfilePPP {
  id               String          @id @default(cuid())
  name             String          @unique
  localAddress     String
  remoteAddress    String
  dnsServer        String?
  sessionTimeout   Int?
  idleTimeout      Int?
  mikroTikRouterId String?
  description      String?
  status           Status          @default(AKTIF)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  hargaPakets      HargaPaket[]
  mikroTikRouter   MikroTikRouter? @relation(fields: [mikroTikRouterId], references: [id])

  @@index([mikroTikRouterId])
}

model HargaPaket {
  id                   String        @id @default(cuid())
  name                 String        @unique
  bandwidthId          String?
  profilePPPId         String
  harga                Int
  durasi               Int           @default(30)
  durasiUnit           DurasiUnit    @default(HARI)
  usePPN               Boolean       @default(false)
  ppnPercentage        Float?
  useDiscount          Boolean       @default(false)
  discountType         DiscountType?
  discountValue        Float?
  discountDuration     Int?
  discountDurationUnit DurasiUnit?
  description          String?
  featured             Boolean       @default(false)
  status               Status        @default(AKTIF)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  bandwidth            Bandwidth?    @relation(fields: [bandwidthId], references: [id])
  profilePPP           ProfilePPP    @relation(fields: [profilePPPId], references: [id])
  pelanggans           Pelanggan[]

  @@index([bandwidthId])
  @@index([profilePPPId])
  @@index([status])
  @@index([featured])
}

model Pelanggan {
  id                            String        @id @default(cuid())
  idPelanggan                   String        @unique
  nama                          String
  username                      String
  password                      String
  passwordLogin                 String
  hargaPaketId                  String
  tipe                          TipePelanggan @default(REGULER)
  tanggalAktif                  DateTime
  jatuhTempo                    DateTime
  status                        Status        @default(AKTIF)
  alamat                        String?
  noTelp                        String?
  email                         String?
  catatan                       String?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt
  biayaInstalasi                Int?
  biayaInstalasiDiskon          Float?
  biayaInstalasiIsRecurring     Boolean       @default(false)
  biayaLainnya                  Int?
  biayaLainnyaDiskon            Float?
  biayaLainnyaIsRecurring       Boolean       @default(false)
  biayaSewaPerangkat            Int?
  biayaSewaPerangkatDiskon      Float?
  biayaSewaPerangkatIsRecurring Boolean       @default(true)
  discountDuration              Int?
  discountDurationUnit          DurasiUnit?
  discountType                  DiscountType?
  discountValue                 Float?
  keteranganBiayaLainnya        String?
  useDiscount                   Boolean       @default(false)
  usePPN                        Boolean       @default(true)
  useProrate                    Boolean       @default(false)
  is2FAEnabled                  Boolean       @default(false)
  isBillNotifEnabled            Boolean       @default(true)
  isPromoEnabled                Boolean       @default(false)
  jenisDokumen                  String?
  noDokumen                     String?
  fileBAST                      String?
  fileKTP                       String?
  fileRumahSekitar              String?
  kabupatenKota                 String?
  kecamatan                     String?
  kelurahanDesa                 String?
  latitude                      Float?
  longitude                     Float?
  provinsi                      String?
  odpId                         String?
  passwordHash                  String?
  tokenVersion                  Int           @default(1)
  userId                        String?
  hargaPaket                    HargaPaket    @relation(fields: [hargaPaketId], references: [id])
  odp                           Odp?          @relation(fields: [odpId], references: [id])
  user                          User?         @relation(fields: [userId], references: [id])
  workOrders                    WorkOrder[]
  customerUsage                  CustomerUsage[]
  serviceSuspensions             ServiceSuspension[]
  invoices                      Invoice[]
  supportTickets                SupportTicket[]

  @@index([idPelanggan])
  @@index([hargaPaketId])
  @@index([status])
  @@index([tipe])
  @@index([tanggalAktif])
  @@index([jatuhTempo])
  @@index([email])
}

model PaymentGatewayConfig {
  id           String    @id @default(cuid())
  provider     String    @unique
  providerName String
  isEnabled    Boolean   @default(false)
  isProduction Boolean   @default(false)
  priority     Int       @default(0)
  apiKey       String?
  apiSecret    String?
  clientKey    String?
  merchantId   String?
  webhookUrl   String?
  callbackUrl  String?
  settings     Json?
  lastTestedAt DateTime?
  testStatus   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?

  @@index([provider])
  @@index([isEnabled])
  @@index([priority])
}

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String?
  encrypted   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model OAuthProviderConfig {
  id           String    @id @default(cuid())
  provider     String    @unique
  providerName String
  isEnabled    Boolean   @default(false)
  isProduction Boolean   @default(false)
  priority     Int       @default(0)
  clientId     String?
  clientSecret String?
  tenantId     String?
  scope        String?
  redirectUri  String?
  settings     Json?
  lastTestedAt DateTime?
  testStatus   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?

  @@index([provider])
  @@index([isEnabled])
  @@index([priority])
  @@map("oauth_provider_configs")
}

model Payment {
  id            String      @id @default(cuid())
  invoiceId     String?
  pelangganId   String
  amount        BigInt
  paymentDate   DateTime
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  invoice       Invoice?    @relation(fields: [invoiceId], references: [id])
  
  @@index([pelangganId])
  @@index([invoiceId])
  @@index([paymentDate])
}

model Invoice {
  id              String       @id @default(cuid())
  invoiceNumber   String       @unique
  pelangganId     String
  issueDate       DateTime     @default(now())
  dueDate         DateTime
  status          InvoiceStatus @default(DRAFT)
  subtotal        BigInt       @default(0)
  taxAmount       BigInt       @default(0)
  discountAmount  BigInt       @default(0)
  totalAmount     BigInt       @default(0)
  paidAmount      BigInt       @default(0)
  notes           String?
  terms           String?
  sentAt          DateTime?
  paidAt          DateTime?
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  pelanggan       Pelanggan    @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  items           InvoiceItem[]
  payments        Payment[]
  
  @@index([pelangganId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

model InvoiceItem {
  id          String      @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int         @default(1)
  unitPrice   BigInt
  totalPrice  BigInt
  itemType    ItemType    @default(SERVICE)
  
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  @@index([invoiceId])
}

model ARAgingSnapshot {
  id               String   @id @default(cuid())
  snapshotDate     DateTime @default(now())
  current          BigInt   @default(0)
  overdue30        BigInt   @default(0)
  overdue60        BigInt   @default(0)
  overdue90        BigInt   @default(0)
  totalOutstanding BigInt   @default(0)
  totalCustomers   Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([snapshotDate])
}

model MRRMovement {
  id           String   @id @default(cuid())
  month        Int
  year         Int
  movementType String
  pelangganId  String?
  amount       BigInt
  description  String?
  createdAt    DateTime @default(now())

  @@index([year, month])
  @@index([movementType])
  @@index([pelangganId])
}

model RevenueSnapshot {
  id               String   @id @default(cuid())
  snapshotDate     DateTime
  snapshotType     String   @default("DAILY")
  totalMRR         BigInt   @default(0)
  totalARR         BigInt   @default(0)
  newMRR           BigInt   @default(0)
  expansionMRR     BigInt   @default(0)
  contractionMRR   BigInt   @default(0)
  churnMRR         BigInt   @default(0)
  reactivationMRR  BigInt   @default(0)
  activeCustomers  Int      @default(0)
  newCustomers     Int      @default(0)
  churnedCustomers Int      @default(0)
  arpu             Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([snapshotDate, snapshotType])
  @@index([snapshotDate])
  @@index([snapshotType])
}

model ReminderLog {
  id            String    @id @default(cuid())
  pelangganId   String
  reminderType  String
  channel       String
  recipient     String
  subject       String?
  message       String
  status        String    @default("PENDING")
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())

  @@index([pelangganId])
  @@index([status])
  @@index([createdAt])
}

model CustomerCohort {
  id               String   @id @default(cuid())
  cohortMonth      Int
  cohortYear       Int
  initialCustomers Int
  month0Revenue    BigInt   @default(0)
  month1Revenue    BigInt   @default(0)
  month2Revenue    BigInt   @default(0)
  month3Revenue    BigInt   @default(0)
  month6Revenue    BigInt   @default(0)
  month12Revenue   BigInt   @default(0)
  activeMonth0     Int      @default(0)
  activeMonth1     Int      @default(0)
  activeMonth3     Int      @default(0)
  activeMonth6     Int      @default(0)
  activeMonth12    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([cohortYear, cohortMonth])
  @@index([cohortYear, cohortMonth])
}

model Department {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  jobDescription  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  users           User[]
  positions       Position[]
  workOrders      WorkOrder[]
  notifications   Notification[]
  workOrderTemplates WorkOrderTemplate[]
  slas            SLA[]
  escalations     WorkOrderEscalation[]

  @@map("departments")
}

model Site {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  address     String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       User[]
  workOrders  WorkOrder[]

  @@index([isActive])
  @@map("sites")
}

model Position {
  id           String      @id @default(cuid())
  title        String      @unique
  code         String?     @unique
  level        String?
  description  String?
  departmentId String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
