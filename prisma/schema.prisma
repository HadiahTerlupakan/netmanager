  assetId   String
  date      DateTime @default(now())
  amount    Decimal  @db.Decimal(19, 2)
  notes     String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_depreciation_logs")
}

