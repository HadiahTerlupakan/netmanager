model TaxReminder {
  id        String    @id @default(cuid())
  tenantId  String
  taxType   TaxType
  year      Int
  month     Int
  dueDate   DateTime
  status    String    @default("PENDING")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([tenantId, taxType, year, month])
  @@index([status, dueDate])
  @@map("tax_reminders")
}

model TaxConfigHistory {
  id          String   @id @default(cuid())
  tenantId    String
  field       String
  oldValue    String?
  newValue    String?
  changedById String
  changedAt   DateTime @default(now())

  @@index([tenantId, changedAt])
  @@index([tenantId, field])
  @@map("tax_config_histories")
}

/// Konfigurasi tarif pajak fleksibel per-tenant.
///
/// Sebelumnya tarif pajak (PPN, PPh 23, PPh 4(2), BHP, USO) di-hardcode
/// sebagai kolom di `TaxConfig`. Sekarang setiap tenant bebas tambah/hapus
/// jenis pajak custom (mis. PPh 26 vendor LN, retribusi daerah, dst).
///
/// `code` adalah identifier unik per-tenant yang dipakai oleh resolver di
/// service layer (`getRateByCode`). Kode reserved yang dipakai default seed:
/// `PPN`, `PPH23_JASA`, `PPH23_SEWA`, `PPH4_FINAL`, `BHP`, `USO`, `KSO`.
model TaxRateConfig {
  id          String          @id @default(cuid())
  tenantId    String
  code        String
  name        String
  category    TaxRateCategory
  rate        Decimal         @db.Decimal(5, 2)
  dueDay      Int?
  dueMonth    Int?
  isActive    Boolean         @default(true)
  description String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
  @@map("tax_rate_configs")
}

enum TaxRateCategory {
  PPN
  PPH
  BHP_USO
  OTHER
}

// ============================================================
