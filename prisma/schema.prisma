/// Expo Updates OTA bundle untuk aplikasi mobile.
/// Setiap record merepresentasikan satu manifest update yang dilayani ke
/// mobile via /api/mobile/manifest. Bundle + assets disimpan di PVC.
model AppUpdate {
  id             String   @id @default(uuid())
  manifestId     String   @unique
  channel        String
  runtimeVersion String
  platform       String
  bundleHash     String
  bundlePath     String
  bundleSize     BigInt
  assets         Json
  metadata       Json?
  signature      String?
  signatureKeyId String?
  releaseNotes   String?
  commitTime     DateTime
  isActive       Boolean  @default(true)
  tenantId       String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([channel, runtimeVersion, platform, isActive, commitTime(sort: Desc)], map: "idx_app_updates_lookup")
  @@index([tenantId])
  @@map("app_updates")
}

/// APK release untuk distribusi langsung (non-OTA).
/// Setiap record merepresentasikan satu versi APK yang dapat diunduh
/// oleh pengguna melalui in-app update checker.
model AppRelease {
  id                  String   @id @default(cuid())
  platform            String
  version             String
  versionCode         Int
  isForceUpdate       Boolean  @default(false)
  minSupportedVersion String?
  downloadUrl         String
  releaseNotes        String?  @db.Text
  isActive            Boolean  @default(true)
  releasedAt          DateTime @default(now())

  architecture      String?
  minOsVersion      String?
  rolloutPercentage Int     @default(100)
  apkSizeBytes      BigInt?

  tenantId  String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform, isActive, releasedAt])
  @@index([platform, architecture, isActive])
  @@index([tenantId])
  @@map("app_releases")
}

