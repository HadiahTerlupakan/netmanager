model WorkOrders {
  id                  String                 @id
  workOrderNumber     String                 @unique
  pelangganId         String?
  siteId              String?
  type                WorkOrderType
  title               String
  description         String
  status              WorkOrderStatus        @default(PENDING)
  priority            WorkOrderPriority      @default(NORMAL)
  departmentId        String?
  assignedToId        String?
  locationAddress     String?
  locationLat         Float?
  locationLng         Float?
  contactName         String?
  contactPhone        String?
  scheduledDate       DateTime?
  scheduledTimeStart  String?
  scheduledTimeEnd    String?
  startedAt           DateTime?
  completedAt         DateTime?
  verifiedAt          DateTime?
  closedAt            DateTime?
  estimatedHours      Float?
  actualHours         Float?
  estimatedCost       Float?
  actualCost          Float?
  requiredMaterials   Json?
  usedMaterials       Json?
  internalNotes       String?
  resolutionNotes     String?
  customerFeedback    String?
  rating              Int?
  disconnectionReason String?
  templateId          String?
  slaId               String?
  createdById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime
  ticketId            String?
  assignments         WorkOrderAssignments[]
  attachments         WorkOrderAttachments[]
  tasks               WorkOrderTasks[]
  updates             WorkOrderUpdates[]
  assignedTo          User?                  @relation("work_orders_assignedToIdToUser", fields: [assignedToId], references: [id])
  createdBy           User?                  @relation("work_orders_createdByIdToUser", fields: [createdById], references: [id])
  department          Departments?           @relation(fields: [departmentId], references: [id])
  pelanggan           Pelanggan?             @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  site                Sites?                 @relation(fields: [siteId], references: [id])
  sla                 Sla?                   @relation(fields: [slaId], references: [id])
  template            WorkOrderTemplates?    @relation(fields: [templateId], references: [id])
  ticket              SupportTickets?        @relation(fields: [ticketId], references: [id])
  canvasing           Canvasing[]

  @@index([assignedToId])
  @@index([departmentId])
  @@index([pelangganId])
  @@index([priority])
  @@index([scheduledDate])
  @@index([siteId])
  @@index([slaId])
  @@index([status])
  @@index([templateId])
  @@index([ticketId])
  @@index([type])
  @@index([workOrderNumber])
  // OPTIMIZATION: Composite indexes for common query patterns
  @@index([status, priority]) // Dashboard urgent attention query
  @@index([status, createdAt]) // List view with date sorting
  @@index([status, departmentId]) // Department workload queries
  @@index([type, status]) // Analytics by type queries
  @@index([createdAt]) // Recent work orders sort
  @@map("work_orders")
}

