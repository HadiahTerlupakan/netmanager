// ============================================
// WORK ORDER SYSTEM MODELS
// ============================================

enum WorkOrderStatus {
  PENDING       // Baru dibuat, belum assigned
  ASSIGNED      // Sudah assigned ke technician
  IN_PROGRESS   // Sedang dikerjakan
  ON_HOLD       // Ditunda (waiting parts, dll)
  COMPLETED     // Selesai dikerjakan
  VERIFIED      // Sudah diverifikasi
  CLOSED        // Ditutup
  CANCELLED     // Dibatalkan
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum WorkOrderType {
  INSTALLATION    // Pemasangan baru
  TROUBLESHOOT   // Troubleshooting masalah
  MAINTENANCE    // Maintenance rutin
  UPGRADE        // Upgrade perangkat/paket
  RELOCATION     // Pindah lokasi
  DISCONNECTION  // Pemutusan
  OTHER          // Lainnya
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// Work Order - Main work order entity
model WorkOrder {
  id                String            @id @default(cuid())
  workOrderNumber   String            @unique // Format: WO-YYYYMMDD-XXXX
  
  // Relations
  ticketId          String?
  ticket            Ticket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  pelangganId       String
  pelanggan         Pelanggan         @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
  
  // Work Order Details
  type              WorkOrderType
  title             String
  description       String            @db.Text
  status            WorkOrderStatus   @default(PENDING)
  priority          WorkOrderPriority @default(NORMAL)
  
  // Assignment
  departmentId      String?
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedToId      String?
  assignedTo        Employee?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  
  // Location & Contact
  locationAddress   String?           @db.Text
  locationLat       Float?
  locationLng       Float?
  contactName       String?
  contactPhone      String?
  
  // Scheduling
  scheduledDate     DateTime?
  scheduledTimeStart String?          // HH:mm format
  scheduledTimeEnd   String?          // HH:mm format
  
  // Completion
  startedAt         DateTime?
  completedAt       DateTime?
  verifiedAt        DateTime?
  closedAt          DateTime?
  
  // Estimation
  estimatedHours    Float?
  actualHours       Float?
  estimatedCost     Float?
  actualCost        Float?
  
  // Materials/Parts (JSON)
  requiredMaterials Json?            // [{name, quantity, unit}]
  usedMaterials     Json?            // [{name, quantity, unit, cost}]
  
  // Notes
  internalNotes     String?          @db.Text
  resolutionNotes   String?          @db.Text
  customerFeedback  String?          @db.Text
  rating            Int?             // 1-5
  
  // Relations
  tasks             WorkOrderTask[]
  assignments       WorkOrderAssignment[]
  updates           WorkOrderUpdate[]
  attachments       WorkOrderAttachment[]
  
  // Timestamps
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@index([ticketId])
  @@index([pelangganId])
  @@index([status])
  @@index([assignedToId])
  @@index([departmentId])
  @@index([scheduledDate])
  @@index([type])
  @@index([priority])
  @@index([workOrderNumber])
  @@map("work_orders")
}

// Work Order Task - Checklist/subtasks
model WorkOrderTask {
  id              String       @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  
  title           String
  description     String?      @db.Text
  status          TaskStatus   @default(PENDING)
  order           Int          @default(0)
  
  completedById   String?
  completedBy     Employee?    @relation(fields: [completedById], references: [id], onDelete: SetNull)
  completedAt     DateTime?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([workOrderId])
  @@index([status])
  @@map("work_order_tasks")
}

// Work Order Assignment - Multi technician assignment
model WorkOrderAssignment {
  id              String       @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  role            String?      // Lead, Assistant, Supervisor
  assignedAt      DateTime     @default(now())
  assignedById    String?
  
  @@index([workOrderId])
  @@index([employeeId])
  @@map("work_order_assignments")
}

// Work Order Update - Activity log/timeline
model WorkOrderUpdate {
  id              String             @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  
  updateType      String             // STATUS_CHANGE, PROGRESS_UPDATE, NOTE, PHOTO
  message         String             @db.Text
  oldStatus       WorkOrderStatus?
  newStatus       WorkOrderStatus?
  
  createdById     String?
  createdBy       Employee?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  
  @@index([workOrderId])
  @@index([createdAt])
  @@map("work_order_updates")
}

// Work Order Attachment - Photos/files from field
model WorkOrderAttachment {
  id              String       @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  
  fileName        String
  filePath        String
  fileSize        Int
  fileType        String
  caption         String?
  
  uploadedById    String?
  uploadedBy      Employee?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt      DateTime     @default(now())
  
  @@index([workOrderId])
  @@index([uploadedAt])
  @@map("work_order_attachments")
}

model Transaction {
  id              String          @id @default(cuid())
  bankAccountId    String // ID rekening bank
  tanggal         DateTime // Tanggal transaksi
  tipeTransaksi   String // Jenis transaksi (DEBIT/KREDIT)
  kategori        String // Kategori transaksi
  deskripsi       String // Deskripsi transaksi
  jumlah          BigInt // Jumlah transaksi
  saldoSebelumnya BigInt // Saldo sebelum transaksi
  saldoSetelahnya BigInt // Saldo setelah transaksi
  nomorReferensi  String? // Nomor referensi (opsional)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String? // User ID yang membuat (optional)
  updatedBy       String? // User ID yang update terakhir (optional)
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id])
  createdByUser    User? @relation("TransactionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser    User? @relation("TransactionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([bankAccountId, tanggal])
  @@index([tipeTransaksi])
  @@index([kategori])
  @@index([tanggal])
}

// ============================================
// ENHANCED FINANCIAL REPORTING MODELS
// ============================================

// AccountingPeriod - Periods for financial reporting
model AccountingPeriod {
  id          String   @id @default(cuid())
  year        Int      // 2024, 2025
  month       Int?     // 1-12 (null for yearly periods)
  quarter     Int?     // 1-4 (null for non-quarterly)
  name        String   // "2024", "Q1 2024", "Jan 2024"
  startDate   DateTime // Period start
  endDate     DateTime // Period end
  isActive    Boolean  @default(false)
  isClosed    Boolean  @default(false) // Period closed for modifications
  closedAt    DateTime?
  closedBy    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations to financial data snapshots
  balanceSheet       BalanceSheetSnapshot?
  profitLoss         ProfitLossSnapshot?
  cashFlow           CashFlowSnapshot?
  financialRatios    FinancialRatioSnapshot[]
  auditLogs          FinancialAuditLog[]

  @@unique([year, month, quarter])
  @@index([isActive])
  @@index([isClosed])
  @@index([year])
}

// BalanceSheetSnapshot - Balance sheet data at specific period
model BalanceSheetSnapshot {
  id                String   @id @default(cuid())
  periodId          String   @unique
  period            AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  // Assets
  cashAndEquivalents     BigInt
  accountsReceivable     BigInt
  inventory              BigInt @default(0)
  prepaidExpenses        BigInt @default(0)
  currentAssets          BigInt
  fixedAssets            BigInt
  accumulatedDepreciation BigInt @default(0)
  netFixedAssets         BigInt
  totalAssets            BigInt

  // Liabilities
  accountsPayable        BigInt
  accruedExpenses        BigInt @default(0)
  shortTermDebt          BigInt @default(0)
  currentLiabilities     BigInt
  longTermDebt           BigInt @default(0)
  totalLiabilities       BigInt

  // Equity
  initialCapital         BigInt @default(0)
  retainedEarnings       BigInt
  currentPeriodEarnings  BigInt @default(0)
  totalEquity            BigInt

  // Validation
  isBalanced             Boolean @default(false) // Assets = Liabilities + Equity
  variance               BigInt @default(0) // Should be 0 when balanced

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdBy              String?

  @@index([periodId])
}

// ProfitLossSnapshot - P&L data for specific period
model ProfitLossSnapshot {
  id                String   @id @default(cuid())
  periodId          String   @unique
  period            AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  // Revenue
  salesRevenue      BigInt
  serviceRevenue    BigInt @default(0)
  otherRevenue      BigInt @default(0)
  totalRevenue      BigInt

  // Cost of Goods Sold (COGS)
  directCosts       BigInt @default(0)
  cogs              BigInt @default(0)
  grossProfit       BigInt
  grossMargin       Float    @default(0) // Percentage

  // Operating Expenses
  operatingExpenses BigInt
  operatingIncome   BigInt
  operatingMargin   Float    @default(0) // Percentage

  // Non-Operating Items
  interestIncome    BigInt @default(0)
  interestExpense   BigInt @default(0)
  otherIncome       BigInt @default(0)
  otherExpenses     BigInt @default(0)
  incomeBeforeTax   BigInt

  // Tax
  incomeTax         BigInt @default(0)
  netIncome         BigInt
  netMargin         Float    @default(0) // Percentage

  // Additional metrics
  earningsPerShare  Float    @default(0)
  returnOnAssets    Float    @default(0)
  returnOnEquity    Float    @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?

  @@index([periodId])
}

// CashFlowSnapshot - Cash flow data for specific period
model CashFlowSnapshot {
  id                String   @id @default(cuid())
  periodId          String   @unique
  period            AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  // Operating Activities
  netIncome         BigInt
  depreciation      BigInt @default(0)
  workingCapitalChanges BigInt @default(0)
  operatingCashFlow  BigInt

  // Investing Activities
  capex             BigInt @default(0)
  assetSales        BigInt @default(0)
  investingCashFlow BigInt @default(0)

  // Financing Activities
  debtProceeds      BigInt @default(0)
  debtRepayments    BigInt @default(0)
  equityProceeds    BigInt @default(0)
  dividends         BigInt @default(0)
  financingCashFlow BigInt @default(0)

  // Net Change
  cashFlowIncrease  BigInt
  beginningCash     BigInt
  endingCash        BigInt

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?

  @@index([periodId])
}

// FinancialRatioSnapshot - Financial ratios for specific period
model FinancialRatioSnapshot {
  id          String   @id @default(cuid())
  periodId    String
  period      AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  // Liquidity Ratios
  currentRatio       Float
  quickRatio         Float @default(0)
  cashRatio          Float @default(0)

  // Profitability Ratios
  grossMargin        Float
  operatingMargin    Float
  netMargin          Float
  returnOnAssets     Float
  returnOnEquity     Float

  // Efficiency Ratios
  assetTurnover      Float @default(0)
  inventoryTurnover  Float @default(0)
  receivablesTurnover Float @default(0)

  // Solvency Ratios
  debtToEquity       Float @default(0)
  debtToAssets       Float @default(0)
  interestCoverage   Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId])
  @@index([periodId])
}

// FinancialAuditLog - Audit trail for financial data changes
model FinancialAuditLog {
  id          String   @id @default(cuid())
  periodId    String?
  period      AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  action      String   // "CREATE", "UPDATE", "DELETE", "CALCULATE"
  entityType  String   // "BALANCE_SHEET", "PROFIT_LOSS", "CASH_FLOW"
  entityId    String?  // ID of the affected record
  description String   @db.Text // Human-readable description

  // What changed
  oldValues   Json?    // Previous values
  newValues   Json?    // New values

  // Who made the change
  userId      String
  userName    String?  // User name at time of action
  ipAddress   String?
  userAgent   String?  @db.Text

  // When
  createdAt   DateTime @default(now())

  @@index([periodId])
  @@index([entityType])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// DepreciationSchedule - Asset depreciation tracking
model DepreciationSchedule {
  id              String   @id @default(cuid())
  assetName       String
  description     String?
  assetCategory   String
  purchaseDate    DateTime
  purchaseCost    BigInt
  salvageValue    BigInt @default(0)
  usefulLifeYears Int
  depreciationMethod String @default("STRAIGHT_LINE") // STRAIGHT_LINE, DECLINING_BALANCE

  // Calculated fields
  annualDepreciation BigInt @default(0)
  monthlyDepreciation BigInt @default(0)
  accumulatedDepreciation BigInt @default(0)
  netBookValue         BigInt

  // Status
  isActive        Boolean  @default(true)
  disposedDate    DateTime?
  disposedValue   BigInt @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?

  // Periodic depreciation records
  depreciationRecords DepreciationRecord[]

  @@index([isActive])
  @@index([purchaseDate])
  @@index([assetCategory])
}

// DepreciationRecord - Monthly depreciation for each asset
model DepreciationRecord {
  id                    String @id @default(cuid())
  depreciationScheduleId String
  depreciationSchedule   DepreciationSchedule @relation(fields: [depreciationScheduleId], references: [id], onDelete: Cascade)

  year                  Int
  month                 Int
  depreciationAmount    BigInt
  accumulatedDepreciation BigInt // Running total
  netBookValue          BigInt

  createdAt             DateTime @default(now())

  @@unique([depreciationScheduleId, year, month])
  @@index([year, month])
  @@index([depreciationScheduleId])
}

// FixedAsset - Fixed asset register
model FixedAsset {
  id              String   @id @default(cuid())
  assetCode       String   @unique // Fixed asset code
  assetName       String
  description     String?
  assetCategory   String
  serialNumber    String?
  location        String?

  // Financial details
  purchaseDate    DateTime
  purchaseCost    BigInt
  salvageValue    BigInt @default(0)
  usefulLifeYears Int
  currentValue    BigInt

  // Status
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, DISPOSED
  condition       String?  // GOOD, FAIR, POOR

  // Assignment
  assignedTo      String?  // Employee or department
  assignedDate    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  // Maintenance records
  maintenanceRecords FixedAssetMaintenance[]

  @@index([assetCode])
  @@index([assetCategory])
  @@index([status])
  @@index([purchaseDate])
}

// FixedAssetMaintenance - Maintenance records for fixed assets
model FixedAssetMaintenance {
  id              String @id @default(cuid())
  fixedAssetId    String
  fixedAsset      FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  maintenanceDate DateTime
  maintenanceType String // "PREVENTIVE", "CORRECTIVE", "EMERGENCY"
  description     String @db.Text
  cost            BigInt @default(0)
  performedBy     String? // Vendor or employee

  createdAt       DateTime @default(now())
  createdBy       String?

  @@index([fixedAssetId])
  @@index([maintenanceDate])
  @@index([maintenanceType])
}

// ============================================
// INVENTORY MANAGEMENT MODELS
// ============================================

// Gudang - Lokasi penyimpanan inventory
model Gudang {
  id          String   @id @default(cuid())
  kode        String   @unique // G01, G02, etc
  nama        String   // Gudang Utama, Gudang Cabang, etc
  lokasi      String?  // Alamat lengkap
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  barang      BarangGudang[]
  masuk       BarangMasuk[]
  keluar      BarangKeluar[]
  opname      StockOpname[]
  transferDari TransferAntarGudang[] @relation("TransferDariGudang")
  transferKe  TransferAntarGudang[] @relation("TransferKeGudang")
  restockSettings RestockSettings[]
  restockAlerts RestockAlerts[]
  usageAnalytics UsageAnalytics[]

  @@map("gudang")
}

// Barang - Master data barang inventory
model Barang {
  id          String   @id @default(cuid())
  kode        String   @unique // Kode barang
  nama        String   // Nama barang
  satuan      String   // pcs, meter, box, dll
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  stok        BarangGudang[]
  masuk       BarangMasuk[]
  keluar      BarangKeluar[]
  opname      StockOpname[]
  transfer    TransferAntarGudang[]
  restockSettings RestockSettings[]
  restockAlerts RestockAlerts[]
  usageAnalytics UsageAnalytics[]

  @@map("barang")
}

// BarangGudang - Stok barang per gudang (junction table)
model BarangGudang {
  id          String   @id @default(cuid())
  barangId    String
  gudangId    String
  stok        Int      @default(0) // Stok di gudang ini

  barang      Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang      Gudang   @relation(fields: [gudangId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([barangId, gudangId])
  @@map("barang_gudang")
}

// BarangMasuk - Tracking barang masuk
model BarangMasuk {
  id                  String       @id @default(cuid())
  barangId            String
  gudangId            String
  transferId          String?      // ID transfer antar gudang (nullable)
  tanggal             DateTime     @default(now())
  jumlah              Int          // Jumlah barang masuk
  kondisi             KondisiBarang @default(BARU) // Kondisi barang (BARU, BEKAS, RUSAK)
  keterangan          String?      // Keterangan/pengirim

  // Enhanced fields for detailed tracking
  lokasiPenyimpanan   String?      // Lokasi spesifik penyimpanan
  nomorRak            String?      // Nomor rak/shelf
  nomorBox            String?      // Nomor box/container
  pic                 String?      // Person in charge
  suhuPenyimpanan     Float?       // Suhu penyimpanan
  kelembaban          Float?       // Kelembaban
  tanggalExpire       DateTime?    // Tanggal kadaluarsa barang
  nomorBatch          String?      // Nomor batch/lot
  supplier            String?      // Nama supplier

  barang              Barang       @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang              Gudang       @relation(fields: [gudangId], references: [id], onDelete: Cascade)
  transfer            TransferAntarGudang? @relation(fields: [transferId], references: [id])
  createdAt           DateTime     @default(now())

  @@index([barangId])
  @@index([gudangId])
  @@index([transferId])
  @@index([tanggal])
  @@index([kondisi])
  @@map("barang_masuk")
}

// BarangKeluar - Tracking barang keluar
model BarangKeluar {
  id          String       @id @default(cuid())
  barangId    String
  gudangId    String
  transferId  String?      // ID transfer antar gudang (nullable)
  tanggal     DateTime     @default(now())
  jumlah      Int          // Jumlah barang keluar
  kondisi     KondisiBarang @default(BARU) // Kondisi barang (BARU, BEKAS, RUSAK)
  keterangan  String?      // Keterangan/tujuan

  // Enhanced fields for detailed tracking
  lokasiPenyimpanan   String?      // Lokasi spesifik penyimpanan
  nomorRak            String?      // Nomor rak/shelf
  nomorBox            String?      // Nomor box/container
  pic                 String?      // Person in charge
  tujuanPenggunaan    String?      // Tujuan penggunaan
  nomorBatch          String?      // Nomor batch/lot
  customer            String?      // Customer/pelanggan
  isHilang            Boolean      @default(false) // True jika barang hilang (tidak ada fisiknya)

  barang              Barang       @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang              Gudang       @relation(fields: [gudangId], references: [id], onDelete: Cascade)
  transfer            TransferAntarGudang? @relation(fields: [transferId], references: [id])
  createdAt           DateTime     @default(now())

  @@index([barangId])
  @@index([gudangId])
  @@index([transferId])
  @@index([tanggal])
  @@index([kondisi])
  @@index([isHilang])
  @@map("barang_keluar")
}

// StockOpname - Pencatatan stock opname
model StockOpname {
  id              String   @id @default(cuid())
  barangId        String
  gudangId        String
  tanggal         DateTime @default(now())
  stokFisik       Int      // Stok fisik yang dihitung
  stokSistem      Int      // Stok di sistem sebelum opname
  selisih         Int      // Selisih dengan stok sistem
  keterangan      String?  // Keterangan perbedaan

  // Enhanced fields for condition breakdown
  kondisiBaik     Int      @default(0)    // Jumlah barang kondisi baik
  kondisiRusak    Int      @default(0)    // Jumlah barang rusak
  kondisiExpire   Int      @default(0)    // Jumlah barang kadaluarsa
  lokasiPenyimpanan String?              // Lokasi spesifik penyimpanan
  nomorRak        String?                // Nomor rak/shelf
  nomorBox        String?                // Nomor box/container
  pic             String?                // Person in charge
  suhuPenyimpanan Float?                 // Suhu penyimpanan (untuk barang tertentu)
  kelembaban      Float?                 // Kelembaban (untuk barang tertentu)
  tanggalExpire   DateTime?              // Tanggal kadaluarsa barang
  nomorBatch      String?                // Nomor batch/lot
  catatanDetail   String?                // Catatan detail tambahan

  barang          Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang          Gudang   @relation(fields: [gudangId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([barangId])
  @@index([gudangId])
  @@index([tanggal])
  @@map("stock_opname")
}

// TransferAntarGudang - Transfer barang antar gudang
model TransferAntarGudang {
  id                String   @id @default(cuid())
  kodeTransfer      String   @unique // Kode transfer otomatis
  barangId          String
  dariGudangId      String   // Gudang sumber
  keGudangId        String   // Gudang tujuan
  tanggal           DateTime @default(now())
  jumlah            Int      // Jumlah barang yang ditransfer
  kondisi           KondisiBarang @default(BARU) // Kondisi barang saat transfer
  keterangan        String?  // Keterangan transfer

  // Relations
  barang            Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  dariGudang        Gudang   @relation("TransferDariGudang", fields: [dariGudangId], references: [id], onDelete: Cascade)
  keGudang          Gudang   @relation("TransferKeGudang", fields: [keGudangId], references: [id], onDelete: Cascade)
  masuk             BarangMasuk[]
  keluar            BarangKeluar[]

  createdAt         DateTime @default(now())

  @@index([barangId])
  @@index([dariGudangId])
  @@index([keGudangId])
  @@index([tanggal])
  @@index([kondisi])
  @@map("transfer_antar_gudang")
}

// RestockSettings - Pengaturan restock per barang per gudang
model RestockSettings {
  id                  String   @id @default(cuid())
  barangId            String
  gudangId            String
  minStok             Int      // Minimum stock level (reorder point)
  maxStok             Int      // Maximum stock level
  safetyStok          Int      @default(0) // Safety stock buffer
  leadTimeDays        Int      @default(7) // Estimated lead time in days
  avgDailyUsage       Float    @default(0) // Average daily usage
  lastUsageCalculation DateTime? // Last time usage was calculated
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  barang              Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang              Gudang   @relation(fields: [gudangId], references: [id], onDelete: Cascade)

  @@unique([barangId, gudangId])
  @@index([barangId])
  @@index([gudangId])
  @@index([isActive])
  @@map("restock_settings")
}

// RestockAlerts - Notifikasi restock
model RestockAlerts {
  id                  String   @id @default(cuid())
  barangId            String
  gudangId            String
  alertType           AlertType @default(RESTOCK_NEEDED) // Type of alert
  currentStok         Int      // Current stock when alert created
  minStok             Int      // Minimum stock threshold
  recommendedOrder    Int      // Recommended order quantity
  urgency             UrgencyLevel @default(MEDIUM) // Urgency level
  message             String?  // Alert message
  isRead              Boolean  @default(false)
  isResolved          Boolean  @default(false)
  resolvedAt          DateTime?
  resolvedBy          String?  // User ID who resolved
  createdAt           DateTime @default(now())

  // Relations
  barang              Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang              Gudang   @relation(fields: [gudangId], references: [id], onDelete: Cascade)

  @@index([barangId])
  @@index([gudangId])
  @@index([isRead])
  @@index([isResolved])
  @@index([alertType])
  @@index([createdAt])
  @@map("restock_alerts")
}

// Usage Analytics - Track barang usage for better prediction
model UsageAnalytics {
  id                  String   @id @default(cuid())
  barangId            String
  gudangId            String
  periodType          PeriodType @default(DAILY) // DAILY, WEEKLY, MONTHLY
  periodStart         DateTime // Start of the period
  periodEnd           DateTime // End of the period
  totalUsage          Int      @default(0) // Total quantity used in this period
  transactionCount    Int      @default(0) // Number of transactions
  avgPerTransaction   Float    @default(0) // Average quantity per transaction
  createdAt           DateTime @default(now())

  // Relations
  barang              Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  gudang              Gudang   @relation(fields: [gudangId], references: [id], onDelete: Cascade)

  @@unique([barangId, gudangId, periodType, periodStart])
  @@index([barangId])
  @@index([gudangId])
  @@index([periodType])
  @@index([periodStart])
  @@map("usage_analytics")
}
