generator client {
  provider = "prisma-client-js"
  output   = "./generated/billing"
}

datasource db {
  provider = "postgresql"
}

model Invoice {
  id               String            @id
  invoiceNumber    String
  pelangganId      String
  issueDate        DateTime          @default(now())
  dueDate          DateTime
  status           InvoiceStatus     @default(DRAFT)
  // PRORATE menagih selisih paket di dalam periode berjalan; melunasinya
  // tidak memperpanjang langganan.
  kind             InvoiceKind       @default(SUBSCRIPTION)
  subtotal         BigInt            @default(0)
  taxAmount        BigInt            @default(0)
  discountAmount   BigInt            @default(0)
  totalAmount      BigInt            @default(0)
  paidAmount       BigInt            @default(0)
  notes            String?
  terms            String?
  sentAt           DateTime?
  paidAt           DateTime?
  createdBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  siteId           String?
  invoiceItem      InvoiceItem[]
  payment          Payment[]
  billingSchedules BillingSchedule[]
  tenantId         String?

  @@unique([tenantId, invoiceNumber])
  @@index([dueDate])
  @@index([invoiceNumber])
  @@index([issueDate])
  @@index([pelangganId])
  @@index([status])
  @@index([siteId])
  @@index([tenantId])
}

model BillingSchedule {
  id            String                 @id @default(cuid())
  dedupeKey     String                 @unique
  jobType       BillingScheduleJobType
  invoiceId     String?
  pelangganId   String?
  runAt         DateTime
  status        BillingScheduleStatus  @default(PENDING)
  queueJobId    String?
  payload       Json?
  version       Int                    @default(1)
  attemptCount  Int                    @default(0)
  queuedAt      DateTime?
  processingAt  DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  failedAt      DateTime?
  lastAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  tenantId      String?
  invoice       Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([jobType, runAt])
  @@index([status, runAt])
  @@index([invoiceId])
  @@index([pelangganId])
  @@index([queueJobId])
  @@index([tenantId])
}

model InvoiceItem {
  id          String   @id
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   BigInt
  totalPrice  BigInt
  itemType    ItemType @default(SERVICE)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantId    String?

  @@index([invoiceId])
  @@index([tenantId])
}

model Payment {
  id              String                @id
  invoiceId       String?
  pelangganId     String
  amount          BigInt
  // Potongan kupon untuk invoice ini; ikut dihitung terbayar saat lunas.
  discountAmount  BigInt                @default(0)
  // Sama untuk semua payment satu checkout portal: gateway hanya mengenal
  // payment pertama, webhook-nya melunasi seluruh kelompok.
  checkoutId      String?
  // Pemesanan kupon (CouponUsage di database utama) untuk checkout ini;
  // dilepas bila checkout kedaluwarsa atau gagal.
  couponUsageId   String?
  // Kupon yang memberi potongan; dipakai mencatat ulang pemakaian bila
  // checkout yang sudah kedaluwarsa ternyata dibayar.
  couponId        String?
  paymentDate     DateTime
  paymentMethod   PaymentMethod
  reference       String?
  notes           String?
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime
  invoice         Invoice?              @relation(fields: [invoiceId], references: [id])
  accountId       String?
  gatewayStatus   GatewayPaymentStatus?
  gatewayProvider String?
  transactionId   String?
  paymentUrl      String?
  // Instruksi bayar dari gateway (nomor VA atau kode bayar minimarket, dan
  // string QRIS) yang ditampilkan portal sendiri.
  vaNumber        String?
  qrString        String?
  // Biaya gateway untuk payment lunas, dari API cek status gateway.
  gatewayFee      BigInt?
  // Bagian payment ini yang melebihi tagihan dan dikreditkan ke saldo
  // pelanggan (VA lama yang tetap dibayar setelah ganti metode). Terisi
  // berarti sudah dikreditkan; retry webhook tidak mengkreditkan lagi.
  kelebihanBayar  BigInt?
  expiresAt       DateTime?

  unmatchedMutationId String?            @unique
  unmatchedMutation   UnmatchedMutation? @relation(fields: [unmatchedMutationId], references: [id])
  receiptUrl          String?
  tenantId            String?

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([pelangganId])
  @@index([gatewayStatus])
  @@index([transactionId])
  @@index([tenantId])
  @@index([accountId])
  @@index([checkoutId])
}

model PaymentGatewayConfig {
  id           String    @id
  provider     String
  providerName String
  isEnabled    Boolean   @default(false)
  isProduction Boolean   @default(false)
  priority     Int       @default(0)
  apiKey       String?
  apiSecret    String?
  clientKey    String?
  merchantId   String?
  webhookUrl   String?
  callbackUrl  String?
  settings     Json?
  lastTestedAt DateTime?
  testStatus   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  createdBy    String?
  tenantId     String?

  @@unique([provider, tenantId])
  @@index([isEnabled])
  @@index([priority])
  @@index([provider])
  @@index([tenantId])
}

model UnmatchedMutation {
  id            String   @id @default(uuid())
  provider      String   @default("MOOTA")
  transactionId String?  @unique // Mutation ID from provider
  amount        Decimal  @db.Decimal(19, 2)
  description   String?
  type          String? // CR/DB
  date          DateTime // Date from provider
  bankId        String? // Bank identifier
  rawPayload    Json? // Store exact webhook payload

  status           UnmatchedStatus @default(PENDING)
  resolvedAt       DateTime?
  resolvedById     String?
  matchedInvoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment  Payment? // Relation to the established payment if resolved
  tenantId String?

  @@index([status])
  @@index([provider])
  @@index([amount])
  @@index([tenantId])
}

model WebhookEvent {
  id             String             @id @default(uuid())
  idempotencyKey String             @unique
  provider       String
  payload        Json
  signature      String?
  rawBody        String?
  status         WebhookEventStatus @default(PENDING)
  orderId        String?
  transactionId  String?
  processedAt    DateTime?
  error          String?
  tenantId       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([idempotencyKey])
  @@index([provider])
  @@index([status])
  @@index([orderId])
  @@index([transactionId])
  @@index([tenantId])
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum UnmatchedStatus {
  PENDING
  RESOLVED
  IGNORED
}

// Transksi dan Transaksi Kategori sengaja dihapus per Rencana Refactoring 

enum InvoiceStatus {
  DRAFT
  SENT
  OVERDUE
  PAID
  PARTIAL_PAID
  CANCELLED
}

enum BillingScheduleJobType {
  INVOICE_MARK_OVERDUE
  CUSTOMER_AUTO_ISOLIR
}

enum BillingScheduleStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum ItemType {
  SERVICE
  PRODUCT
  SETUP_FEE
  MONTHLY_FEE
  ONE_TIME_FEE
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  E_WALLET
  CREDIT_CARD
  DEBIT_CARD
  CHECK
  OTHER
}

enum Status {
  AKTIF
  NONAKTIF
  MAINTENANCE
  ISOLIR
  DISMANTLE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ExpenseType {
  OPERATIONAL // Opex
  CAPITAL // Capex
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum InvoiceKind {
  SUBSCRIPTION
  PRORATE
}

enum GatewayPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}
