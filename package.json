  "main": "index.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build --webpack",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:ps": "docker-compose ps",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate-deploy": "prisma migrate deploy", 
    "prisma:seed": "prisma generate && tsx prisma/seed.ts",
    "prisma:setup": "prisma generate && prisma migrate deploy && npm run prisma:seed",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:reset-seed": "prisma migrate reset --force && npm run prisma:seed",
    "prisma:baseline": "prisma migrate resolve --applied 20251105130408_init",
    "prisma:seed-permissions": "prisma generate && tsx prisma/seed-permissions.ts",
    "prisma:sync": "prisma db push && prisma migrate resolve --applied 20251105130408_init",
    "prisma:fix-drift": "prisma migrate resolve --rolled-back 20251105130408_init && prisma migrate dev --name complete_schema"
  },
