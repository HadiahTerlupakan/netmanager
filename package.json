{
  "name": "web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' tsx server.ts",
    "prepare": "node scripts/run-husky-prepare.js",
    "postinstall": "npm run prisma:generate",
    "build": "NODE_OPTIONS='--no-deprecation' NODE_ENV=production next build --webpack",
    "start": "NODE_ENV=production tsx server.ts",
    "worker": "tsx worker.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=50%",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:ps": "docker-compose ps",
    "db:backfill": "tsx scripts/backfill-tenant.ts",
    "prisma:generate": "prisma generate && prisma generate --config=prisma.radius.config.ts && prisma generate --config=prisma.billing.config.ts && prisma generate --config=prisma.mitra.config.ts",
    "prisma:generate-parallel": "prisma generate & prisma generate --config=prisma.radius.config.ts & prisma generate --config=prisma.billing.config.ts & prisma generate --config=prisma.mitra.config.ts & wait",
    "prisma:push-all": "prisma db push && prisma db push --config=prisma.radius.config.ts && prisma db push --config=prisma.billing.config.ts && prisma db push --config=prisma.mitra.config.ts",
    "prisma:migrate": "prisma migrate dev --name init && prisma migrate dev --config=prisma.radius.config.ts --name init && prisma migrate dev --config=prisma.billing.config.ts --name init && prisma migrate dev --config=prisma.mitra.config.ts --name init",
    "prisma:migrate-deploy": "prisma migrate deploy && prisma migrate deploy --config=prisma.radius.config.ts && prisma migrate deploy --config=prisma.billing.config.ts && prisma migrate deploy --config=prisma.mitra.config.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-only": "tsx prisma/seed.ts",
    "prisma:setup": "npm run prisma:generate && npm run prisma:migrate-deploy && npm run prisma:seed",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:reset-seed": "prisma migrate reset --force && npm run prisma:seed-only",
    "prisma:baseline": "prisma migrate resolve --applied 20260313000000_init_squashed",
    "prisma:seed-permissions": "tsx prisma/seed-permissions.ts",
    "prisma:sync": "prisma db push && prisma migrate resolve --applied 20260313000000_init_squashed",
    "prisma:fix-drift": "prisma migrate resolve --applied 20260313000000_init_squashed && prisma migrate dev --name complete_schema"
  },
