    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && next build",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:ps": "docker-compose ps",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate-deploy": "prisma migrate deploy",
    "prisma:seed": "prisma generate && tsx prisma/seed.ts",
    "prisma:seed:employees": "prisma generate && tsx scripts/seed-employees.ts",
    "prisma:seed:tickets": "prisma generate && tsx scripts/seed-ticket-categories.ts",
    "prisma:seed:all": "npm run prisma:seed && npm run prisma:seed:employees && npm run prisma:seed:tickets",
    "prisma:setup": "prisma generate && prisma migrate deploy && npm run prisma:seed",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:reset-seed": "prisma migrate reset --force && npm run prisma:seed",
    "prisma:baseline": "prisma migrate resolve --applied 20251105130408_init",
    "prisma:sync": "prisma db push && prisma migrate resolve --applied 20251105130408_init",
    "prisma:fix-drift": "prisma migrate resolve --rolled-back 20251105130408_init && prisma migrate dev --name complete_schema",
    "security:migrate-passwords": "tsx scripts/migrate-pelanggan-password.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "recharts": "^2.12.7"
